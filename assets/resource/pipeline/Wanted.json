// 自动完成会连续执行剩余轮次；闲置后核对「参与」是否变灰。
{
    "WantedTask": {
        "next": [ "WantedSetTeam" ]
    },
    // WantedTeam 传入阵容编号（1~8）。
    "WantedSetTeam": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SelectTeam",
                "custom_action_param": 1
            }
        },
        "next": [ "WantedTeamGate" ]
    },
    // WantedSoloTeam 选项切换到组队流程。
    "WantedTeamGate": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear" ]
            }
        },
        "next": [ "WantedOpenDaily" ]
    },
    // 入口须未组队；创建、退队各点击一次，等待悬停高亮变化。
    // 高亮像素 38，未高亮 ≤4，遮罩下 0。
    "WantedGroupHover": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 1195, 101, 7, 7 ],
                "method": 40,
                "lower": [ 0, 0, 235 ],
                "upper": [ 180, 25, 255 ],
                "count": 25
            }
        }
    },
    "WantedTeamOpen": {
        "max_hit": 1,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 1193, 102, 10, 10 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：点了组队按钮，但窗口没有打开"
        },
        "timeout": 10000,
        "next": [ "WantedTeamListOpened" ]
    },

    // 匹配分数：正常 1.0，遮罩下 0.77，其他 ≤0.45。
    "WantedTeamListOpened": {
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/TeamCreateBtn.png",
                "roi": [ 740, 535, 150, 50 ],
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 782, 551, 50, 14 ]
            }
        },
        "timeout": 10000,
        "next": [ "WantedTeamDialog" ]
    },
    // 匹配分数：目标 1.0，其他 ≤0.38。
    "WantedTeamDialog": {
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/TeamCreateTitle.png",
                "roi": [ 600, 300, 150, 50 ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 600, 452, 50, 12 ]
            }
        },
        "next": [ "WantedTeamHover" ]
    },
    "WantedTeamHover": {
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 1193, 102, 10, 10 ],
                "end": [ 1193, 102, 10, 10 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "next": [ "WantedTeamCreated" ]
    },
    "WantedTeamCreated": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear", "WantedGroupHover" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 1193, 102, 10, 10 ]
            }
        },
        "timeout": 10000,
        "next": [ "WantedTeamUntick" ]
    },
    // 标签分数 1.0，其他 ≤0.30；绿勾像素约 36，未勾选 0。
    "WantedTeamWinLabel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/TeamWindowLabel.png",
                "roi": [ 480, 552, 140, 38 ],
                "threshold": 0.8
            }
        }
    },
    "WantedTeamTicked": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 496, 560, 22, 22 ],
                "method": 40,
                "lower": [ 40, 120, 120 ],
                "upper": [ 85, 255, 255 ],
                "count": 15
            }
        }
    },
    // 新队伍默认勾选；取消一次后确认绿勾消失。
    "WantedTeamUntick": {
        "max_hit": 1,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedTeamWinLabel" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 499, 566, 11, 11 ]
            }
        },
        "timeout": 5000,
        "next": [ "WantedTeamAutoJoinOff" ]
    },
    "WantedTeamAutoJoinOff": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "WantedTeamWinLabel",
                    "without": "WantedTeamTicked"
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 863, 225, 11, 11 ]
            }
        },
        "timeout": 5000,
        "next": [ "WantedTeamWinClosed" ]
    },
    "WantedTeamWinClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear" ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "已创建单人队伍，并取消「允许玩家自动加入」"
        },
        "next": [ "WantedOpenDaily" ]
    },

    // 「离开组队」蓝底像素：有队伍 ≥60，无队伍 0。
    "WantedTeamExit": {
        "max_hit": 1,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 248, 172, 40, 13 ],
                "method": 40,
                "lower": [ 95, 200, 60 ],
                "upper": [ 108, 255, 255 ],
                "count": 40
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 255, 174, 28, 8 ]
            }
        },
        "next": [ "WantedTeamExitHover" ]
    },
    "WantedTeamExitHover": {
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 1193, 102, 10, 10 ],
                "end": [ 1193, 102, 10, 10 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "timeout": 20000,
        "next": [ "WantedTeamExited" ]
    },
    "WantedTeamExited": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedGroupHover" ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "已退出单人队伍"
        },
        "anchor": {
            "MouseMoveResetAnchor": "MouseMoveReset"
        },
        "next": [ "[Anchor]MouseMoveResetAnchor" ]
    },
    "WantedOpenDaily": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EnterDailyTask",
                "custom_action_param": {
                    "row": "WantedRow",
                    "title": "WantedPanelTitle"
                }
            }
        },
        "next": [ "WantedJoin", "WantedAlreadyDone" ]
    },
    "WantedMapClear": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyMapClear" ]
            }
        }
    },
    // 模板实测：普通/选中/已完成均 ≥0.93，其他行或画面最高 0.41。
    "WantedRow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/WantedRow.png",
                "roi": [ 355, 240, 390, 275 ],
                "threshold": 0.8
            }
        }
    },
    // 详情标题仅在选中通缉任务时出现：1.0；其他行最高 0.52。
    "WantedPanelTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/PanelTitle.png",
                "roi": [ 760, 232, 90, 32 ],
                "threshold": 0.85
            }
        }
    },
    "WantedJoin": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyJoinAvailable" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 834, 494, 40, 13 ]
            }
        },
        "timeout": 60000,
        "next": [ "WantedAutoStart" ]
    },
    "WantedAlreadyDone": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyJoinUnavailable" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 184, 8, 8 ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "今天的通缉任务已全部完成"
        },
        "timeout": 5000,
        "next": [ "WantedDailyClosed" ]
    },
    "WantedDailyClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyTab" ]
            }
        },
        "inverse": true,
        "next": [ "WantedInVillage", "WantedBackToVillage" ]
    },
    // 完成后停在野外，需回木叶村南，避免后续任务长途寻路超时。
    // 回村图标会触发加载；已在木叶村南时点击仍会重新加载。
    "WantedInVillage": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/VillageName.png",
                "roi": [ 1190, 116, 148, 26 ],
                "threshold": 0.9
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "通缉任务完成，已在木叶村南"
        }
    },
    "WantedBackToVillage": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/BackToVillage.png",
                "roi": [ 1290, 90, 50, 30 ],
                "threshold": 0.8
            }
        },
        "action": "Click",
        "timeout": 10000,
        // 回村图标的悬浮说明会遮住地图名，确认前需移开鼠标。
        "anchor": {
            "MouseMoveResetAnchor": "MouseMoveReset"
        },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "WantedInVillage" ]
    },
    // 窗口标签实测：含确认框遮罩时 ≥0.89，其他画面最高 0.27。
    // 自动完成按钮仅蓝色面可点击（x 810~862），两端尖角不可点。
    "WantedRemainLabel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/RemainLabel.png",
                "roi": [ 600, 275, 140, 40 ],
                "threshold": 0.8
            }
        }
    },
    "WantedAutoStart": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedRemainLabel" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 815, 291, 42, 11 ]
            }
        },
        "next": [ "WantedSoloConfirm" ]
    },
    // 单人确认框模板实测：1.0，其他画面最高 0.42。
    "WantedSoloText": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/SoloConfirm.png",
                "roi": [ 545, 365, 130, 40 ],
                "threshold": 0.8
            }
        }
    },
    // 确认按钮仅两侧卷纹之间可点击；确认框立即消失，任务窗口约 3 秒后关闭。
    "WantedSoloConfirm": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedSoloText" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 598, 425, 36, 9 ]
            }
        },
        "next": [ "WantedStarted" ]
    },
    "WantedStarted": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedRemainLabel" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "开始自动完成「通缉任务」"
        },
        "next": [ "WantedWaitDone" ]
    },
    // 寻路横幅模板实测：显示时 ≥0.99，淡入淡出 0.59~0.93，无横幅时最高 0.31。
    "WantedPathing": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/Pathing.png",
                "roi": [ 600, 140, 140, 40 ],
                "threshold": 0.45
            }
        }
    },
    "WantedIdleFrame": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "WantedMapClear",
                    "without": "WantedPathing"
                }
            }
        }
    },
    // 超时依据：实测 5 轮共约 8 分半，预留较慢战斗和更多轮次的时间。
    "WantedWaitDone": {
        "focus": {
            "Node.PipelineNode.Failed": "失败, 20分钟没有结束..."
        },
        "timeout": 1200000,
        "next": [ "WantedIdle1" ]
    },
    // 切地图、到达 NPC、镜头平移时会短暂呈闲置状态，实测最长约 9 秒。
    // 无其他状态可区分，需间隔采样确认约 20 秒闲置，再核对日常次数。
    "WantedIdle1": {
        "max_hit": 200, // 安全上限：途中短暂闲置也会累计命中。
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "post_delay": 5000,
        "next": [ "WantedIdle2", "WantedWaitDone" ]
    },
    "WantedIdle2": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "post_delay": 5000,
        "next": [ "WantedIdle3", "WantedWaitDone" ]
    },
    "WantedIdle3": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "post_delay": 5000,
        "next": [ "WantedIdle4", "WantedWaitDone" ]
    },
    "WantedIdle4": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "post_delay": 5000,
        "next": [ "WantedIdle5", "WantedWaitDone" ]
    },
    "WantedIdle5": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "timeout": 10000,
        "next": [ "WantedOpenDaily" ]
    }
}
