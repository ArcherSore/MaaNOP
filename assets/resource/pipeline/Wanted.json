                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 863, 225, 11, 11 ]
            }
        },
        "timeout": 5000,
        "next": [ "WantedTeamWinClosed" ]
    },
    "WantedTeamWinClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear" ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "已创建单人队伍，并取消「允许玩家自动加入」"
        },
        "next": [ "WantedOpenDaily" ]
    },

    // 「离开组队」蓝底像素：有队伍 ≥60，无队伍 0。
    "WantedTeamExit": {
        "max_hit": 1,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 248, 172, 40, 13 ],
                "method": 40,
                "lower": [ 95, 200, 60 ],
                "upper": [ 108, 255, 255 ],
                "count": 40
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 255, 174, 28, 8 ]
            }
        },
        "next": [ "WantedTeamExitHover" ]
    },
    "WantedTeamExitHover": {
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 1193, 102, 10, 10 ],
                "end": [ 1193, 102, 10, 10 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "timeout": 20000,
        "next": [ "WantedTeamExited" ]
    },
    "WantedTeamExited": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "WantedMapClear",
                    "without": "WantedGroupHover"
                }
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "已退出单人队伍"
        }
    },

    "WantedDailyEntry": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": [ "ninjaQuiz/DailyEntry.png" ]
                }
            }
        }
    },
    "WantedOpenDaily": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedDailyEntry" ]
