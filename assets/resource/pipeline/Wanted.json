// 通缉任务：先选好队伍 → 顶部「日常锻炼」→ 日常活动列表里选中「通缉任务」→ 参与（自动寻路到通缉任务 NPC，到了自己弹出通缉任务窗口）
// → 点「自动完成」→ 单人时弹「无法获得双倍经验」确认框，点「是」→ 窗口关掉，游戏自己跑完今天剩下的所有轮次：
//   寻路到通缉目标 → 自动开战（战斗托管）→ 胜利 → 回 NPC 自动接下一个，中间不用点任何东西（实测 5 轮，每轮约 100 秒）。
// 跑完的标志：角色停在最后一场战斗的地图上，没有「自动寻路中」、没有战斗、没有窗口。地图连续约 20 秒都是这样就当作停下来了，
// 再打开日常锻炼核对：「参与」变灰（今天次数用完）才算完成；还是橙色就再参与一次（自动完成会接着做剩下的轮次）。
// 战斗输了：游戏自己结束自动通缉并弹框提示，点掉弹框后任务失败（换队伍再来）。
// 今天做过了：列表里这一行变灰（已完成）沉到最下面，右边「参与」也是灰的；认到灰「参与」就关掉日常锻炼窗口，正常结束。
// 选队伍复用丰饶之间的 Abundance* 节点（和强者降临一样）：WantedSetTeam 先按 interface.json 里的 WantedTeam 选项把这些节点改到第 N 个标签；
// 选完队伍后接哪里由 interface.json 里本任务的 pipeline_override 把 AbundanceTeamClose 的 next 改到 WantedOpenDaily。
{
    "WantedTask": {
        "next": [ "WantedSetTeam" ]
    },
    // 第几个队伍由 interface.json 的 WantedTeam 选项覆盖 custom_action_param（1~8）；SetBossTeam 只是改 Abundance* 的选队伍节点，和强者降临共用
    "WantedSetTeam": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SetBossTeam",
                "custom_action_param": 1
            }
        },
        "next": [ "AbundanceTeamScreen", "AbundanceGotoTeam" ]
    },

    // ===== 打开日常锻炼，找到通缉任务（开始时一次，跑完核对时再一次） =====
    // 入口图标和「日常活动」页签和忍者测验是同一个，直接用它的模板
    "WantedDailyEntry": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": [ "ninjaQuiz/DailyEntry.png" ]
                }
            }
        }
    },
    "WantedOpenDaily": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedDailyEntry" ]
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：「日常锻炼」窗口没有打开"
        },
        "post_delay": 1500, // 窗口有一段打开动画，中间没有可等的状态；1.5 秒后地图还没被压暗才算这一下没点上
        "timeout": 10000,
        "next": [ "WantedDailyOpened", "WantedOpenDailyAgain" ]
    },
    // 体力标签没被遮罩压暗：地图上没有打开的窗口（战斗、加载画面里也没有这个标签）
    "WantedMapClear": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/StaminaLabel.png",
                "roi": [ 32, 84, 66, 61 ],
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    // 游戏窗口不在前台时第一下点击会被吞掉（图标变亮但窗口没开）；地图没被压暗、入口还在，再点一次。
    // 跑完一轮要十分钟，用户中途切走窗口很常见，所以核对时也可能用到；每次打开最多补点 2 下，最多打开 4 次
    "WantedOpenDailyAgain": {
        "max_hit": 8,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear", "WantedDailyEntry" ],
                "box_index": 1
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：「日常锻炼」窗口没有打开"
        },
        "post_delay": 1500, // 同上
        "timeout": 10000,
        "next": [ "WantedDailyOpened", "WantedOpenDailyAgain" ]
    },
    // 「日常活动」页签（选中状态），窗口打开时默认就在这一页
    "WantedDailyTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ninjaQuiz/DailyTab.png",
                "roi": [ 355, 195, 110, 40 ],
                "threshold": 0.85
            }
        }
    },
    // 列表里「通缉任务」四个字：普通 / 选中 / 已完成（灰）底色都在 0.93 以上，别的行和别的画面最高 0.41
    "WantedRow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/WantedRow.png",
                "roi": [ 355, 240, 390, 275 ],
                "threshold": 0.8
            }
        }
    },
    // 右侧详情的标题：选中了通缉任务这一行才会显示（1.0；选中别的行时最高 0.52）
    "WantedPanelTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/PanelTitle.png",
                "roi": [ 760, 232, 90, 32 ],
                "threshold": 0.85
            }
        }
    },
    "WantedDailyOpened": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedDailyTab" ]
            }
        },
        // 等打开动画停下来、列表画完，再判断这一行在不在
        "post_wait_freezes": {
            "time": 500,
            "target": [ 350, 235, 600, 285 ]
        },
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：日常锻炼窗口状态异常"
        },
        "timeout": 5000,
        "next": [ "WantedJoin", "WantedJoinCapped", "WantedAlreadyDone", "WantedSelectRow", "WantedScrollList" ]
    },
    "WantedSelectRow": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedRow" ]
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：选不中列表里的「通缉任务」"
        },
        "post_delay": 1000, // 选中后右侧详情直接换掉，中间没有别的状态；1 秒后还没换才算这一下没点上
        "timeout": 5000,
        "next": [ "WantedJoin", "WantedJoinCapped", "WantedAlreadyDone", "WantedSelectRowAgain" ]
    },
    // 第一次点这一行可能只出悬停高亮、右侧详情没换；同一帧上看得到这一行、看不到详情标题才再点
    "WantedSelectRowAgain": {
        "max_hit": 8,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "WantedRow",
                    "without": "WantedPanelTitle"
                }
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：选不中列表里的「通缉任务」"
        },
        "post_delay": 1000, // 同上
        "timeout": 5000,
        "next": [ "WantedJoin", "WantedJoinCapped", "WantedAlreadyDone", "WantedSelectRowAgain" ]
    },
    // 第一页没有这一行（做完后会沉到最下面）：把滚动条从顶端拖到底（列表打开时总在顶端，滚轮对这个列表无效）
    "WantedScrollList": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedDailyTab" ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 752, 275, 1, 1 ],
                "end": [ 752, 520, 1, 1 ],
                "duration": 500
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [ 350, 235, 400, 285 ]
        },
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：日常锻炼列表里找不到「通缉任务」（等级不够或活动没开）"
        },
        "timeout": 3000,
        "next": [ "WantedSelectRow" ]
    },
    // 「参与」可点时是橙色（橙色像素约 665），今天次数用完后是灰色（0）；和忍者测验的「参与」是同一个按钮
    "WantedJoinOrange": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 822, 492, 62, 16 ],
                "method": 40,
                "lower": [ 3, 190, 150 ],
                "upper": [ 30, 255, 255 ],
                "count": 300
            }
        }
    },
    // 点了参与窗口就关掉，角色自动寻路到通缉任务 NPC，到了自己弹出通缉任务窗口。
    // 第一次是开始；之后再命中说明跑完核对时还有次数（例如中途停了），再参与一次让自动完成接着做。
    // max_hit 3：开始 1 次 + 补做 2 次，再有剩余就由 WantedJoinCapped 收尾
    "WantedJoin": {
        "max_hit": 3,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedPanelTitle", "WantedJoinOrange" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 834, 494, 40, 13 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：点了参与，但没有出现通缉任务窗口"
        },
        "post_delay": 1500, // 实测点上后日常锻炼窗口立刻关掉、开始寻路；1.5 秒后窗口还在才算这一下没点上
        // 从别的地图过来要切地图（跑完时人停在野外），给足时间
        "timeout": 90000,
        "next": [ "WantedAutoStart", "WantedJoinAgain" ]
    },
    // 日常锻炼窗口还开着、「参与」还是橙色：上一下没点上，再点
    "WantedJoinAgain": {
        "max_hit": 2,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedDailyTab", "WantedPanelTitle", "WantedJoinOrange" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 834, 494, 40, 13 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：点了参与，但没有出现通缉任务窗口"
        },
        "post_delay": 1500, // 同上
        "timeout": 90000,
        "next": [ "WantedAutoStart", "WantedJoinAgain" ]
    },
    // 已经参与了 3 次，日常锻炼里还是可以参与：关掉窗口，再让任务失败
    "WantedJoinCapped": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedPanelTitle", "WantedJoinOrange" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 184, 8, 8 ]
            }
        },
        "timeout": 5000,
        "next": [ "WantedCappedClosed" ]
    },
    "WantedCappedClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedDailyTab" ]
            }
        },
        "inverse": true,
        "next": [ "WantedCappedFailed" ]
    },
    // 动作必失败的终止节点：已识别出「目标做不成」的状态，任务以 Failed 结束，原因写在这里
    "WantedCappedFailed": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "通缉任务失败：已经自动完成了 3 次，日常锻炼里通缉任务仍有剩余次数"
        }
    },
    // 灰色「参与」（灰色像素约 830，可点时最多约 40）：今天的次数已经用完；点右上角红叉（圆心约 989,188）关窗口
    "WantedAlreadyDone": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "WantedPanelTitle",
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [ 822, 492, 62, 16 ],
                                "method": 40,
                                "lower": [ 0, 0, 50 ],
                                "upper": [ 180, 45, 150 ],
                                "count": 400
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 184, 8, 8 ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "今天的通缉任务已全部完成",
            "Node.PipelineNode.Failed": "通缉任务：日常锻炼窗口关不上"
        },
        "timeout": 5000,
        "next": [ "WantedDailyClosed" ]
    },
    "WantedDailyClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedDailyTab" ]
            }
        },
        "inverse": true
    },

    // ===== 通缉任务窗口：自动完成 =====
    // 窗口里「今日余下次数」几个字：窗口在时 0.89 以上（被确认框压暗也在），其他画面最高 0.27。
    // 窗口位置固定，「自动完成」按钮就在它右边，直接点按钮的蓝色面（x 810~862，两端尖角不算）
    "WantedRemainLabel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/RemainLabel.png",
                "roi": [ 600, 275, 140, 40 ],
                "threshold": 0.8
            }
        }
    },
    "WantedAutoStart": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedRemainLabel" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 815, 291, 42, 11 ]
            }
        },
        // 实测确认框 0.7 秒内弹出；点「是」之后窗口还要停 2~3.5 秒才关，中间没有别的状态可等。
        // 5 秒后窗口还在、也没弹框才算这一下没点上（不弹框时窗口应该也一样会自己关掉）
        "post_delay": 5000,
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：点了自动完成，但通缉任务窗口没有关掉"
        },
        "timeout": 10000,
        "next": [ "WantedSoloConfirm", "WantedStarted", "WantedAutoStartAgain" ]
    },
    // 窗口还在、没有确认框：上一下没点上，再点
    "WantedAutoStartAgain": {
        "max_hit": 2,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "WantedRemainLabel",
                    "without": "WantedSoloText"
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 815, 291, 42, 11 ]
            }
        },
        "post_delay": 5000, // 同上
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：点了自动完成，但通缉任务窗口没有关掉"
        },
        "timeout": 10000,
        "next": [ "WantedSoloConfirm", "WantedStarted", "WantedAutoStartAgain" ]
    },
    // 单人时的确认框「你现在为单人状态，继续进行通缉任务将无法获得双倍经验奖励，是否继续本操作？」（1.0，其他画面最高 0.42）
    "WantedSoloText": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/SoloConfirm.png",
                "roi": [ 545, 365, 130, 40 ],
                "threshold": 0.8
            }
        }
    },
    // 点「是」（只点两个卷纹之间的橙色面）。实测点上后确认框立刻消失，通缉任务窗口约 3 秒后自己关掉；
    // 1 秒后确认框还在才算没点上，再点
    "WantedSoloConfirm": {
        "max_hit": 3,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedSoloText" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 598, 425, 36, 9 ]
            }
        },
        "post_delay": 1000, // 确认框消失后窗口要过一阵才关，中间没有别的状态可等
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：点了自动完成，但通缉任务窗口没有关掉"
        },
        "timeout": 10000,
        "next": [ "WantedStarted", "WantedSoloConfirm" ]
    },
    // 通缉任务窗口关掉了：游戏开始自己跑
    "WantedStarted": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedRemainLabel" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "通缉任务已开始自动完成，等游戏打完今天剩下的轮次（每轮约 2 分钟）"
        },
        "next": [ "WantedWaitDone" ]
    },

    // ===== 等游戏跑完：地图连续约 20 秒没有窗口、没有「自动寻路中」 =====
    // 「自动寻路中」横幅：显示时 0.99 以上，淡入淡出时 0.59~0.93，没有时最高 0.31
    "WantedPathing": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/Pathing.png",
                "roi": [ 600, 140, 140, 40 ],
                "threshold": 0.45
            }
        }
    },
    // 闲着的一帧：体力标签没被压暗（不在战斗、加载、窗口里），也没有「自动寻路中」
    "WantedIdleFrame": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "WantedMapClear",
                    "without": "WantedPathing"
                }
            }
        }
    },
    // 一直等到地图闲下来；WantedIdle1~5 中间有一帧不闲就回到这里重新等。
    // 20 分钟：实测 5 轮共约 8 分半，留出打得慢、轮次多的余量
    "WantedWaitDone": {
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：20 分钟内角色一直没有停下来（一直在寻路、战斗或有窗口挡着）"
        },
        "timeout": 1200000,
        "next": [ "WantedBattleLost", "WantedIdle1" ]
    },
    // 战斗打输了：游戏自己结束自动通缉，弹框「很遗憾，由于你战斗失败，自动通缉任务结束，请调整好阵容后再来挑战吧！」，一直停在那里。
    // 弹框在时文字都在 0.8 以上（实测 63 帧），单人确认框最高 0.53。点「确定」（只点两个卷纹之间的橙色面），框关掉后让任务失败；
    // 不再参与：同一个队伍再打同一个目标还是会输
    "WantedBattleLostText": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/BattleLost.png",
                "roi": [ 545, 365, 130, 40 ],
                "threshold": 0.8
            }
        }
    },
    "WantedBattleLost": {
        "max_hit": 3,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedBattleLostText" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 655, 424, 32, 10 ]
            }
        },
        "post_delay": 1000, // 弹框点上后直接消失，中间没有别的状态；1 秒后还在才算没点上
        "timeout": 5000,
        "next": [ "WantedBattleLostClosed", "WantedBattleLost" ]
    },
    "WantedBattleLostClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedBattleLostText" ]
            }
        },
        "inverse": true,
        "next": [ "WantedBattleLostFailed" ]
    },
    // 动作必失败的终止节点：已识别出战斗失败，任务以 Failed 结束
    "WantedBattleLostFailed": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "通缉任务失败：战斗失败，游戏结束了自动通缉，请换更强的队伍后再运行"
        }
    },
    // 闲着的帧每 5 秒看一次，连续 5 次（约 20 秒）都闲才算跑完。
    // 跑的过程中也会短暂地像闲着：刚切完地图、到 NPC 还没弹窗口、镜头平移时横幅暂时消失，实测最长约 9 秒。
    // 这里只能靠时间区分，所以用 post_delay 隔开；就算误判，后面核对日常锻炼也会接着做
    "WantedIdle1": {
        "max_hit": 200, // 安全上限：每次跑的过程中短暂闲着都会命中一次
        "recognition": {
            "type": "And",
            "param": {
