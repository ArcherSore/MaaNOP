    "WantedWaitDone": {
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：20 分钟内角色一直没有停下来（一直在寻路、战斗或有窗口挡着）"
        },
        "timeout": 1200000,
        "next": [ "WantedBattleLost", "WantedIdle1" ]
    },
    // 战败会结束自动通缉并停在失败提示框。
    // 失败提示模板实测：63 帧均 ≥0.8，单人确认框最高 0.53；确认按钮仅卷纹之间可点。
    "WantedBattleLostText": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/BattleLost.png",
                "roi": [ 545, 365, 130, 40 ],
                "threshold": 0.8
            }
        }
    },
    "WantedBattleLost": {
        "max_hit": 3,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedBattleLostText" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 655, 424, 32, 10 ]
            }
        },
        "post_delay": 1000, // 提示框立即消失，无中间状态；等待 1 秒后再判断是否需要重试。
        "timeout": 5000,
        "next": [ "WantedBattleLostClosed", "WantedBattleLost" ]
    },
    "WantedBattleLostClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedBattleLostText" ]
            }
        },
        "inverse": true,
        "next": [ "WantedBattleLostFailed" ]
    },
    "WantedBattleLostFailed": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "通缉任务失败：战斗失败，游戏结束了自动通缉，请换更强的队伍后再运行"
        }
    },
    // 切地图、到达 NPC、镜头平移时会短暂呈闲置状态，实测最长约 9 秒。
    // 无其他状态可区分，需间隔采样确认约 20 秒闲置，再核对日常次数。
    "WantedIdle1": {
        "max_hit": 200, // 安全上限：途中短暂闲置也会累计命中。
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "post_delay": 5000,
        "next": [ "WantedIdle2", "WantedWaitDone" ]
    },
    "WantedIdle2": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "post_delay": 5000,
        "next": [ "WantedIdle3", "WantedWaitDone" ]
    },
    "WantedIdle3": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "post_delay": 5000,
        "next": [ "WantedIdle4", "WantedWaitDone" ]
    },
    "WantedIdle4": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "post_delay": 5000,
        "next": [ "WantedIdle5", "WantedWaitDone" ]
    },
    "WantedIdle5": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedIdleFrame" ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：跑完后主界面找不到「日常锻炼」，无法核对次数"
        },
        "timeout": 10000,
        "next": [ "WantedOpenDaily" ]
    }
}
