            "Node.Recognition.Succeeded": "通缉任务已开始自动完成，等游戏打完今天剩下的轮次（每轮约 2 分钟）"
        },
        "next": [ "WantedWaitDone" ]
    },

    // 寻路横幅模板实测：显示时 ≥0.99，淡入淡出 0.59~0.93，无横幅时最高 0.31。
    "WantedPathing": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/Pathing.png",
                "roi": [ 600, 140, 140, 40 ],
