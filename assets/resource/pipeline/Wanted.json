        "max_hit": 3,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedSoloText" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 598, 425, 36, 9 ]
            }
