        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedDailyTab" ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 752, 275, 1, 1 ],
                "end": [ 752, 520, 1, 1 ],
                "duration": 500
