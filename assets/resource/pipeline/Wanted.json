        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：「日常锻炼」窗口没有打开"
        },
        "post_delay": 1500, // 同上
        "timeout": 10000,
        "next": [ "WantedDailyOpened", "WantedOpenDailyAgain" ]
    },
    "WantedDailyTab": {
        "recognition": {
            "type": "TemplateMatch",
