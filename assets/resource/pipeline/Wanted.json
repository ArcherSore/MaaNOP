        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：日常锻炼列表里找不到「通缉任务」（等级不够或活动没开）"
        },
        "timeout": 3000,
        "next": [ "WantedSelectRow" ]
    },
    // 「参与」橙色像素实测：可用约 665，次数用完为 0。
    "WantedJoinOrange": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 822, 492, 62, 16 ],
                "method": 40,
                "lower": [ 3, 190, 150 ],
                "upper": [ 30, 255, 255 ],
                "count": 300
            }
        }
    },
    // 参与预算：首次开始 + 2 次补做。
    "WantedJoin": {
        "max_hit": 3,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedPanelTitle", "WantedJoinOrange" ]
