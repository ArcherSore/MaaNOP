                "roi": [ 600, 275, 140, 40 ],
                "threshold": 0.8
            }
        }
    },
    "WantedAutoStart": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedRemainLabel" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
