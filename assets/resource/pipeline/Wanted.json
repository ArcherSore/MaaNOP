    "WantedMapClear": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/StaminaLabel.png",
                "roi": [ 32, 84, 66, 61 ],
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    // 窗口不在前台时首次点击可能只激活窗口，游戏不接收点击。
    "WantedOpenDailyAgain": {
        "max_hit": 8,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear", "WantedDailyEntry" ],
