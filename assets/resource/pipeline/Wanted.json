// 自动完成会连续执行剩余轮次；闲置后核对「参与」是否变灰。
// 选队复用 Abundance*；interface.json 将 AbundanceTeamClose 接到 WantedTeamGate。
{
    "WantedTask": {
        "next": [ "WantedSetTeam" ]
    },
    // WantedTeam 传入阵容编号（1~8），复用 Abundance* 选阵容。
    "WantedSetTeam": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SetBossTeam",
                "custom_action_param": 1
            }
        },
        "next": [ "AbundanceTeamScreen", "AbundanceGotoTeam" ]
    },
    // WantedSoloTeam 选项切换到组队流程。
    "WantedTeamGate": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear" ]
            }
        },
        "next": [ "WantedOpenDaily" ]
    },
    // 入口须未组队；创建、退队各点击一次，等待悬停高亮变化。
    // 高亮像素 38，未高亮 ≤4，遮罩下 0。
    "WantedGroupHover": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 1195, 101, 7, 7 ],
                "method": 40,
                "lower": [ 0, 0, 235 ],
                "upper": [ 180, 25, 255 ],
                "count": 25
            }
        }
    },
    "WantedTeamOpen": {
        "max_hit": 1,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 1193, 102, 10, 10 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "通缉任务失败：点了组队按钮，但窗口没有打开"
        },
        "timeout": 10000,
        "next": [ "WantedTeamListOpened" ]
    },

    // 匹配分数：正常 1.0，遮罩下 0.77，其他 ≤0.45。
    "WantedTeamListOpened": {
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/TeamCreateBtn.png",
                "roi": [ 740, 535, 150, 50 ],
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 782, 551, 50, 14 ]
            }
        },
        "timeout": 10000,
        "next": [ "WantedTeamDialog" ]
    },
    // 匹配分数：目标 1.0，其他 ≤0.38。
    "WantedTeamDialog": {
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "wanted/TeamCreateTitle.png",
                "roi": [ 600, 300, 150, 50 ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 600, 452, 50, 12 ]
            }
        },
        "next": [ "WantedTeamHover" ]
    },
    "WantedTeamHover": {
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 1193, 102, 10, 10 ],
                "end": [ 1193, 102, 10, 10 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "next": [ "WantedTeamCreated" ]
    },
    "WantedTeamCreated": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "WantedMapClear", "WantedGroupHover" ]
