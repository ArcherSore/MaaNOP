// 骰子手气王（周末活动之一，步骤是 Weekend.json 里的 WeekendStepDice）：
// 找到周末福利页里「骰子手气王」那一行，点「去完成」进入棋盘，反复点中间的骰子，直到「今日剩余」变成 0，
// 然后交给 WeekendActivityDone 关窗口。每天 3 次，掷出的点数就是前进的格数，奖励到格时自动发放。
// 没有遇到过「格子任务」（说明里写落在某些格子上可能触发，要完成或放弃后才能再掷）：真遇到了，
// 骰子上方的次数认不出来，会超时停下，不会乱点。
{
    // ===== 周末福利页里「骰子手气王」那一行（写法同 NinjaPuzzle.json 的 PuzzleRow / PuzzleGo / PuzzleRowDone）=====
    "DiceRow": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 530, 258, 260, 190 ],
                "expected": [ "骰子手气王" ]
            }
        },
        "next": [ "DiceGo", "DiceRowDone" ]
    },
    "DiceGo": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "DiceRow",
                "roi_offset": [ 315, 44, 20, 4 ],
                "method": 40,
                "lower": [ 5, 150, 100 ],
                "upper": [ 20, 255, 255 ],
                "count": 300
            }
        },
        "action": "Click",
        "focus": {
            "Node.Action.Succeeded": "打开骰子手气王"
        },
        "next": [ "DiceNoRolls", "DiceRoll" ]
    },
    "DiceRowDone": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "DiceRow",
                "roi_offset": [ 315, 44, 20, 4 ],
                "method": 40,
                "lower": [ 0, 0, 40 ],
                "upper": [ 180, 40, 150 ],
                "count": 400
            }
        },
        "focus": {
            "Node.Action.Succeeded": "骰子手气王今天已经掷完"
        },
        "next": [ "WeekendActivityDone" ]
    },

    // ===== 棋盘：中间卡片上「今日剩余 N 次」的数字 =====
    // 点一下骰子，次数立刻减 1，但棋子要走完、奖励飘完才能再掷（约 5～6 秒），所以点完等 6 秒再看数字
    "DiceRoll": {
        "max_hit": 10,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "dice/Rolls1.png", "dice/Rolls2.png", "dice/Rolls3.png" ],
                "roi": [ 663, 465, 35, 35 ],
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 650, 413, 30, 30 ]
            }
        },
        "post_delay": 6000,
        "focus": {
            "Node.Action.Succeeded": "掷骰子"
        },
        "next": [ "DiceNoRolls", "DiceRoll" ]
    },
    "DiceNoRolls": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "dice/Rolls0.png",
                "roi": [ 663, 465, 35, 35 ],
                "threshold": 0.85
            }
        },
        "focus": {
            "Node.Action.Succeeded": "骰子手气王的次数已用完"
        },
        "next": [ "WeekendActivityDone" ]
    }
}
