            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": [ "InfiniteIllusionSweep2" ],
        "on_error": [ "InfiniteIllusionSwitchTo2" ]
    },
