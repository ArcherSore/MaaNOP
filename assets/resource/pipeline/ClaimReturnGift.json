{
    "ClaimReturnGiftEntry": {
        "timeout": 5000,
        "next": [ "ClickOnReturnGift" ],
        "on_error": [ "SkipReturnGift" ]
    },
    "SkipReturnGift": {
        "focus": {
            "Node.Recognition.Succeeded": "回归奖励未触发，没到30级或者没满7天就登录了！！！"
        },
        "next": [ "ClaimInfiniteIllusionEntry", "ClaimMailEntry", "ClaimLevelEntry", "Login" ]
    },
    "ClickOnReturnGift": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": "returnGift/ReturnGift.png"
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "focus": {
            "Node.Action.Succeeded": "开始领取回归礼包"
        },
        "next": [ "SwitchToReturnGiftTab" ]
    },
    "SwitchToReturnGiftTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "returnGift/GiftTab.png",
                "roi": [ 458, 220, 172, 117 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": [ "isClaimReturnGift", "noClaimReturnGift" ]
    },
    "isClaimReturnGift": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "returnGift/ToClaim.png",
                "roi": [ 420, 415, 134, 130 ]
            }
        },
        "next": [ "ClaimReturnGift" ]
    },
    "ClaimReturnGift": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "returnGift/ClaimButton.png",
                "roi": [ 572, 504, 165, 120 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": [ "ConfirmClaimReturnGift" ]
    },
    "ConfirmClaimReturnGift": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "returnGift/ConfirmButton.png",
                "roi": [ 588, 369, 152, 120 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "focus": {
            "Node.Action.Succeeded": "成功领取回归礼包"
        },
        "next": [ "CloseReturnGift" ]
    },
    "noClaimReturnGift": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "returnGift/Claimed.png",
                "roi": [ 417, 410, 139, 144 ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "无需领取回归礼包"
        },
        "next": [ "CloseReturnGift" ]
    },
    "CloseReturnGift": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CloseAllPopupsWithEsc"
            }
        },
        "next": [ "ClaimInfiniteIllusionEntry", "ClaimMailEntry", "ClaimLevelEntry", "Login" ]
    },
    "CheckRemainPopup": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "popup/Return.png" ],
                "roi": [ 671, 182, 260, 136 ],
                "order_by": "Score"
            }
        }
    }
}