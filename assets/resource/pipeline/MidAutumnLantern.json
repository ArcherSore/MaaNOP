{
    "MidAutumnLanternEntry": {
        "next": [ "MidAutumnNoTickets", "StartMidAutumnLantern" ]
    },
    "MidAutumnNoTickets": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 832, 481, 34, 20 ],
                "expected": [ "^[0Oo]$" ],
                "only_rec": true
            }
        },
        "next": [ "MidAutumnLanternSucceeded" ]
    },
    "StartMidAutumnLantern": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "MidAutumn/Start.png",
                "roi": [ 588, 348, 135, 80 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "focus": {
            "Node.Action.Succeeded": "开始中秋盛典"
        },
        "next": [ "SolveLanternPuzzle" ]
    },
    "SolveLanternPuzzle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "MidAutumn/Start.png",
                "roi": [ 588, 348, 135, 80 ]
            }
        },
        "inverse": true,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SolveLanternPuzzle"
            }
        },
        "next": [ "ClaimMidAutumnLantern" ]
    },
    "ClaimMidAutumnLantern": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "MidAutumn/Claim.png",
                "roi": [ 631, 392, 78, 64 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "ResetMidAutumnLantern" ]
    },
    "ResetMidAutumnLantern": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "MidAutumn/Reset.png",
                "roi": [ 611, 353, 79, 76 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "MoveMouseAwayFromReset" ]
    },
    // Reset 与 Start 位置重叠；悬停高亮会干扰 Start 模板，需先移开鼠标。
    "MoveMouseAwayFromReset": {
        "action": {
            "type": "TouchMove",
            "param": {
                "target": [ 850, 360, 1, 1 ]
            }
        },
        "next": [ "WaitMidAutumnReset" ]
    },
    "WaitMidAutumnReset": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "MidAutumn/Reset.png",
                "roi": [ 611, 353, 79, 76 ]
            }
        },
        "inverse": true,
        "next": [ "MidAutumnNoTickets", "StartMidAutumnLantern" ]
    },
    "MidAutumnLanternSucceeded": {
        "focus": {
            "Node.Action.Succeeded": "中秋盛典完成"
        }
    },
    // Called from action_mid_autumn.py.
    "LanternColorPopupTemplate": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "MidAutumn/ColorPopup.png",
                "roi": [ 725, 275, 64, 65 ]
            }
        }
    }
}
