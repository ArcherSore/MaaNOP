{
    "ClaimLevelEntry": {
        "next": [ "ClaimLevel" ]
    },
    "ClaimLevel": {
        "next": "ClickOnWelfare"
    },
    "ClickOnWelfare": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": [ "common/entry/SystemGift.png" ]
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "focus": {
            "Node.Action.Succeeded": "开始领取铜币经验"
        },
        "next": [ "AtClaimLevel", "NoAtClaimLevel" ]
    },
    "NoAtClaimLevel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "claimLevel/OffClaimLevel.png",
                "roi": [ 357, 423, 157, 116 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "AtClaimLevel"
    },
    "AtClaimLevel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "claimLevel/FlagClaimLevel.png",
                "roi": [ 456, 289, 180, 115 ]
            }
        },
        "next": [ "EnsureClaimLevel", "NoNeedClaimLevel", "NeedClaimLevel" ]
    },
    "NoNeedClaimLevel": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "无可追[回同问]资源",
                "roi": [ 642, 336, 67, 18 ],
                "only_rec": true
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "不需要领取铜币经验"
        },
        "next": "ExitClaimLevel"
    },
    "NeedClaimLevel": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AtClaimLevel",
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                // 第一行铜币按钮内部：普通约 198、悬停 437；
                                // 已找回底纹及确认框遮罩下为 0。加暗 20% 正例最低 110。
                                "roi": [ 752, 337, 60, 18 ],
                                "method": 40,
                                "lower": [ 85, 130, 140 ],
                                "upper": [ 115, 255, 255 ],
                                "count": 80
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 765, 343, 30, 5 ]
            }
        },
        "next": "EnsureClaimLevel"
    },
    "EnsureClaimLevel": {
        "recognition": {
            "type": "OCR",
            "param": {
                // 识别铜币经验确认正文，避免单字「是」漂移或误认其它确认框。
                "expected": "是否花费[0-9]+铜币.*经验奖励",
                "roi": [ 550, 375, 240, 35 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 595, 426, 30, 5 ]
            }
        },
        "next": "ClaimLevelConfirmed"
    },
    "ClaimLevelConfirmed": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "无可追[回同问]资源",
                "roi": [ 630, 330, 100, 35 ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "成功领取铜币经验"
        },
        "next": "ExitClaimLevel"
    },
    "ExitClaimLevel": {
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27
            }
        },
        "next": "ClaimLevelClosed"
    },
    "ClaimLevelClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AtClaimLevel" ]
            }
        },
        "inverse": true,
        "next": [ "BatchServerDone" ]
    }
}