{
    "NinjutsuTrainingEntry": {
        "next": [ "StartNinjutsuTraining" ]
    },
    "StartNinjutsuTraining": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "NinjutsuTraining/button/Start.png",
                "roi": [ 552, 454, 149, 79 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "focus": {
            "Node.Action.Succeeded": "开始忍术特训"
        },
        "next": [ "WaitNinjutsuTrainingState" ]
    },
    "WaitNinjutsuTrainingState": {
        "next": [ "CheckNinjutsuTrainingClaim", "WaitHandSealRoundStart" ]
    },
    "WaitHandSealRoundStart": {
        "max_hit": 3,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "NinjutsuTraining/states/StartOnce.png",
                "roi": [ 541, 417, 78, 71 ]
            }
        },
        "next": [ "ExecuteHandSealRound" ]
    },
    "CheckNinjutsuTrainingClaim": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "NinjutsuTraining/button/Claim.png",
                "roi": [ 622, 439, 78, 64 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "NinjutsuTrainingSucceeded" ]
    },
    "ExecuteHandSealRound": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ExecuteHandSealRound"
            }
        },
        "next": [ "WaitNinjutsuTrainingState" ],
        "on_error": [ "NinjutsuTrainingFailed" ]
    },
    "NinjutsuTrainingSucceeded": {
        "focus": {
            "Node.Action.Succeeded": "忍术特训完成"
        }
    },
    "NinjutsuTrainingFailed": {
        "focus": {
            "Node.Action.Succeeded": "忍术特训失败"
        }
    },
    // The CustomAction invokes these nodes through context.run_recognition.
    // Slot ROIs are supplied at runtime from action_ninjutsu_training.py.
