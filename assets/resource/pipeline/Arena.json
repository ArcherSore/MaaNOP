{
    // ---------------一口气打到六道---------------
    "ArenaRankGrind": {
        "next": [ "WaitArenaMain", "GotoArena" ]
    },
    "GotoArena": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": "arena/ArenaEntry.png"
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "WaitArenaMain" ]
    },
    "WaitArenaMain": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/ArenaMainFlag.png",
                "roi": [ 217, 522, 79, 73 ]
            }
        },
        "next": [ "[JumpBack]CloseArenaPopup", "CheckRank", "RankNotReached" ]
    },
    "CheckRank": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/RankRikudouFlag.png",
                "roi": [ 231, 194, 91, 98 ]
            }
        },
        "next": [ "RankReached" ]
    },
    "RankNotReached": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/RankRikudouFlag.png",
                "roi": [ 231, 194, 91, 98 ]
            }
        },
        "inverse": true,
        "next": [ "StartFormalBattle" ]
    },
    "StartFormalBattle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/ButtonFormalBattleStart.png",
                "roi": [ 399, 556, 160, 83 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "ArenaSceneLoaded" ]
    },
    "BattleResultPopup": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchPopup",
                "custom_recognition_param": {
                    "popups": [
                        { "name": "战斗胜利", "template": "arena/BattleWinPopup.png", "roi": [ 555, 206, 201, 103 ], "target": [ 647, 506, 30, 13 ] },
                        { "name": "新增试用忍者", "template": "arena/AddNewTrialNinja.png", "roi": [ 548, 207, 233, 96 ], "target": [ 763, 498, 34, 9 ] },
                        { "name": "战斗失败", "template": "arena/BattleLosePopup.png", "roi": [ 561, 211, 209, 92 ], "target": [ 649, 493, 44, 13 ] },
                        { "name": "成为六道", "template": "arena/RankRikudouPopup.png", "roi": [ 557, 205, 206, 101 ], "target": [ 644, 488, 38, 13 ] }
                    ]
                }
            }
        },
        "action": "Click"
    },
    "CloseArenaPopup": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/NewTermPopup.png",
                "roi": [ 575, 243, 183, 68 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 655, 507, 33, 14 ]
            }
        }
    },
    "RankReached": {
        "focus": {
            "Node.Action.Succeeded": "六道段位达成"
        }
    },

    // ---------------主题竞技场---------------
    // 一直打到六道 / 九胜可领取
    "ThemeArena": {
        "next": [ "WaitThemeMain" ]
    },
    "WaitThemeMain": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/ThemeMainFlag.png",
                "roi": [ 1030, 85, 75, 60 ],
                "method": 1
            }
        },
        "next": [ "ThemeRikudouReached", "ThemeNineWinsReached", "ThemeStartBattle" ]
    },
    "ThemeRikudouReached": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/ThemeRankRikudouFlag.png",
                "roi": [ 234, 171, 81, 85 ]
            }
        },
        "focus": {
            "Node.Action.Succeeded": "六道段位达成"
        }
    },
    "ThemeNineWinsReached": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 290, 525, 81, 64 ],
                "method": 40,
                "lower": [ 95, 120, 120 ],
                "upper": [ 125, 255, 255 ],
                "count": 100
            }
        },
        "focus": {
            "Node.Action.Succeeded": "九胜奖励可领取"
        }
    },
    "ThemeStartBattle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/ThemeBattleButton.png",
                "roi": [ 480, 570, 130, 55 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "ArenaSceneLoaded" ]
    },
    "ThemeBattleResultPopup": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchPopup",
                "custom_recognition_param": {
                    "popups": [
                        { "name": "战斗胜利", "template": "arena/BattleWinPopup.png", "roi": [ 555, 206, 201, 103 ], "target": [ 647, 506, 30, 13 ] },
                        { "name": "战斗失败", "template": "arena/BattleLosePopup.png", "roi": [ 561, 211, 209, 92 ], "target": [ 649, 493, 44, 13 ] },
                        { "name": "成为六道", "template": "arena/RankRikudouPopup.png", "roi": [ 557, 205, 206, 101 ], "target": [ 644, 488, 38, 13 ] }
                    ]
                }
            }
        },
        "action": "Click"
    },

    // ---------------公共战斗流程（两个竞技场任务共用）---------------
    "ArenaSceneLoaded": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "arena/BattleSpeedLocked.png",
                                "roi": [ 870, 635, 69, 69 ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [ 300, 200, 750, 360 ],
                                "method": 4,
                                "lower": [ 12, 12, 12 ],
                                "upper": [ 255, 255, 255 ],
                                "count": 100000
                            }
                        }
                    }
                ]
            }
        },
        "next": [ "ArenaAutoOn", "ArenaAutoOff" ]
    },
    "ArenaAutoOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOn.png", "common/battle/AutoOnHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "timeout": 120000,
        "next": [ "WaitBattleEnd" ],
        "on_error": [ "ArenaBattleKeepWaiting" ]
    },
    "ArenaAutoOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOff.png", "common/battle/AutoOffHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 120000,
        "next": [ "WaitBattleEnd" ],
        "on_error": [ "ArenaBattleKeepWaiting" ]
    },
    "ArenaBattleKeepWaiting": {
        "action": "DoNothing",
        "timeout": 120000,
        "next": [ "WaitBattleEnd" ],
        "on_error": [ "ArenaBattleKeepWaiting" ]
    },
    "WaitBattleEnd": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/BattleEnd.png",
                "roi": [ 611, 438, 121, 69 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "[JumpBack]BattleResultPopup", "WaitArenaMain" ]
    }
}
