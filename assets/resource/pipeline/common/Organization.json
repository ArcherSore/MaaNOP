{
    // 调用方将 OrganizationContinue 绑定到组织窗口内的活动入口。
    "Organization": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 10000,
        "anchor": { "OrganizationOpened": "OrganizationWindow" },
        "next": [ "OrganizationWindow", "OrganizationOpen" ]
    },
    "OrganizationOpen": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindHoveredBottomEntry",
                "custom_recognition_param": {
                    "normal_template": "common/entry/OrganizationEntry.png",
                    "hover_template": "common/entry/OrganizationEntryHover.png"
                }
            }
        },
        "action": "Click",
        "timeout": 10000,
        "next": [ "[Anchor]OrganizationOpened" ]
    },
    "OrganizationWindow": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/organization/WindowTitle.png",
                "roi": [ 635, 169, 80, 48 ],
                "method": 10001,
                "threshold": 0.8
            }
        },
        "next": [ "[Anchor]OrganizationContinue" ]
    }
}
