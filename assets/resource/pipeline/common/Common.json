{
    // 移开鼠标，避免按钮高亮或悬浮说明干扰后续识别。
    "MouseMoveReset": {
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 100, 400 ],
                "end": [ 100, 400 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "anchor": {
            "MouseMoveResetAnchor": ""
        },
        "post_delay": 0,
        "rate_limit": 0
    },
    "ServerBusySpinner": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/server_busy/00.png", "common/server_busy/03.png", "common/server_busy/06.png", "common/server_busy/09.png" ],
                "roi": [ 640, 361, 60, 44 ],
                "threshold": 0.6,
                "green_mask": true
            }
        }
    }
}
