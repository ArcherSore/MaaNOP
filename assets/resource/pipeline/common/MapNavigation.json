{
    "MapHoverWorldButton": {
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 1256, 70, 1, 1 ],
                "end": [ 1256, 70, 1, 1 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "post_delay": 0,
        "next": [ "MapOpenWorld" ]
    },
    "MapOpenWorld": {
        // 提示框可能盖到按钮边缘，只识别图标内部的高亮并点按钮下半部。
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 1251, 64, 8, 6 ],
                "method": 40,
                "lower": [ 0, 0, 232 ],
                "upper": [ 180, 55, 255 ],
                "count": 24
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 1256, 70, 1, 1 ]
            }
        },
        "next": [ "MapHoverKonoha" ]
    },
    "MapHoverKonoha": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 476, 515, 53, 23 ],
