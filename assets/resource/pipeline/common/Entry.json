// 找到标签后交还调用方验证业务页面；确认缺席时关闭并验证主界面后返回。
{
    "HotspotEntry": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "HoverHotspotEntry" ]
    },
    "HoverHotspotEntry": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/hotspot/Hotspot.png",
                "roi": [ 295, 51, 116, 117 ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin_offset": [ 4, 4, -8, -8 ],
                "end_offset": [ 4, 4, -8, -8 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "post_delay": 0,
        "next": [ "OpenHotspot" ]
    },
    "OpenHotspot": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/hotspot/HotspotHover.png",
                "roi": [ 295, 40, 116, 117 ],
                "method": 10001,
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": "HoverHotspotEntry",
                "target_offset": [ 4, 4, -8, -8 ]
            }
        },
        // 打开和翻页后先等侧栏稳定，再识别标签或箭头。
        "post_wait_freezes": {
            "time": 300,
            "target": [ 352, 241, 109, 268 ],
            "threshold": 0.98,
            "rate_limit": 100,
            "timeout": 5000
        },
        "next": [ "HotspotTabsReady" ]
    },
    "HotspotTabsReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [ 391, 212, 30, 7 ],
                                "lower": [ 205, 170, 100 ],
                                "upper": [ 255, 255, 255 ],
                                "count": 150
                            }
                        }
                    },
                    "CloseHotspotWindow"
                ]
            }
        },
        "next": [ "ClickHotspotEntry", "HoverHotspotScrollDown", "HotspotTabsBottom", "HotspotTabsSinglePage" ]
    },
    "ClickHotspotEntry": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 352, 241, 109, 268 ],
                "expected": [ "(?!)" ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "HoverHotspotScrollDown": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/hotspot/ScrollDown.png",
                "roi": [ 415, 528, 40, 32 ],
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 435, 542 ],
                "end": [ 435, 542 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "post_delay": 0,
        "next": [ "ScrollHotspotActivityTabs" ]
    },
    "ScrollHotspotActivityTabs": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/hotspot/ScrollDownHover.png",
                "roi": [ 415, 528, 40, 32 ],
                "threshold": 0.95
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 432, 538, 6, 7 ]
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [ 352, 241, 109, 268 ],
            "threshold": 0.98,
            "rate_limit": 100,
            "timeout": 5000
        },
        "timeout": 5000,
        "next": [ "HotspotTabsReady" ]
    },
    // 灰箭头模板须与可点击态区分，阈值高于可点击态的得分。
    "HotspotTabsBottom": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/hotspot/ScrollDownDisabled.png",
                "roi": [ 415, 528, 40, 32 ],
                "threshold": 0.8
            }
        },
        "next": [ "HotspotClose" ]
    },
    // 活动不足一页时不显示翻页箭头，需识别单页底边确认列表已完整显示。
    "HotspotTabsSinglePage": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/hotspot/TabsSinglePageFooter.png",
                "roi": [ 337, 504, 138, 36 ],
                "threshold": 0.85
            }
        },
        "next": [ "HotspotClose" ]
    },
    "HotspotClose": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "CloseHotspotWindow", "HotspotWindowClosed" ]
    },
    // 关闭叉的位置随活动变化；亮度敏感匹配排除被弹窗遮住时的关闭叉。
    "CloseHotspotWindow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/hotspot/CloseX.png",
                "roi": [ 900, 195, 65, 48 ],
                "method": 10001,
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [ 4, 4, -8, -8 ]
            }
        },
        "post_delay": 0,
        "next": [ "HotspotWindowClosed" ]
    },
    // 复用亮度敏感的体力标识，排除窗口遮罩。
    "HotspotWindowClosed": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "LoginMapVisible" ]
            }
        }
    },
    "TopEntryTemplate": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ ],
                "roi": [ 391, 40, 800, 114 ]
            }
        }
    },
    "BottomEntryTemplate": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ ],
                "roi": [ 900, 648, 440, 72 ],
                "threshold": 0.85
            }
        }
    },
    "BottomEntryPrepare": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 10000,
        "next": [ "BottomEntryHover" ]
    },
    "BottomEntryHover": {
        "rate_limit": 200,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BottomEntryTemplate" ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin_offset": [ 5, 4, -10, -8 ],
                "end_offset": [ 5, 4, -10, -8 ],
                "only_hover": true
            }
        },
        "post_delay": 0,
        "timeout": 10000,
        "next": [ "BottomEntryHoverReady" ]
    },
    "BottomEntryHoverReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ ],
                "roi": "BottomEntryHover",
                "roi_offset": [ -4, -4, 8, 8 ],
                "threshold": 0.85
            }
        }
    }
}
