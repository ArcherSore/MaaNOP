{
    // 四个 PvE 任务共用。调用方保留开战入口名和次数上限，并设置三个锚点：
    // CommonBattleStartTarget 指向自己的开战节点，兼作点击目标和重试入口；
    // CommonBattleContinue 指向结果等待，CommonBattleOutcome 只识别已有结果。
    // 不接入竞技场。
    // 2026-10-20 历史实图：强者 t3.png 为居中单按钮；组队 intro_a.png、
    // 考试 007-AbilityExamStart.png、丰饶会话 e53c4c0c 的 z_start.png 为双按钮。
    // ROI 下边界为 464，避开考试「下一关」从 y=465 开始的 OCR 区域。
    "CommonBattleStartButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 575, 419, 175, 24 ],
                "expected": [ "开战" ]
            }
        }
    },
    "CommonBattleClickStart": {
        // 整个任务累计的安全上限；组队 / 考试还保留各自的 20 / 24 次上限。
        "max_hit": 80,
        "action": {
            "type": "Click",
            "param": {
                "target": "[Anchor]CommonBattleStartTarget"
            }
        },
        "timeout": 20000,
        // 只有再次识别到开战按钮才补点，进入战斗后不再点击旧位置。
        "next": [ "[Anchor]CommonBattleOutcome", "CommonBattleAutoOn", "CommonBattleAutoOff", "[Anchor]CommonBattleStartTarget" ]
    },
    "CommonBattleAutoOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOn.png", "common/battle/AutoOnHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "next": [ "[Anchor]CommonBattleOutcome", "CommonBattleSpeedOn", "CommonBattleSpeedOff", "[Anchor]CommonBattleStartTarget" ]
    },
    "CommonBattleAutoOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOff.png", "common/battle/AutoOffHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": "Click",
        // 点击后等 On 验证；切换期间可能显示旧状态，不立即重复切换。
        "next": [ "[Anchor]CommonBattleOutcome", "CommonBattleAutoOn", "[Anchor]CommonBattleStartTarget" ]
    },
    "CommonBattleSpeedOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOn.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "next": [ "[Anchor]CommonBattleContinue" ]
    },
    "CommonBattleSpeedOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOff.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "action": "Click",
        "next": [ "[Anchor]CommonBattleOutcome", "CommonBattleSpeedOn", "[Anchor]CommonBattleStartTarget" ]
    }
}
