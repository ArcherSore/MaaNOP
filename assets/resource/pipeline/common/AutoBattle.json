{
    // PvE 任务共用。需要公共开战时，调用方绑定以下锚点：
    // CommonBattleStartTarget 指向自己的开战节点，兼作点击目标和重试入口；
    // CommonBattleContinue 指向结果等待，CommonBattleOutcome 只识别已有结果。
    // CommonBattleInterrupt 指向业务退出条件；不需要中途退出时绑定 CommonBattleNoInterrupt。
    // 默认执行自动与倍速。关闭自动时绑定 CommonBattleSkipAuto 到 CommonBattleSetupSpeed；
    // 关闭倍速时绑定 CommonBattleSkipSpeed 到 CommonBattleFinishSetup。
    // 不接入竞技场。
    // 开战按钮有居中单按钮和双按钮两种布局，ROI 须同时覆盖。
    // ROI 下边界避开考试「下一关」的 OCR 区域。
    "CommonBattleStartButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 575, 419, 175, 24 ],
                "expected": [ "开战" ]
            }
        }
    },
    "CommonBattleClickStart": {
        "action": {
            "type": "Click",
            "param": {
                "target": "[Anchor]CommonBattleStartTarget"
            }
        },
        "next": [ "CommonBattleSetup" ]
    },
    "CommonBattleSetup": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 20000,
        // 只有再次识别到开战按钮才补点，进入战斗后不再点击旧位置。
        "next": [ "[Anchor]CommonBattleOutcome", "[Anchor]CommonBattleInterrupt", "[Anchor]CommonBattleSkipAuto", "CommonBattleAutoOn", "CommonBattleAutoOff", "[Anchor]CommonBattleStartTarget" ]
    },
    "CommonBattleAutoOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOn.png", "common/battle/AutoOnHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "next": [ "CommonBattleSetupSpeed" ]
    },
    "CommonBattleAutoOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOff.png", "common/battle/AutoOffHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": "Click",
        "next": [ "CommonBattleSetupSpeed" ]
    },
    "CommonBattleSetupSpeed": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 20000,
        "next": [ "[Anchor]CommonBattleOutcome", "[Anchor]CommonBattleInterrupt", "[Anchor]CommonBattleSkipSpeed", "CommonBattleSpeedOn", "CommonBattleSpeedOff", "[Anchor]CommonBattleStartTarget" ]
    },
    "CommonBattleFinishSetup": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "[Anchor]CommonBattleStartTarget", "[Anchor]CommonBattleContinue" ]
    },
    "CommonBattleSpeedOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOn.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "next": [ "[Anchor]CommonBattleOutcome", "[Anchor]CommonBattleInterrupt", "[Anchor]CommonBattleContinue" ]
    },
    "CommonBattleSpeedOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOff.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "action": "Click",
        "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "[Anchor]CommonBattleOutcome", "[Anchor]CommonBattleInterrupt", "[Anchor]CommonBattleContinue" ]
    },
    "CommonBattleNoInterrupt": {
        "enabled": false
    },
    // 仅供使用中央「确认」结算按钮的任务接入，调用方绑定 CommonBattleAfterResult。
    "CommonBattleClickResultConfirm": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 638, 440, 65, 24 ],
                "expected": "^确认$",
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 660, 448, 23, 8 ]
            }
        },
        "timeout": 15000,
        "next": [ "[Anchor]CommonBattleAfterResult" ]
    },
    "CommonBattleRetreat": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/Retreat.png", "common/battle/RetreatHover.png" ],
                "roi": [ 1050, 610, 80, 60 ],
                "threshold": 0.8
            }
        },
        "action": "Click",
        "timeout": 5000,
        "next": [ "CommonBattleRetreatConfirm" ]
    },
    "CommonBattleRetreatDialogText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 965, 551, 145, 40 ],
                "expected": [ "撤退将判定.*失败", "确定撤退吗" ]
            }
        }
    },
    "CommonBattleRetreatConfirmText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 979, 592, 50, 22 ],
                "expected": "^确认$"
            }
        }
    },
    "CommonBattleRetreatConfirm": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "CommonBattleRetreatDialogText", "CommonBattleRetreatConfirmText" ],
                "box_index": 1
            }
        },
        "action": "Click",
        "timeout": 5000,
        "next": [ "[Anchor]CommonBattleOutcome" ]
    }
}
