{
    "AbundanceRoom": {
        "next": [ "AbundanceSetTeam" ]
    },
    "AbundanceSetTeam": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SelectTeam",
                "custom_action_param": 1
            }
        },
        "next": [ "AbundanceGotoRoom" ]
    },

    "AbundanceGotoRoom": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": "abundance/AbundanceEntry.png"
                }
            }
        },
        "action": "Click",
        "next": [ "AbundancePopup" ]
    },
    "AbundancePopup": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "abundance/PopupTitle.png",
                "roi": [ 600, 198, 128, 26 ]
            }
        },
        "next": [ "AbundanceNoChance", "AbundanceSimple", "AbundanceLeftArrow" ]
    },
    "AbundanceTimesLeft": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "abundance/TimesLeftLabel.png",
                "roi": [ 775, 255, 140, 22 ]
            }
        }
    },
    "AbundanceNoChance": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "abundance/NoChanceLabel.png",
                "roi": [ 775, 262, 140, 30 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 949, 216, 12, 12 ]
            }
        },
        "focus": {
            "Node.Action.Succeeded": "丰饶之间本日挑战次数已用完"
        }
    },
    // 每次打开都重置到「困难/极限/极限」页，简单难度在前一页。
    "AbundanceSimpleLabel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "abundance/SimpleLabel.png",
                "roi": [ 400, 285, 200, 40 ],
                "threshold": 0.85
            }
        }
    },
    "AbundanceLeftArrow": {
        "max_hit": 6,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AbundanceTimesLeft" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 399, 324, 10, 14 ]
            }
        },
        "post_delay": 500,
        "next": [ "AbundanceSimple", "AbundanceLeftArrow" ]
    },
    // 悬停时关卡图有火焰动画，改用「简单」文字识别；点击区域避开「查看掉落」和「扫荡」。
    "AbundanceSimple": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AbundanceSimpleLabel", "AbundanceTimesLeft" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 440, 330, 70, 24 ]
            }
        },
        "next": [ "AbundanceBattleStart" ]
    },

    "AbundanceBattleStart": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "abundance/BattleStart.png",
                "roi": [ 583, 443, 85, 22 ]
            }
        },
        "action": "Click",
        "next": [ "AbundanceBattleStart", "AbundanceAutoOn", "AbundanceAutoOff" ]
    },
    "AbundanceAutoOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOn.png", "common/battle/AutoOnHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "next": [ "AbundanceSpeedOn", "AbundanceSpeedOff" ]
    },
    "AbundanceAutoOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOff.png", "common/battle/AutoOffHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": "Click",
        "next": [ "AbundanceSpeedOn", "AbundanceSpeedOff" ]
    },
    "AbundanceSpeedOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOn.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "timeout": 30000,
        "next": [ "AbundanceResultConfirm" ],
        "on_error": [ "AbundanceBattleTimeoutProbe" ]
    },
    "AbundanceSpeedOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOff.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "action": "Click",
        "timeout": 30000,
        "next": [ "AbundanceResultConfirm" ],
        "on_error": [ "AbundanceBattleTimeoutProbe" ]
    },
    "AbundanceBattleTimeoutProbe": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOn.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "next": [ "AbundanceSpeedOn" ],
        "on_error": [ "AbundanceResultConfirm" ]
    },
    "AbundanceResultConfirm": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "abundance/ResultConfirm.png",
                "roi": [ 620, 455, 105, 35 ]
            }
        },
        "action": "Click",
        "next": [ "AbundanceSettle" ]
    },
    // 「返回游戏」按钮带动态倒计时，模板仅截取文字。
    "AbundanceSettle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "abundance/SettleBack.png",
                "roi": [ 600, 455, 140, 32 ]
            }
        },
        "action": "Click",
        "post_delay": 500,
        "next": [ "AbundanceGotoRoom" ]
    }
}
