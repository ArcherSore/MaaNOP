{
    "DailyArena": {
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Action.Succeeded": "开始「竞技场」任务"
        },
        "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "[JumpBack]CloseArenaPopup", "DailyArenaMain", "DailyArenaOpen" ]
    },
    "DailyArenaOpen": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": "arena/ArenaEntry.png"
                }
            }
        },
        "action": "Click",
        "next": [ "[JumpBack]CloseArenaPopup", "DailyArenaMain" ]
    },
    "DailyArenaMain": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyArenaOrdersText", "DailyArenaMainBright" ]
            }
        },
        "next": [ "DailyArenaOrdersEmpty", "DailyArenaCheckClaims" ]
    },
    "DailyArenaOrdersText": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 680, 205, 75, 25 ],
                "expected": "战令\\s*[:：]?\\s*\\d+"
            }
        }
    },
    // OCR 在遮罩下仍能读到主界面，需同时确认亮度，不能提前点击背景按钮。
    "DailyArenaMainBright": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 685, 212, 55, 18 ],
                "method": 4,
                "lower": [ 170, 140, 40 ],
                "upper": [ 255, 255, 220 ],
                "count": 40
            }
        }
    },
    "DailyArenaOrdersEmpty": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 680, 205, 75, 25 ],
                "expected": "战令\\s*[:：]?\\s*0\\s*个"
            }
        },
        "next": [ "DailyArenaExit" ]
    },
    // 每个 next 至多放一个任务卡 OCR，避免同 ROI 的领取/已满足/未满足被批量 OCR 损坏。
    // 先领取，再逐张处理未满足条件，尽量让两张卡同场完成；最后才检查已满足任务并开战。
    "DailyArenaCheckClaims": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaHoverClaimTop", "DailyArenaCheckBottomClaim" ]
    },
    "DailyArenaCheckBottomClaim": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaHoverClaimBottom", "DailyArenaCheckTopUnmet" ]
    },
    "DailyArenaCheckTopReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaTopReady", "DailyArenaCheckBottomReady" ]
    },
    "DailyArenaCheckBottomReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaBottomReady", "DailyArenaCheckTasksEmpty" ]
    },
    "DailyArenaCheckTopUnmet": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaTopUnmet", "DailyArenaCheckBottomUnmet" ]
    },
    "DailyArenaCheckBottomUnmet": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaBottomUnmet", "DailyArenaCheckTopReady" ]
    },
    "DailyArenaCheckTasksEmpty": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaTasksEmpty" ]
    },
    "DailyArenaEmptyTopText": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": { "type": "OCR", "param": { "roi": [ 232, 332, 105, 35 ], "expected": "[已己]无可挑战" } }
    },
    "DailyArenaEmptyBottomText": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": { "type": "OCR", "param": { "roi": [ 232, 419, 105, 35 ], "expected": "[已己]无可挑战" } }
    },
    "DailyArenaTasksEmpty": {
        "pre_delay": 0,
        "post_delay": 0,
        // 一张卡完成后显示「已无可挑战任务，明天再来看看吧」；两张都显示才算任务为空。
        // 「剩余 N 个任务」只计待补充队列，队列耗尽时标题消失，不能据此结束。
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyArenaMainBright",
                    "DailyArenaEmptyTopText",
                    "DailyArenaEmptyBottomText"
                ]
            }
        },
        "next": [ "DailyArenaExit" ]
    },
    "DailyArenaHoverClaimTop": {
        "post_delay": 0,
        "rate_limit": 200,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 280, 369, 55, 25 ],
                "expected": "领取"
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 306, 381 ],
                "end": [ 306, 381 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "next": [ "DailyArenaClaimTop" ]
    },
    // 取按钮左侧的底色识别高亮，避开中间的文字和普通态的亮边。
    "DailyArenaClaimTop": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 288, 375, 9, 8 ],
                "method": 4,
                "lower": [ 0, 190, 195 ],
                "upper": [ 150, 255, 255 ],
                "count": 24
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 291, 378, 28, 8 ]
            }
        },
        "max_hit": 12,
        "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "DailyArenaMain" ]
    },
    // OCR 会把「满」读成「溝」；仅容错满/溝，仍严格区分已和未。
    "DailyArenaTopReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 280, 369, 55, 25 ],
                "expected": "条件已[满溝]足"
            }
        },
        "next": [ "DailyArenaHoverStartBattle" ]
    },
    "DailyArenaTopUnmet": {
        "post_delay": 0,
        "rate_limit": 200,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 280, 369, 55, 25 ],
                "expected": "条件未满足|^降低"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 291, 378, 28, 8 ]
            }
        },
        "max_hit": 6,
        "next": [ "DailyArenaLowerDialog" ]
    },
    "DailyArenaHoverClaimBottom": {
        "post_delay": 0,
        "rate_limit": 200,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 280, 456, 55, 25 ],
                "expected": "领取"
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 306, 468 ],
                "end": [ 306, 468 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "next": [ "DailyArenaClaimBottom" ]
    },
    "DailyArenaClaimBottom": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 288, 462, 9, 8 ],
                "method": 4,
                "lower": [ 0, 190, 195 ],
                "upper": [ 150, 255, 255 ],
                "count": 24
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 291, 465, 28, 8 ]
            }
        },
        "max_hit": 12,
        "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "DailyArenaMain" ]
    },
    "DailyArenaBottomReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 280, 456, 55, 25 ],
                "expected": "条件已[满溝]足"
            }
        },
        "next": [ "DailyArenaHoverStartBattle" ]
    },
    "DailyArenaBottomUnmet": {
        "post_delay": 0,
        "rate_limit": 200,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 280, 456, 55, 25 ],
                "expected": "条件未满足|^降低"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 291, 465, 28, 8 ]
            }
        },
        "max_hit": 6,
        "next": [ "DailyArenaLowerDialog" ]
    },
    // 无损和减半共用同一个弹窗，必须按说明分流，不能用「确定」是否高亮来选择操作。
    "DailyArenaLowerDialog": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 552, 359, 240, 29 ],
                "expected": "无损降低|减半"
            }
        },
        "next": [ "DailyArenaHoverLowerFree", "DailyArenaLowerCheckEmpty" ]
    },
    "DailyArenaHoverLowerFree": {
        "post_delay": 0,
        "rate_limit": 200,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 603, 370, 135, 20 ],
                "expected": "[余馀]\\s*[1-9]\\s*次无损降低"
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 610, 408 ],
                "end": [ 610, 408 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "next": [ "DailyArenaLowerFree" ]
    },
    // 关闭弹窗后先移开鼠标，避免忍者技能说明遮住战令。
    "DailyArenaLowerFree": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 591, 407, 9, 7 ],
                "method": 4,
                "lower": [ 225, 114, 0 ],
                "upper": [ 255, 255, 140 ],
                "count": 20
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 599, 404, 22, 8 ]
            }
        },
        "max_hit": 3,
        "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "DailyArenaMain" ]
    },
    // 两种说明的 OCR 区域重叠，分开识别以免批量 OCR 干扰。
    "DailyArenaLowerCheckEmpty": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaHoverLowerEmpty" ]
    },
    "DailyArenaHoverLowerEmpty": {
        "post_delay": 0,
        "rate_limit": 200,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 552, 359, 240, 29 ],
                "expected": "减半"
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 729, 408 ],
                "end": [ 729, 408 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "next": [ "DailyArenaLowerEmpty" ]
    },
    "DailyArenaLowerEmpty": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 740, 408, 9, 7 ],
                "method": 4,
                "lower": [ 0, 160, 215 ],
                "upper": [ 165, 255, 255 ],
                "count": 26
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 718, 404, 22, 8 ]
            }
        },
        "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "DailyArenaLowerReturned" ]
    },
    // 无损用完后先确认弹窗已关闭，再检查上下两张已满足任务；有任意一张仍可战斗。
    // 此分支不再检查未满足任务，避免立即重新打开同一个减半提示。
    "DailyArenaLowerReturned": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyArenaOrdersText", "DailyArenaMainBright" ]
            }
        },
        "next": [ "DailyArenaTopReady", "DailyArenaCheckBottomReadyAfterLowerEmpty" ]
    },
    "DailyArenaCheckBottomReadyAfterLowerEmpty": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaBottomReady", "DailyArenaCheckLowerCancelled" ]
    },
    "DailyArenaCheckLowerCancelled": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "DailyArenaLowerCancelled" ]
    },
    "DailyArenaLowerCancelled": {
        "pre_delay": 0,
        "post_delay": 0,
        // 免费次数耗尽时，必须正向读到两张卡均未满足或已无可挑战任务。
        // 不能把已满足 OCR 漏识别当成没有已满足任务；领奖按钮也不能被跳过。
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "DailyArenaOrdersText",
                    "DailyArenaMainBright",
                    { "sub_name": "DailyArenaBlockedTop", "recognition": { "type": "Or", "param": { "any_of": [ "DailyArenaTopUnmet", "DailyArenaEmptyTopText" ] } } },
                    { "sub_name": "DailyArenaBlockedBottom", "recognition": { "type": "Or", "param": { "any_of": [ "DailyArenaBottomUnmet", "DailyArenaEmptyBottomText" ] } } }
                ]
            }
        },
        "next": [ "DailyArenaExit" ]
    },
    "DailyArenaExit": {
        "rate_limit": 200,
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "alt_accounts/leveling/buttons/Close.png", "alt_accounts/leveling/buttons/CloseHover.png" ],
                "roi": [ 1126, 81, 31, 31 ],
                "threshold": 0.86
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 1141, 96 ],
                "end": [ 1141, 96 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "next": [ "DailyArenaClickExitHover" ]
    },
    "DailyArenaClickExitHover": {
        "rate_limit": 200,
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/leveling/buttons/CloseHover.png",
                "roi": [ 1126, 81, 31, 31 ],
                "threshold": 0.86
            }
        },
        "action": {
            "type": "Click",
            "param": { "target": [ 1137, 92, 8, 8 ] }
        },
        "next": [ "DailyArenaExited" ]
    },
    "DailyArenaExited": {
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Action.Succeeded": "「竞技场」任务结束"
        },
        "recognition": {
            "type": "And",
            "param": { "all_of": [ "LoginScreenClear" ] }
        }
    },
    "DailyArenaHoverStartBattle": {
        "post_delay": 0,
        "rate_limit": 200,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 414, 550, 120, 47 ],
                "expected": "段位",
                "replace": [ [ "/", "" ] ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 520, 576 ],
                "end": [ 520, 576 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "next": [ "DailyArenaStartBattle" ]
    },
    // 靠右悬浮和点击，左侧高亮模板避开随鼠标位置变化的说明框。
    "DailyArenaStartBattle": {
        "rate_limit": 200,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/RankedBattleStartHover.png",
                "roi": [ 428, 535, 53, 44 ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 516, 572, 9, 9 ]
            }
        },
        "timeout": 120000,
        "max_hit": 100,
        "anchor": {
            "CommonBattleSkipSpeed": "CommonBattleFinishSetup",
            "CommonBattleContinue": "WaitBattleEnd",
            "CommonBattleOutcome": "WaitBattleEnd",
            "CommonBattleInterrupt": "CommonBattleNoInterrupt"
        },
        "next": [ "[Anchor]CommonBattleOutcome", "CommonBattleAutoOn", "CommonBattleAutoOff" ]
    },
    "DailyArenaClickBattleEndHover": {
        "rate_limit": 200,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 682, 446, 14, 10 ],
                "method": 4,
                "lower": [ 0, 185, 210 ],
                "upper": [ 175, 255, 255 ],
                "count": 60
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 658, 445, 24, 8 ]
            }
        },
        "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "DailyArenaResultPopup", "DailyArenaMain" ]
    },
    // 结算确定后移开鼠标，等待主界面 1 秒；超时进入 on_error，重新 OCR 确定仍在才补点。
    "DailyArenaResultPopup": {
        "rate_limit": 200,
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 620, 460, 190, 55 ],
                "expected": "确[定认]"
            }
        },
        "action": "Click",
        "timeout": 1000,
        "max_hit": 20,
        "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "DailyArenaMain" ],
        "on_error": [ "DailyArenaResultPopup" ]
    }
}
