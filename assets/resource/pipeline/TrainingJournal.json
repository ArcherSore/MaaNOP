// 修行录领取：只领「任务」页签里亮着的「领取」，不碰「奖励」页签。
// 循环的终点是认出来的状态：任务页签上没有亮着的「领取」，隔 1 秒再确认一次；不是靠次数或 on_error。
{
    "TrainingJournal": {
        "focus": {
            "Node.PipelineNode.Failed": "修行录领取失败：主界面右侧找不到忍者修行录"
        },
        "timeout": 5000,
        "next": [ "JournalOpened", "JournalOpenPanel" ]
    },
    "JournalOpenPanel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "trainingJournal/PanelTitle.png",
                "roi": [ 1195, 275, 140, 35 ],
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Click"
        },
        "focus": {
            "Node.PipelineNode.Failed": "修行录领取失败：修行录界面没有打开"
        },
        "timeout": 10000,
        "next": [ "JournalOpened" ]
    },
    // 窗口里「本周经验上限」标签只在修行录窗口出现
    "JournalOpened": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "trainingJournal/WindowLabel.png",
                "roi": [ 340, 215, 90, 32 ],
                "threshold": 0.85
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "修行录领取失败：修行录界面状态异常"
        },
        "timeout": 8000,
        "next": [ "JournalTaskTabSelected", "JournalClickTaskTab" ]
    },
    "JournalClickTaskTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "trainingJournal/TaskTabUnselected.png",
                "roi": [ 845, 183, 60, 35 ],
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Click"
        },
        "focus": {
            "Node.PipelineNode.Failed": "修行录领取失败：修行录界面状态异常"
        },
        "timeout": 5000,
        "next": [ "JournalTaskTabSelected" ]
    },
    "JournalTaskTabSelected": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "trainingJournal/TaskTabSelected.png",
                "roi": [ 840, 178, 70, 38 ],
                "threshold": 0.9
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "修行录领取失败：修行录界面状态异常"
        },
        "timeout": 15000,
        "next": [ "JournalClaim", "JournalNoClaim" ]
    },
    // 亮着的「领取」是橙色（鼠标悬停时变亮；领完一条后下一条会顶到鼠标下面，所以悬停的外观必须认）。
    // 先用模板（普通 / 悬停两张）找到按钮，再数按钮里的橙色像素：橙色约 280 个，灰色 0 个，底色最多 27 个
    "JournalClaimButton": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "button",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": [ "trainingJournal/ClaimButton.png", "trainingJournal/ClaimButtonHover.png" ],
                                "roi": [ 825, 250, 95, 240 ],
                                "threshold": 0.7
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "button",
                                "roi_offset": [ 4, 3, -8, -6 ],
                                "method": 40,
                                "lower": [ 3, 190, 150 ],
                                "upper": [ 30, 255, 255 ],
                                "count": 150
                            }
                        }
                    }
                ]
            }
        }
    },
    // 领完一条后，同一条任务会换成下一档（排在「进行中」之后），亮着的「领取」始终排在最前
    "JournalClaim": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "JournalTaskTabSelected", "JournalClaimButton" ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        },
        "focus": {
            "Node.Action.Succeeded": "领取修行录任务奖励",
            "Node.PipelineNode.Failed": "修行录领取失败：修行录界面状态异常"
        },
        // 领完一条后原位会换成下一档任务（可能马上又是亮着的），没有「点中的按钮变灰」这种能逐次核对的状态，
        // 所以不逐次验证，让「还有没有亮着的领取」这个状态自己驱动循环：点歪了就还是亮着，下一轮再点。
        // max_hit 只是保险（每周经验上限 6500，每条 150~200）
        "max_hit": 80,
        "post_delay": 1500, // 领取动画和飘字约 1.5 秒，期间画面一直在变，等不到静止
        "next": [ "JournalClaim", "JournalNoClaim" ]
    },
    // 任务页签上没有亮着的「领取」；隔 1 秒再确认一次才算领完
    "JournalNoClaim": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "JournalClaimButton" ]
            }
        },
        "inverse": true,
        "post_delay": 1000,
        "focus": {
            "Node.PipelineNode.Failed": "修行录领取失败：修行录界面状态异常"
        },
        "next": [ "JournalClaim", "JournalNoClaimConfirmed" ]
    },
    "JournalNoClaimConfirmed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "JournalClaimButton" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "没有更多可领取的修行录任务奖励"
        },
        "next": [ "JournalClose" ]
    },
    "JournalClose": {
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "修行录领取失败：修行录界面关不上"
        },
        "timeout": 5000,
        "next": [ "JournalClosed" ]
    },
    "JournalClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "JournalOpened" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "修行录领取结束"
        }
    }
}
