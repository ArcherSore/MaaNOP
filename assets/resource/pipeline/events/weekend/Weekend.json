// 周末活动：从限时热点逐项进入，确认回到主界面后结束当前步骤。
{
    "WeekendActivities": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "WeekendStepPuzzle" ]
    },
    // WeekendActivity 为活动行，WeekendActivityAbsent 为该活动缺席的同帧识别，WeekendNext 为收尾后进入的步骤。
    "WeekendStepPuzzle": {
        "pre_delay": 0,
        "post_delay": 0,
        "anchor": {
            "WeekendActivity": "PuzzleRow",
            "WeekendActivityAbsent": "PuzzleAbsent",
            "WeekendNext": "WeekendFinished"
        },
        "next": [ "WeekendHub" ]
    },
    "WeekendFinished": {
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Action.Succeeded": "周末活动全部处理完"
        }
    },
    "WeekendHub": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EnterHotspotActivity",
                "custom_action_param": {
                    "expected": [ "周末活动" ]
                }
            }
        },
        "timeout": 10000,
        "next": [ "WeekendHubPage", "WeekendTabMissing" ]
    },
    "WeekendHubPage": {
        "pre_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "events/weekend/HubTitle.png",
                "roi": [ 640, 193, 180, 60 ]
            }
        },
        "timeout": 6000,
        "next": [ "[Anchor]WeekendActivity", "[Anchor]WeekendActivityAbsent" ]
    },
    "WeekendActivityListReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "WeekendHubPage",
                    {
                        "type": "OCR",
                        "param": { "roi": [ 835, 284, 85, 26 ], "expected": [ "奖励次数" ] }
                    },
                    {
                        "type": "OCR",
                        "param": { "roi": [ 835, 360, 85, 26 ], "expected": [ "奖励次数" ] }
                    },
                    {
                        "type": "OCR",
                        "param": { "roi": [ 835, 436, 85, 26 ], "expected": [ "奖励次数" ] }
                    }
                ]
            }
        }
    },

    // 拼图可能连同热点一起关闭；两条路径均须确认无遮挡主界面。
    "WeekendActivityDone": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "CloseWeekendWindow", "WeekendWindowClosed" ]
    },
    // 充值页和周末福利页的关闭叉位置不同，ROI 兼容两者，点击框向内缩。
    "CloseWeekendWindow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/hotspot/CloseX.png",
                "roi": [ 900, 195, 65, 48 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [ 4, 4, -8, -8 ]
            }
        },
        "post_delay": 0,
        "next": [ "WeekendWindowClosed" ]
    },
    // 复用亮度敏感的体力标识，排除窗口遮罩。
    "WeekendWindowClosed": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "LoginMapVisible" ]
            }
        },
        "next": [ "[Anchor]WeekendNext" ]
    },
    // EnterHotspotActivity 确认缺席并关窗回到主界面后命中此节点。
    "WeekendTabMissing": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "LoginMapVisible" ]
            }
        },
        "focus": {
            "Node.Action.Succeeded": "限时热点里没有「周末活动」"
        },
        "next": [ "WeekendFinished" ]
    }
}
