// 福利大厅：先领取当前可领的在线礼包（不等待倒计时），再处理每日福利中的月卡。
{
    "OnlineReward": {
        "focus": {
            "Node.PipelineNode.Failed": "主界面找不到「福利大厅」"
        },
        "timeout": 5000,
        "next": [ "OnlineHallOpened", "OnlineOpenHall" ]
    },
    "OnlineOpenHall": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": [ "common/entry/SystemGift.png" ]
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 10000,
        "next": [ "OnlineHallOpened" ]
    },
    "OnlineHallTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "onlineReward/HallTitle.png",
                "roi": [ 810, 174, 110, 90 ],
                "threshold": 0.9
            }
        }
    },
    "OnlineHallOpened": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "OnlineHallTitle" ]
            }
        },
        "timeout": 8000,
        "next": [ "OnlineTabSelected", "OnlineClickTab" ]
    },
    "OnlineClickTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "onlineReward/TabUnselected.png",
                "roi": [ 400, 252, 80, 35 ],
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 5000,
        "next": [ "OnlineTabSelected" ]
    },
    "OnlineTabSelected": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "onlineReward/TabSelected.png",
                "roi": [ 375, 252, 100, 35 ],
                "threshold": 0.9
            }
        },
        "timeout": 15000,
        "next": [ "OnlineGiftReady" ]
    },
    // 可领取按钮悬停时变亮，需兼容两种外观。
    // 橙色像素实测：可领取约 290，倒计时/已领取为 0。
    "OnlineClaimButton": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "button",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": [ "onlineReward/ClaimButton.png", "onlineReward/ClaimButtonHover.png" ],
                                "roi": [ 490, 479, 420, 50 ],
                                "threshold": 0.7
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "button",
                                "roi_offset": [ 4, 3, -8, -6 ],
                                "method": 40,
                                "lower": [ 3, 190, 150 ],
                                "upper": [ 30, 255, 255 ],
                                "count": 150
                            }
                        }
                    }
                ]
            }
        }
    },
    "OnlineClaim": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "OnlineClaimButton" ]
            }
        },
        "action": {
            "type": "Click"
        },
        "focus": {
            "Node.Action.Succeeded": "领取在线礼包"
        },
        "max_hit": 6, // 共 3 个礼包，max_hit 为安全上限。
        "timeout": 4000,
        "next": [ "OnlineClaimTaken" ]
    },
    // 核对 OnlineClaim 上次命中的按钮位置，避免用其他礼包按钮判断领取结果。
    "OnlineClaimTaken": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "OnlineClaim",
                "roi_offset": [ 4, 3, -8, -6 ],
                "method": 40,
                "lower": [ 3, 190, 150 ],
                "upper": [ 30, 255, 255 ],
                "count": 150
            }
        },
        "inverse": true,
        "next": [ "OnlineClaim", "OnlineNoClaim" ]
    },
    // 页面空白过渡期也没有橙色按钮，需先确认礼包页已绘制。
    "OnlineGiftReady": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "onlineReward/GiftPanel.png",
                "roi": [ 530, 254, 120, 70 ],
                "threshold": 0.9
            }
        },
        "next": [ "OnlineClaim", "OnlineNoClaim" ]
    },
    "OnlineNoClaim": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "OnlineClaimButton" ]
            }
        },
        "inverse": true,
        "post_delay": 1000,
        "next": [ "OnlineClaim", "OnlineNoClaimConfirmed" ]
    },
    "OnlineNoClaimConfirmed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "OnlineClaimButton" ]
            }
        },
        "inverse": true,
        "next": [ "MonthlyReward" ]
    },
    "OnlineClose": {
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27
            }
        },
        "timeout": 5000,
        "next": [ "OnlineHallClosed" ]
    },
    "OnlineHallClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "OnlineHallTitle" ]
            }
        },
        "inverse": true
    }
}
