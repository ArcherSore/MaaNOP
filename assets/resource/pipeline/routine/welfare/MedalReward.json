{
    // 沿用每日福利页面，先每日后每周，不切换勋章档位。
    // 复用 f128e2e 的勋章节点；独立于月卡激活状态，只有本项未激活才跳过。
    "MedalReward": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "next": [ "MedalLocked", "MedalDailyOrange", "MedalDailyGray" ]
    },
    // 激活按钮也是橙色，先核对文字；同 next 其余节点只判颜色，避免 OCR 重叠。
    "MedalLocked": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    { "recognition": { "type": "OCR", "param": { "roi": [ 807, 402, 60, 19 ], "only_rec": true, "expected": [ "^激活勋章$" ] } } },
                    { "recognition": { "type": "OCR", "param": { "roi": [ 807, 503, 60, 19 ], "only_rec": true, "expected": [ "^激活勋章$" ] } } },
                    "MedalDailyOrange",
                    "MedalWeeklyOrange"
                ]
            }
        },
        "next": [ "OnlineClose" ]
    },
    // 橙色像素 187~385（灰钮 0），灰色 572~614（橙钮最多 279）。
    "MedalDailyOrange": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": { "roi": [ 811, 405, 49, 13 ], "method": 40, "lower": [ 3, 190, 150 ], "upper": [ 30, 255, 255 ], "count": 150 }
        },
        "timeout": 4000,
        "next": [ "MedalDailyClaim" ]
    },
    "MedalDailyGray": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": { "roi": [ 811, 405, 49, 13 ], "method": 40, "lower": [ 0, 0, 40 ], "upper": [ 179, 55, 220 ], "count": 450 }
        },
        "timeout": 4000,
        "next": [ "MedalDailyTaken" ]
    },
    "MedalDailyClaim": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "MedalDailyOrange",
                    { "recognition": { "type": "OCR", "param": { "roi": [ 807, 402, 60, 19 ], "only_rec": true, "expected": [ "^领取$" ] } } }
                ]
            }
        },
        "action": { "type": "Click", "param": { "target": [ 818, 406, 36, 10 ] } },
        "max_hit": 1,
        "timeout": 4000,
        "next": [ "MedalDailyTaken" ]
    },
    "MedalDailyTaken": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "MedalDailyGray",
                    { "recognition": { "type": "OCR", "param": { "roi": [ 807, 402, 60, 19 ], "only_rec": true, "expected": [ "^已领取$" ] } } }
                ]
            }
        },
        "timeout": 5000,
        "next": [ "MedalWeeklyOrange", "MedalWeeklyGray" ]
    },
    "MedalWeeklyOrange": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": { "roi": [ 811, 506, 49, 13 ], "method": 40, "lower": [ 3, 190, 150 ], "upper": [ 30, 255, 255 ], "count": 150 }
        },
        "timeout": 4000,
        "next": [ "MedalWeeklyClaim" ]
    },
    "MedalWeeklyGray": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": { "roi": [ 811, 506, 49, 13 ], "method": 40, "lower": [ 0, 0, 40 ], "upper": [ 179, 55, 220 ], "count": 450 }
        },
        "timeout": 4000,
        "next": [ "MedalWeeklyDone" ]
    },
    // 灰色领取仅在领取前可跳过；点击后必须确认已领取。
    "MedalWeeklyDone": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "MedalWeeklyGray",
                    { "recognition": { "type": "OCR", "param": { "roi": [ 807, 503, 60, 19 ], "only_rec": true, "expected": [ "^(领取|已领取)$" ] } } }
                ]
            }
        },
        "next": [ "OnlineClose" ]
    },
    "MedalWeeklyClaim": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "MedalWeeklyOrange",
                    { "recognition": { "type": "OCR", "param": { "roi": [ 807, 503, 60, 19 ], "only_rec": true, "expected": [ "^领取$" ] } } }
                ]
            }
        },
        "action": { "type": "Click", "param": { "target": [ 818, 507, 36, 10 ] } },
        "max_hit": 1,
        "timeout": 4000,
        "next": [ "MedalWeeklyTaken" ]
    },
    "MedalWeeklyTaken": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "MedalWeeklyGray",
                    { "recognition": { "type": "OCR", "param": { "roi": [ 807, 503, 60, 19 ], "only_rec": true, "expected": [ "^已领取$" ] } } }
                ]
            }
        },
        "next": [ "OnlineClose" ]
    }
}
