                "roi": [ 627, 191, 86, 29 ],
                "method": 10001,
                "threshold": 0.8
            }
        },
        "timeout": 5000,
        "next": [ "EscortNoFreeSS", "EscortCheckFreeSS" ]
    },
    "EscortNoFreeSS": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 817, 239, 112, 19 ],
                "expected": "^免费接取SS级任务次数[：:]?0[/／]?[1-9][0-9]*$",
                "only_rec": true,
                "threshold": 0.8
            }
        },
        "next": [ "EscortCloseList" ]
    },
    // 次数 OCR 分两阶段识别，避免同一 next 的重叠 ROI 触发批处理损坏。
    "EscortCheckFreeSS": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "next": [ "EscortHasFreeSS" ]
    },
    "EscortHasFreeSS": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 817, 239, 112, 19 ],
                "expected": "^免费接取SS级任务次数[：:]?[1-9][0-9]*[/／]?[1-9][0-9]*$",
                "only_rec": true,
                "threshold": 0.8
            }
        },
        "timeout": 5000,
        "next": [ "EscortHoverAcceptSSButton", "EscortHoverFreeRefreshButton", "EscortNoRefresh" ]
    },
    "EscortHoverAcceptSSButton": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [ "EscortSSRow1", "EscortSSRow2", "EscortSSRow3" ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "duration": 100,
                "only_hover": true
            }
        },
        "post_delay": 0,
        "timeout": 5000,
        "next": [ "EscortClickAcceptSSButton" ]
    },
    "EscortClickAcceptSSButton": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "EscortHoverAcceptSSButton",
                "roi_offset": [ -10, 1, 20, -7 ],
                "method": 40,
                "lower": [ 83, 60, 205 ],
                "upper": [ 106, 255, 255 ],
                "count": 55
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": "EscortHoverAcceptSSButton"
            }
        },
        "post_delay": 0,
        "rate_limit": 200,
        "timeout": 10000,
        "next": [ "EscortOutsideHours", "EscortHoverDepartButton" ]
    },
    "EscortOutsideHours": {
