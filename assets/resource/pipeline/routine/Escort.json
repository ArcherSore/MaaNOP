        "action": {
            "type": "Click",
            "param": {
                "target": [ 868, 523, 15, 7 ]
            }
        },
        "timeout": 45000,
        "next": [ "EscortList" ]
    },
    "EscortList": {
        "pre_delay": 0,
        "post_delay": 0,
