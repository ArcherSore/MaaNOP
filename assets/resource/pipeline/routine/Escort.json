{
    "Escort": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 10000,
        "next": [ "EscortOpenOrganization" ]
    },
    "EscortOpenOrganization": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "OrganizationEntry" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [ 3, 2, -6, -4 ]
            }
        },
        "timeout": 10000,
        "next": [ "EscortHoverGoButton" ]
    },
    "EscortHoverGoButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 670, 505, 80, 32 ],
                "expected": "^押镖"
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 875, 526 ],
                "end": [ 875, 526 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "post_delay": 0,
        "timeout": 5000,
        "next": [ "EscortClickGoButton" ]
    },
    "EscortClickGoButton": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 864, 519, 24, 5 ],
                "method": 40,
                "lower": [ 83, 60, 205 ],
                "upper": [ 106, 255, 255 ],
                "count": 60
