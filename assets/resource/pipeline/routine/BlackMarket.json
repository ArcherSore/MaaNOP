    "BlackMarketDragList": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 141, 200, 6, 30 ],
                "method": 40,
                "lower": [ 95, 150, 150 ],
                "upper": [ 120, 255, 255 ],
                "count": 80
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 143, 215 ],
                "end": [ 143, 255 ],
                "duration": 600
            }
        },
        "post_delay": 0,
        "post_wait_freezes": {
            "time": 300,
            "target": [ 5, 165, 135, 110 ],
            "timeout": 3000
        },
        "next": [ "BlackMarketClickEntry" ]
    },
    "BlackMarketShopReady": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/black_market/ShopTitle.png",
                "roi": [ 600, 170, 150, 45 ]
            }
        },
        "post_delay": 0,
        "next": [ "BlackMarketShopSoldOut", "BlackMarketTargetItem", "BlackMarketWrongItem" ]
    },
    "BlackMarketBuyPresent": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 540, 353, 62, 20 ],
                "method": 40,
                "lower": [ 5, 150, 200 ],
                "upper": [ 20, 255, 255 ],
                "count": 150
            }
        }
    },
    "BlackMarketShopSoldOut": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/black_market/SoldOutSign.png",
                "roi": [ 545, 320, 80, 65 ]
            }
        },
        "post_delay": 0,
        "next": [ "BlackMarketHoverClose" ]
    },
    "BlackMarketTargetItem": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BlackMarketBuyPresent",
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 450, 274, 125, 26 ],
                                "expected": "^体力药水(?:[（(]小[）)])?$",
                                "threshold": 0.8
                            }
                        }
                    }
                ]
            }
        },
        "anchor": {
            "BlackMarketPasswordRoute": "CommonSecondaryPasswordDialog",
            "SecondaryPasswordAcceptedNext": "BlackMarketRetryAfterPassword",
            "SecondaryPasswordDismissedNext": "BlackMarketHoverClose"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BlackMarketSetPurchaseMessage"
            }
        },
        "post_delay": 0,
        "next": [ "BlackMarketHoverBuy" ]
    },
    "BlackMarketWrongItem": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BlackMarketBuyPresent" ]
            }
        },
        "post_delay": 0,
        "next": [ "BlackMarketHoverClose" ]
    },
    "BlackMarketHoverBuy": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BlackMarketBuyPresent" ]
