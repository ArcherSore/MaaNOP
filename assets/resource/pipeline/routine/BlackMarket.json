{
    "BlackMarket": {
        "next": [ "ReturnToVillage" ]
    },
    "BlackMarketFindEntry": {
        "post_delay": 0,
        "next": [ "BlackMarketClickEntry", "BlackMarketDragList" ]
    },
    "BlackMarketClickEntry": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 8, 246, 109, 16 ],
                                "expected": "^黑市.人",
                                "only_rec": true,
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 8, 230, 109, 16 ],
                                "expected": "^黑市.人",
                                "only_rec": true,
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 8, 214, 109, 16 ],
                                "expected": "^黑市.人",
                                "only_rec": true,
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 8, 198, 109, 16 ],
                                "expected": "^黑市.人",
                                "only_rec": true,
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 8, 182, 109, 16 ],
                                "expected": "^黑市.人",
                                "only_rec": true,
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 8, 166, 109, 16 ],
                                "expected": "^黑市.人",
                                "only_rec": true,
                                "threshold": 0.8
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true,
                "target_offset": [ 12, 6, -79, -12 ]
            }
        },
        "post_delay": 0,
        "on_error": [ "BlackMarketFindEntry" ],
        "next": [ "BlackMarketShopReady" ]
    },
    "BlackMarketDragList": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 141, 200, 6, 30 ],
                "method": 40,
                "lower": [ 95, 150, 150 ],
                "upper": [ 120, 255, 255 ],
                "count": 80
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 143, 215 ],
                "end": [ 143, 255 ],
                "duration": 600
            }
        },
        "post_delay": 0,
        "post_wait_freezes": {
            "time": 300,
            "target": [ 5, 165, 135, 110 ],
            "timeout": 3000
        },
        "next": [ "BlackMarketClickEntry" ]
    },
    "BlackMarketShopReady": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/black_market/ShopTitle.png",
                "roi": [ 600, 170, 150, 45 ]
            }
        },
        "post_delay": 0,
        "next": [ "BlackMarketShopSoldOut", "BlackMarketTargetItem", "BlackMarketWrongItem" ]
    },
    "BlackMarketBuyPresent": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 540, 353, 62, 20 ],
                "method": 40,
                "lower": [ 5, 150, 200 ],
                "upper": [ 20, 255, 255 ],
                "count": 150
            }
        }
    },
    "BlackMarketShopSoldOut": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/popup/MerchantSoldOut.png",
                "roi": [ 545, 320, 80, 65 ]
            }
        },
        "post_delay": 0,
        "next": [ "CommonMerchantHoverClose" ]
    },
    "BlackMarketTargetItem": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BlackMarketBuyPresent",
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 450, 274, 125, 26 ],
                                "expected": "^体力药水(?:[（(]小[）)])?$",
                                "threshold": 0.8
                            }
                        }
                    }
                ]
            }
        },
        "anchor": {
            "CommonMerchantAfterBuy": "CommonMerchantWaitBuyDialog",
            "CommonMerchantConfirmNext": "BlackMarketPurchaseSucceeded",
            "SecondaryPasswordAcceptedNext": "BlackMarketRetryAfterPassword",
            "SecondaryPasswordDismissedNext": "CommonMerchantHoverClose"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BlackMarketSetPurchaseMessage"
            }
        },
        "post_delay": 0,
        "next": [ "BlackMarketHoverBuy" ]
    },
    "BlackMarketWrongItem": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BlackMarketBuyPresent" ]
            }
        },
        "post_delay": 0,
        "next": [ "CommonMerchantHoverClose" ]
    },
    "BlackMarketHoverBuy": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BlackMarketBuyPresent" ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "only_hover": true,
                "duration": 100,
                "begin": [ 570, 363 ],
                "end": [ 570, 363 ]
            }
        },
        "post_delay": 0,
        "next": [ "BlackMarketClickBuy" ]
    },
    "BlackMarketClickBuy": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 540, 353, 62, 20 ],
                "method": 40,
                "lower": [ 7, 100, 240 ],
                "upper": [ 36, 255, 255 ],
                "count": 100
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 556, 359, 28, 8 ]
            }
        },
        "post_delay": 0,
        "next": [ "[Anchor]CommonMerchantAfterBuy" ]
    },
    "BlackMarketRetryAfterPassword": {
        "anchor": {
            "CommonMerchantAfterBuy": "CommonMerchantPurchaseDialog"
        },
        "post_delay": 0,
        "next": [ "BlackMarketHoverBuy" ]
    },
    "BlackMarketPurchaseSucceeded": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BlackMarketShopSoldOut" ]
            }
        },
        "post_delay": 0,
        "next": [ "CommonMerchantHoverClose" ]
    }
}
