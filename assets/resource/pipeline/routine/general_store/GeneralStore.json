        "action": {
            "type": "Click",
            "param": {
                "target": [ 1017, 104, 12, 14 ]
            }
        },
        "post_delay": 0,
        "timeout": 8000,
        "next": [ "GeneralStoreSignInReady" ]
    },
    "GeneralStoreSignInCurrency": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "routine/general_store/SignInCurrency.png",
                                "roi": [ 436, 185, 28, 467 ],
                                "method": 10001,
                                "threshold": 0.95
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "routine/general_store/SignInCurrency.png",
                                "roi": [ 715, 185, 28, 467 ],
                                "method": 10001,
                                "threshold": 0.95
                            }
                        }
                    }
                ]
            }
        }
    },
