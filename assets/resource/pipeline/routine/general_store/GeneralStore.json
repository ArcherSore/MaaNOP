            "param": {
                "custom_action": "GeneralStoreBuyItems"
            }
        },
        "attach": {
            "scroll_top": 206,
            "scroll_step": 83,
            "track_bottom": 645,
            "layout": {
                "stock": [ 44, 21, 64, 15 ],
                "quantity": [ -1, 49, 24, 16 ],
                "buy": [ 49, 49, 48, 19 ]
            },
            "products": {
                "TrainingPotion": {
                    "page": 1,
                    "label": "^修行药水$",
                    "icon_roi": [ 663, 178, 60, 460 ],
                    "label_roi": [ 686, 243, 70, 180 ]
                },
                "SecretScrollPage": {
                    "page": 1,
                    "label": "^秘卷残页$",
                    "icon_roi": [ 803, 178, 60, 460 ],
                    "label_roi": [ 826, 243, 70, 180 ]
                },
                "MantraCompound": {
                    "page": 1,
                    "label": "^[真直]言合剂$",
                    "icon_roi": [ 384, 178, 60, 460 ],
                    "label_roi": [ 406, 366, 70, 180 ]
                },
                "TrainingVoucher": {
                    "page": 1,
                    "label": "^(?:修[炼练]?|燃炼)券$",
                    "icon_roi": [ 803, 178, 60, 460 ],
                    "label_roi": [ 826, 489, 70, 180 ]
                },
                "AdvancedRefinementRune": {
                    "shop": "SignIn",
                    "page": 0,
                    "label": "^高级精炼符$",
                    "icon_roi": [ 384, 183, 60, 74 ],
                    "label_roi": [ 404, 274, 76, 45 ]
                }
            }
        }
    },
    "GeneralStoreOpen": {
        "post_delay": 0,
        "timeout": 8000,
        "next": [ "GeneralStoreClickEntry" ]
    },
    "GeneralStoreClickEntry": {
        "pre_delay": 0,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindHoveredBottomEntry",
                "custom_recognition_param": {
                    "normal_template": "routine/general_store/Entry.png",
                    "hover_template": "routine/general_store/EntryHover.png"
                }
            }
        },
        "action": "Click",
        "post_delay": 0,
        "timeout": 8000,
        "next": [ "GeneralStoreHoverMoonTab" ]
    },
    "GeneralStoreDayTabSelected": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/general_store/DayTabSelected.png",
                "roi": [ 884, 90, 46, 43 ],
                "method": 10001,
                "threshold": 0.85
            }
        }
    },
    "GeneralStoreMoonTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/general_store/MoonTab.png",
                "roi": [ 944, 90, 38, 42 ],
                "method": 10001,
                "threshold": 0.85
            }
        }
    },
    "GeneralStoreMoonTabHover": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/general_store/MoonTabHover.png",
                "roi": [ 944, 90, 38, 42 ],
                "method": 10001,
                "threshold": 0.85
            }
        }
    },
    "GeneralStoreMoonTabSelected": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/general_store/MoonTabSelected.png",
                "roi": [ 944, 90, 38, 42 ],
                "method": 10001,
                "threshold": 0.85
            }
        }
    },
    "GeneralStoreMoonTabAvailable": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [ "GeneralStoreMoonTab", "GeneralStoreMoonTabHover" ]
            }
        }
    },
    "GeneralStoreHoverMoonTab": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "GeneralStoreDayTabSelected", "GeneralStoreMoonTabAvailable" ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "only_hover": true,
                "duration": 100,
                "begin": [ 965, 110 ],
                "end": [ 965, 110 ]
            }
        },
        "post_delay": 0,
        "timeout": 5000,
        "next": [ "GeneralStoreSelectMoonTab" ]
    },
    "GeneralStoreSelectMoonTab": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "GeneralStoreDayTabSelected", "GeneralStoreMoonTabHover" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 959, 103, 12, 14 ]
            }
        },
        "post_delay": 0,
        "timeout": 8000,
        "next": [ "GeneralStoreMoonReady" ]
    },
    "GeneralStoreThumb": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 951, 202, 4, 444 ],
                "method": 6,
                "lower": [ 180 ],
                "upper": [ 255 ],
                "count": 250,
                "connected": true
            }
        }
    },
    "GeneralStoreMoonCurrency": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/general_store/MoonCurrency.png",
                "roi": [ 437, 192, 28, 449 ],
                "method": 10001,
                "threshold": 0.93
            }
        }
    },
    "GeneralStoreMoonReady": {
        "recognition": {
            "type": "And",
            "param": {
                // 页签先变色，货架稍后换成月之印商品。
                "all_of": [ "GeneralStoreMoonTabSelected", "GeneralStoreMoonCurrency" ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0
    },
    "GeneralStoreSwitchSignIn": {
        "post_delay": 0,
        "timeout": 8000,
        "next": [ "GeneralStoreHoverSignInTab" ]
    },
