        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 599, 385, 23, 11 ]
            }
        },
        "max_hit": 1,
        "post_delay": 0,
        "timeout": 10000,
        "next": [ "GeneralStoreFundsInsufficient", "GeneralStorePurchaseVerified" ]
