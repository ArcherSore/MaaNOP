        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 719, 218, 64, 15 ],
                "expected": "^库存[1-9][0-9]*$",
                "only_rec": true,
                "threshold": 0.8
            }
        }
    },
    "GeneralStoreCheckout": {
        "anchor": {
            "GeneralStorePasswordRoute": "CommonSecondaryPasswordDialog",
