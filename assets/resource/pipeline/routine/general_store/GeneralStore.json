                "threshold": 0.65
            }
        }
    },
    "GeneralStoreSoldOutSign": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/general_store/SoldOutSign.png",
                "roi": "GeneralStoreProductLabel",
                "roi_offset": [ -33, -93, 70, 48 ],
                "method": 10001,
                "threshold": 0.94
            }
        }
    },
    "GeneralStorePurchaseVerified": {
        "recognition": {
            "type": "And",
            "param": {
                // 商品图标会消失，名称仍留在原货位。只检查该名称上方的售罄牌。
                "all_of": [ "GeneralStoreActiveShop", "GeneralStoreProductLabel", "GeneralStoreSoldOutSign" ]
            }
        },
        "post_delay": 0
    },
