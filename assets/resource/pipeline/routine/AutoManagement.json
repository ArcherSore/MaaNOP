// 当天首次托管消耗 1 张托管卡；沿用用户设置，不支持「空闲时自动停靠在温泉」。
// 托管会循环执行而不自行停止。
// 扫荡、切图、弹窗和好友浇水期间可能无新日志，必须排除这些忙碌状态。
// 首轮完成以排除忙碌状态后日志连续 10 秒不变判定；后续轮次补做及长期等待项目留给下次运行。
{
    "AutoManagement": {
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：主界面左上角找不到托管入口"
        },
        // 「激活上忍勋章返还点券」会遮住入口模板，但会自行消失。
        "timeout": 15000,
        "next": [ "AutoManageRunning", "AutoManageConfirm", "AutoManageStartReady", "AutoManageWindowRunning", "AutoManageOpenWindow" ]
    },
    // 入口仅截按钮内部以避开玩家名字；悬停时图标变亮，需兼容两种外观。
    "AutoManageEntryIcon": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "routine/auto_management/EntryIcon.png", "routine/auto_management/EntryIconHover.png" ],
                "roi": [ 294, 89, 52, 53 ],
                "threshold": 0.8
            }
        }
    },
    "AutoManageOpenWindow": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AutoManageEntryIcon" ]
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：托管系统窗口没有打开"
        },
        "post_delay": 1500, // 窗口先出空框，稍后才绘制内容，无中间状态。
        "timeout": 10000,
        "next": [ "AutoManageStartReady", "AutoManageWindowRunning", "AutoManageOpenAgain" ]
    },
    "AutoManageIconOnMap": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AutoManageMapClear", "AutoManageEntryIcon" ],
                "box_index": 1
            }
        }
    },
    // 窗口不在前台时首次点击可能只激活窗口，游戏不接收点击。
    // 托管中点击入口会直接结束托管，重试前必须在同一帧排除托管面板。
    "AutoManageOpenAgain": {
        "max_hit": 2,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "AutoManageIconOnMap",
                    "without": "AutoManagePanelShown"
                }
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：托管系统窗口没有打开"
        },
        "post_delay": 1500, // 同上
        "timeout": 10000,
        "next": [ "AutoManageStartReady", "AutoManageWindowRunning", "AutoManageOpenAgain" ]
    },
    // 「当前拥有托管卡」在三个页签均可见。
    "AutoManageWindowLabel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/auto_management/WindowLabel.png",
                "roi": [ 823, 178, 104, 51 ],
                "threshold": 0.9
            }
        }
    },
    // 悬停会提亮并降低饱和度，需兼容两种外观。
    "AutoManageStartReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoManageWindowLabel",
                    {
                        "sub_name": "start",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": [ "routine/auto_management/StartButton.png", "routine/auto_management/StartButtonHover.png" ],
                                "roi": [ 548, 545, 90, 52 ],
                                "threshold": 0.7
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "start",
                                "method": 40,
                                "lower": [ 3, 120, 150 ],
                                "upper": [ 30, 255, 255 ],
                                "count": 100
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：点了开始托管，但没有进入托管"
        },
        "timeout": 10000,
        "next": [ "AutoManageConfirm", "AutoManageRunning" ]
    },
    // 当天首次托管会弹消耗 1 张托管卡的确认框。
    "AutoManageConfirm": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/auto_management/ConfirmText.png",
                "roi": [ 602, 332, 130, 55 ],
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 592, 410, 38, 10 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：确认后没有进入托管"
        },
        "timeout": 10000,
        "next": [ "AutoManageRunning" ]
    },
    // 托管中可由「查看日志」打开窗口；关闭后才露出左下托管面板。
    // 悬停时模板得分明显降低，所以退出按钮用颜色识别。
    "AutoManageWindowRunning": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoManageWindowLabel",
                    {
                        "sub_name": "exit",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": [ "routine/auto_management/WindowExitButton.png", "routine/auto_management/WindowExitButtonHover.png" ],
                                "roi": [ 706, 545, 84, 52 ],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "exit",
                                "roi_offset": [ -6, -2, 12, 4 ],
                                "method": 40,
                                "lower": [ 85, 100, 120 ],
                                "upper": [ 115, 255, 255 ],
                                "count": 150
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 974, 188, 10, 10 ]
            }
        },
        "timeout": 10000,
        "next": [ "AutoManageRunning" ]
    },
    // 「托管中」面板在切地图加载时不可见。
    "AutoManagePanelTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/auto_management/PanelTitle.png",
                "roi": [ 40, 413, 76, 54 ],
                "threshold": 0.85
            }
        }
    },
    // 忍者考试扫荡期间面板改为「正在扫荡」，结束后恢复。
    "AutoManageSweepPanel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/auto_management/SweepPanelTitle.png",
                "roi": [ 37, 401, 82, 54 ],
                "threshold": 0.85
            }
        }
    },
    "AutoManagePanelShown": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [ "AutoManagePanelTitle", "AutoManageSweepPanel" ]
            }
        }
    },
    "AutoManageRunning": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AutoManagePanelShown" ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "托管中，等这一轮做完后退出托管",
            "Node.PipelineNode.Failed": "托管失败：20 分钟内未能确认本轮完成，托管尚未退出，请手动检查"
        },
        "timeout": 1200000, // 安全超时，须覆盖忍者考试扫荡的全程。
        "next": [ "AutoManageIdle" ]
    },
    // 好友浇水不写日志，满成长提示会持续较久，需视为忙碌。
    // 模板仅截左半句以避开人物遮挡。
    "AutoManageWaterFullToast": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "routine/auto_management/WaterFullToast.png",
                "roi": [ 526, 309, 144, 60 ],
                "threshold": 0.7
            }
        }
    },
    // 退出无确认框，点击后面板很快消失。
    "AutoManageIdle": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "AutoManageLogQuiet",
                "custom_recognition_param": {
                    "require_nodes": [ "AutoManagePanelTitle", "AutoManageMapClear" ],
                    "busy_nodes": [ "AutoManageWaterFullToast" ],
                    "line_roi": [ 10, 446, 140, 34 ],
                    "quiet_seconds": 10
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 93, 489, 30, 8 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：点了退出托管，但托管面板还在"
        },
        "post_delay": 1500, // 面板很快消失，无中间状态；等待后再判断是否需要重试。
        "timeout": 10000,
        "next": [ "AutoManageExited", "AutoManageExitAgain" ]
    },
    // 窗口不在前台时退出点击可能只激活窗口。
    "AutoManageExitAgain": {
        "max_hit": 2,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AutoManageMapClear", "AutoManagePanelTitle" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 93, 489, 30, 8 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：点了退出托管，但托管面板还在"
        },
        "post_delay": 1500, // 同上
        "timeout": 10000,
        "next": [ "AutoManageExited", "AutoManageExitAgain" ]
    },
    "AutoManageMapClear": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/map/StaminaLabel.png",
                "roi": [ 32, 42, 66, 61 ],
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    // 退出必须在同一帧确认地图存在且面板消失；切图加载也会隐藏面板，分帧判断会误报退出。
    "AutoManageExited": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "AutoManageMapClear",
                    "without": "AutoManagePanelShown"
                }
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "托管已完成，已退出托管"
        }
    }
}
