// 一口气打到六道
{
    "ArenaRankGrind": {
        "next": [ "WaitArenaMain", "GotoArena" ]
    },
    "GotoArena": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EnterTopEntry",
                "custom_action_param": {
                    "template": "arena/ArenaEntry.png"
                }
            }
        },
        "next": [ "WaitArenaMain" ]
    },
    "WaitArenaMain": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/ArenaMainFlag.png",
                "roi": [ 217, 522, 79, 73 ]
            }
        },
        "next": [ "[JumpBack]CloseArenaPopup", "CheckRank", "RankNotReached" ]
    },
    "CheckRank": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/RankRikudouFlag.png",
                "roi": [ 231, 194, 91, 98 ]
            }
        },
        "next": [ "RankReached" ]
    },
    "RankNotReached": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/RankRikudouFlag.png",
                "roi": [ 231, 194, 91, 98 ]
            }
        },
        "inverse": true,
        "next": [ "StartFormalBattle" ]
    },
    "StartFormalBattle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/ButtonFormalBattleStart.png",
                "roi": [ 399, 556, 160, 83 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 90000,
        "next": [ "ArenaAutoOn", "ArenaAutoOff" ]
    },
    "ArenaAutoOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/AutoOn.png",
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "timeout": 120000,
        "next": [ "WaitBattleEnd" ],
        "on_error": [ "ArenaBattleTimeoutProbe" ]
    },
    "ArenaAutoOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/AutoOff.png",
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 120000,
        "next": [ "WaitBattleEnd" ],
        "on_error": [ "ArenaBattleTimeoutProbe" ]
    },
    "ArenaBattleTimeoutProbe": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/AutoOn.png",
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": "DoNothing",
        "next": [ "ArenaAutoOn" ],
        "on_error": [ "WaitBattleEnd" ]
    },
    "WaitBattleEnd": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/BattleEnd.png",
                "roi": [ 611, 438, 121, 69 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "[JumpBack]BattleResultPopup", "WaitArenaMain" ]
    },
    "BattleResultPopup": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchPopup",
                "custom_recognition_param": {
                    "popups": [
                        { "name": "战斗胜利", "template": "arena/BattleWinPopup.png", "roi": [ 555, 206, 201, 103 ], "target": [ 647, 506, 30, 13 ] },
                        { "name": "新增试用忍者", "template": "arena/AddNewTrialNinja.png", "roi": [ 548, 207, 233, 96 ], "target": [ 763, 498, 34, 9 ] },
                        { "name": "战斗失败", "template": "arena/BattleLosePopup.png", "roi": [ 561, 211, 209, 92 ], "target": [ 649, 493, 44, 13 ] },
                        { "name": "成为六道", "template": "arena/RankRikudouPopup.png", "roi": [ 557, 205, 206, 101 ], "target": [ 644, 488, 38, 13 ] }
                    ]
                }
            }
        },
        "action": "Click"
    },
    "CloseArenaPopup": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "arena/NewTermPopup.png",
                "roi": [ 575, 243, 183, 68 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 655, 507, 33, 14 ]
            }
        }
    },
    "RankReached": {
        "focus": {
            "Node.Action.Succeeded": "六道段位达成"
        }
    }
}
