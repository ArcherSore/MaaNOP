{
    "AccountLeveling": {
        "next": "SetLevelingTaskMode"
    },
    "AccountClaims": {
        "next": "SetClaimingTaskMode"
    },
    "ShoppingFestivalTask": {
        "next": "SetShoppingFestivalTaskMode"
    },
    "SetLevelingTaskMode": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetTaskMode",
                "custom_recognition_param": "leveling"
            }
        },
        "next": "SetServerRegion"
    },
    "SetClaimingTaskMode": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetTaskMode",
                "custom_recognition_param": "claiming"
            }
        },
        "next": "SetServerRegion"
    },
    "SetShoppingFestivalTaskMode": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetTaskMode",
                "custom_recognition_param": "shopping"
            }
        },
        "next": "SetServerRegion"
    },
    "SetServerRegion": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetServerRegion",
                "custom_recognition_param": "public"
            }
        },
        "next": "ParseServer"
    },
    "ParseServer": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ParseServerRange"
            }
        },
        "next": "Login"
    },
    "Login": {
        "next": [ "ReChooseServer", "RefreshPage" ]
    },
    "RefreshPage": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/Refresh.png",
                "roi": [ 796, 0, 131, 110 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "ReChooseServer"
    },
    "ReChooseServer": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/GameButton.png",
                "roi": [ 578, 495, 207, 98 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 665, 601, 33, 6 ] // 重新选区button
            }
        },
        "next": [ "ReChooseServer", "GetNextServer" ]
    },
    "GetNextServer": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "GetNextServer"
            }
        },
        "next": [ "AllServerCompleted", "DeterminePage" ]
    },
    "DeterminePage": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DetectServerPage"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "ScrollToTarget",
        "on_error": "LoginFailed"
    },
    "ScrollToTarget": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ScrollToTargetServer"
            }
        },
        "next": "ChooseServer",
        "on_error": "LoginFailed"
    },
    "ChooseServer": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "LocateServerButton"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "timeout": 60000,
        "next": [ "RouteLevelingAfterServerSelection", "LoginPopupAppears", "LoginScreenClear" ],
        "on_error": [ "RefreshStuckLoading", "LoginFailed" ]
    },
    "RefreshStuckLoading": {
        "max_hit": 1, // 每服最多刷新恢复一次，由 GetNextServer 重置
        "timeout": 60000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/Refresh.png",
                "roi": [ 796, 0, 131, 110 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "focus": {
            "Node.Action.Succeeded": "等待登录超时，刷新后重新选择本服（仅重试一次）"
        },
        "next": "ReopenServerList",
        "on_error": "LoginFailed"
    },
    "ReopenServerList": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/GameButton.png",
                "roi": [ 578, 495, 207, 98 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 665, 601, 33, 6 ] // 重新选区button
            }
        },
        "next": [ "ReopenServerList", "DeterminePage" ],
        "on_error": "LoginFailed"
    },
    "LoginFailed": {
        "focus": {
            "Node.Action.Starting": "登录或恢复失败，停止本次批量任务"
        },
        "action": { "type": "StopTask" }
    },
    "RouteLevelingAfterServerSelection": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IsLevelingTask"
            }
        },
        "next": "LevelingEntry"
    },
    "LoginPopupAppears": {
        // 加载中或被上层遮罩挡住时点击会丢失；下层弹窗变暗后仍能匹配，须按上层优先排序。
        "max_hit": 12, // 每服点击预算，由 GetNextServer 重置。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchPopup",
                "custom_recognition_param": {
                    "popups": [
                        { "name": "公告", "template": "popup/Announcement.png", "roi": [ 647, 309, 196, 89 ], "target": [ 962, 352, 13, 12 ] },
                        { "name": "回归", "template": "popup/Return.png", "roi": [ 671, 182, 260, 136 ], "target": [ 901, 233, 13, 12 ] },
                        { "name": "福利", "template": "popup/Welfare.png", "roi": [ 797, 186, 121, 86 ], "target": [ 961, 224, 13, 12 ] },
                        { "name": "组织", "template": "popup/Organization.png", "roi": [ 617, 557, 101, 66 ] }
                    ]
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 1000, // 弹窗点中后约 0.1 秒消失，等待后再识别，避免补点到地图。
        "action": { "type": "Click" },
        "next": [ "LoginPopupAppears", "LoginScreenClear" ],
        "on_error": "LoginPopupCloseFailed"
    },
    "LoginScreenClear": {
        // 10001 对亮度敏感，体力标签在遮罩下实测约 0.05，可用于确认地图无遮挡。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/StaminaLabel.png",
                "roi": [ 32, 84, 66, 61 ],
                "method": 10001,
                "threshold": 0.8
            }
        },
        "post_delay": 2000, // 相邻弹窗实测间隔约 0.5 秒，需留出 2 秒安静期。
        "next": [ "LoginPopupAppears", "LoginScreenStillClear" ],
        "on_error": "LoginPopupCloseFailed"
    },
    "LoginScreenStillClear": {
        "recognition": {
            "type": "And",
            "param": { "all_of": [ "LoginScreenClear" ] }
        },
        "next": "RouteAfterLogin"
    },
    "LoginPopupCloseFailed": {
        "focus": {
            "Node.Action.Starting": "登录弹窗关闭失败，停止本次批量任务"
        },
        "action": { "type": "StopTask" }
    },
    "RouteAfterLogin": {
        "next": [ "RouteShoppingFestivalAfterLogin", "RouteClaimingAfterLogin" ]
    },
    "RouteShoppingFestivalAfterLogin": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IsShoppingFestivalTask"
            }
        },
        "next": "ShoppingFestivalEntry"
    },
    "RouteClaimingAfterLogin": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IsClaimingTask"
            }
        },
        "next": [ "ClaimReturnGiftEntry", "ClaimInfiniteIllusionEntry", "ClaimMailEntry", "ClaimLevelEntry", "Login" ]
    },
    "AllServerCompleted": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "AllCompleted"
            }
        }
    },
    "FindDownArrow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [ 867, 475, 98, 107 ],
                "template": "common/login/DownArrow.png",
                "threshold": 0.8
            }
        }
    },
    "ChooseServerButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 0, 0, 0, 0 ],
                "expected": [ "set in code" ]
            }
        }
    },
    "LoginMsg": {
        "focus": {
            "Node.Action.Succeeded": "Action msg set in code",
            "Node.Recognition.Succeeded": "Recognition msg set in code"
        }
    }
}
