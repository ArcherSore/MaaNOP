{
    "AccountLeveling": {
        "next": "SetLevelingTaskMode"
    },
    "AccountClaims": {
        "next": "SetClaimingTaskMode"
    },
    "ShoppingFestivalTask": {
        "next": "SetShoppingFestivalTaskMode"
    },
    "SetLevelingTaskMode": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetTaskMode",
                "custom_recognition_param": "leveling"
            }
        },
        "next": "SetServerRegion"
    },
    "SetClaimingTaskMode": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetTaskMode",
                "custom_recognition_param": "claiming"
            }
        },
        "next": "SetServerRegion"
    },
    "SetShoppingFestivalTaskMode": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetTaskMode",
                "custom_recognition_param": "shopping"
            }
        },
        "next": "SetServerRegion"
    },
    "SetServerRegion": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetServerRegion",
                "custom_recognition_param": "public"
            }
        },
        "next": "ParseServer"
    },
    "ParseServer": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ParseServerRange"
            }
        },
        "next": "Login"
    },
    "Login": {
        "next": [ "ReChooseServer", "RefreshPage" ]
    },
    "RefreshPage": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/Refresh.png",
                "roi": [ 796, 0, 131, 110 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "ReChooseServer"
    },
    "ReChooseServer": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/GameButton.png",
                "roi": [ 578, 495, 207, 98 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 665, 601, 33, 6 ] // 重新选区button
            }
        },
        "next": [ "ReChooseServer", "GetNextServer" ]
    },
    "GetNextServer": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "GetNextServer"
            }
        },
        "next": [ "AllServerCompleted", "DeterminePage" ]
    },
    "DeterminePage": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DetectServerPage"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "ScrollToTarget"
    },
    "ScrollToTarget": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ScrollToTargetServer"
            }
        },
        "next": "ChooseServer"
    },
    "ChooseServer": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "LocateServerButton"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": [ "RouteLevelingAfterServerSelection", "LoginPopupAppears" ]
    },
    "RouteLevelingAfterServerSelection": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IsLevelingTask"
            }
        },
        "next": "LevelingEntry"
    },
    "LoginPopupAppears": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchPopup",
                "custom_recognition_param": {
                    "popups": [
                        { "name": "公告", "template": "popup/Announcement.png", "roi": [ 647, 309, 196, 89 ], "target": [ 962, 352, 13, 12 ] },
                        { "name": "回归", "template": "popup/Return.png", "roi": [ 671, 182, 260, 136 ], "target": [ 901, 233, 13, 12 ] },
                        { "name": "福利", "template": "popup/Welfare.png", "roi": [ 797, 186, 121, 86 ], "target": [ 961, 224, 13, 12 ] },
                        { "name": "组织", "template": "popup/Organization.png", "roi": [ 617, 557, 101, 66 ] }
                    ]
                }
            }
        },
        "action": { "type": "Click" },
        "next": "CloseLoginPopup"
    },
    "CloseLoginPopup": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "LoginPopupAppears", "RouteAfterLogin" ]
    },
    "RouteAfterLogin": {
        "next": [ "RouteShoppingFestivalAfterLogin", "RouteClaimingAfterLogin" ]
    },
    "RouteShoppingFestivalAfterLogin": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IsShoppingFestivalTask"
            }
        },
        "next": "ShoppingFestivalEntry"
    },
    "RouteClaimingAfterLogin": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IsClaimingTask"
            }
        },
        "next": [ "ClaimReturnGiftEntry", "ClaimInfiniteIllusionEntry", "ClaimMailEntry", "ClaimLevelEntry", "Login" ]
    },
    "AllServerCompleted": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "AllCompleted"
            }
        }
    },
    "FindDownArrow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [ 867, 475, 98, 107 ],
                "template": "common/login/DownArrow.png",
                "threshold": 0.8
            }
        }
    },
    "CheckRemainPopup": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "popup/Return.png" ],
                "roi": [ 671, 182, 260, 136 ],
                "order_by": "Score"
            }
        }
    },
    "ChooseServerButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 0, 0, 0, 0 ],
                "expected": [ "set in code" ]
            }
        }
    },
    "LoginMsg": {
        "focus": {
            "Node.Action.Succeeded": "Action msg set in code",
            "Node.Recognition.Succeeded": "Recognition msg set in code"
        }
    }
}
