{
    "AccountLeveling": {
        "next": "SetLevelingTaskMode"
    },
    "AccountClaims": {
        "next": "SetClaimingTaskMode"
    },
    "ShoppingFestivalTask": {
        "next": "SetShoppingFestivalTaskMode"
    },
    "SetLevelingTaskMode": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetTaskMode",
                "custom_recognition_param": "leveling"
            }
        },
        "next": "ParseServer"
    },
    "SetClaimingTaskMode": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetTaskMode",
                "custom_recognition_param": "claiming"
            }
        },
        "next": "ParseServer"
    },
    "SetShoppingFestivalTaskMode": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetTaskMode",
                "custom_recognition_param": "shopping"
            }
        },
        "next": "ParseServer"
    },
    "ParseServer": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ParseServerRange"
            }
        },
        "next": "Login"
    },
    "Login": {
        "next": [ "ReChooseServer", "RefreshPage" ]
    },
    "RefreshPage": {
        "post_delay": 3000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/Refresh.png",
                "roi": [ 796, 0, 131, 110 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "ReChooseServer"
    },
    "ReChooseServer": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/Reselect.png",
                "roi": [ 606, 545, 142, 112 ],
                "threshold": 0.6
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "GetNextServer"
    },
    "GetNextServer": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "GetNextServer"
            }
        },
        "next": [ "AllServerCompleted", "DeterminePage" ]
    },
    "DeterminePage": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DetectServerPage"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "ScrollToTarget"
    },
    "ScrollToTarget": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ScrollToTargetServer"
            }
        },
        "next": "ChooseServer"
    },
    "ChooseServer": {
        "post_delay": 5000,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "LocateServerButton"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": [ "RouteLevelingAfterServerSelection", "LoginPopupAppears" ]
    },
    "RouteLevelingAfterServerSelection": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IsLevelingTask"
            }
        },
        "next": "LevelingEntry"
    },
    "LoginPopupAppears": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DetectLoginPopup"
            }
        },
        "next": "CloseLoginPopup"
    },
    "CloseLoginPopup": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "HandleLoginPopups"
            }
        },
        "next": "RouteAfterLogin"
    },
    "RouteAfterLogin": {
        "next": [ "RouteShoppingFestivalAfterLogin", "RouteClaimingAfterLogin" ]
    },
    "RouteShoppingFestivalAfterLogin": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IsShoppingFestivalTask"
            }
        },
        "next": "ShoppingFestivalEntry"
    },
    "RouteClaimingAfterLogin": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "IsClaimingTask"
            }
        },
        "next": [ "ClaimReturnGiftEntry", "ClaimInfiniteIllusionEntry", "ClaimMailEntry", "ClaimLevelEntry", "Login" ]
    },
    "AllServerCompleted": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "AllCompleted"
            }
        }
    },
    "FindDownArrow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [ 867, 475, 98, 107 ],
                "template": "common/login/DownArrow.png",
                "threshold": 0.8
            }
        }
    },
    "CheckAnnouncement": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "popup/CloseAnno.png" ],
                "roi": [ 901, 297, 119, 117 ]
            }
        }
    },
    "CheckWelfare": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "popup/Welfare.png" ],
                "roi": [ 806, 192, 145, 140 ]
            }
        }
    },
    "CheckReturnGift": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "popup/Return.png",
                "roi": [ 671, 182, 260, 136 ]
            }
        }
    },
    "CheckRemainPopup": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "popup/Return.png" ],
                "roi": [ 671, 182, 260, 136 ],
                "order_by": "Score"
            }
        }
    },
    "ChooseServerType": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 0, 0, 0, 0 ],
                "expected": [ "set in code" ]
            }
        }
    },
    "ChooseServerButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 0, 0, 0, 0 ],
                "expected": [ "set in code" ]
            }
        }
    },
    "LoginMsg": {
        "focus": {
            "Node.Action.Succeeded": "Action msg set in code",
            "Node.Recognition.Succeeded": "Recognition msg set in code"
        }
    }
}
