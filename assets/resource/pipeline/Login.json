{
    // 入口只指定公共组件的返回去向；选服、网页登录和弹窗识别共用。
    "GameEntry": {
        "pre_delay": 0,
        "post_delay": 0,
        "anchor": {
            "ServerSelected": "LoginPopupAppears",
            "LoginComplete": "SingleLoginDone"
        },
        "next": "SetServerRegion"
    },
    "AccountLeveling": {
        "pre_delay": 0,
        "post_delay": 0,
        "anchor": { "ServerSelected": "LevelingEntry" },
        "next": "BatchLoginEntry"
    },
    "AccountClaims": {
        "pre_delay": 0,
        "post_delay": 0,
        "anchor": {
            "ServerSelected": "LoginPopupAppears",
            "LoginComplete": "ClaimingTasks"
        },
        "next": "BatchLoginEntry"
    },
    "ShoppingFestivalTask": {
        "pre_delay": 0,
        "post_delay": 0,
        "anchor": {
            "ServerSelected": "LoginPopupAppears",
            "LoginComplete": "ShoppingFestivalEntry"
        },
        "next": "BatchLoginEntry"
    },
    "BatchLoginEntry": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": "SetServerRegion"
    },
    "SingleLoginDone": {
        "action": {
            "type": "Custom",
            "param": { "custom_action": "ClearServerSession" }
        }
    },
    // 只由本服业务出口进入；先推进并判断完成，最后一服不刷新。
    "BatchServerDone": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": "GetNextServer"
    },
    "SetServerRegion": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "SetServerRegion",
                "custom_recognition_param": "public"
            }
        },
        "next": "ParseServer"
    },
    "ParseServer": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "ParseServerRange"
            }
        },
        "next": "GetNextServer"
    },
    "RefreshPage": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/Refresh.png",
                "roi": [ 900, 20, 80, 32 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "WebLogin"
    },
    "ReChooseServer": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/GameButton.png",
                "roi": [ 578, 453, 207, 98 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 665, 559, 33, 6 ] // 重新选区button
            }
        },
        "next": [ "ReChooseServer", "ChooseRecentServer", "DeterminePage" ]
    },
    // 首次运行和切服统一刷新，再判断 QQ 登录态；列表完成时不刷新。
    "GetNextServer": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "GetNextServer"
            }
        },
        "next": [ "AllServerCompleted", "RefreshPage" ]
    },
    "ChooseRecentServer": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [ "RecentServerFirst", "RecentServerSecond", "RecentServerThird" ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "timeout": 60000,
        "next": [ "[Anchor]ServerSelected" ]
    },
    "RecentServerFirst": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 437, 198, 107, 18 ],
                "expected": "set in code"
            }
        }
    },
    "RecentServerSecond": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 546, 198, 108, 18 ],
                "expected": "set in code"
            }
        }
    },
    "RecentServerThird": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 655, 198, 107, 18 ],
                "expected": "set in code"
            }
        }
    },
    "DeterminePage": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "DetectServerPage"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": "ScrollToTarget"
    },
    "ScrollToTarget": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ScrollToTargetServer"
            }
        },
        "next": "ChooseServer"
    },
    "ChooseServer": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "LocateServerButton"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "timeout": 60000,
        "next": [ "[Anchor]ServerSelected" ]
    },
    "LoginPopupAppears": {
        // 注册完成账号登录后必须先识别并处理弹窗；选服节点不得直接进入清屏完成分支。
        // 加载中或被上层遮罩挡住时点击会丢失；下层弹窗变暗后仍能匹配，须按上层优先排序。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchPopup",
                "custom_recognition_param": {
                    "popups": [
                        { "name": "公告", "template": "popup/Announcement.png", "roi": [ 647, 288, 196, 89 ], "target": [ 962, 331, 13, 12 ] },
                        { "name": "回归", "template": "popup/Return.png", "roi": [ 671, 161, 260, 136 ], "target": [ 901, 212, 13, 12 ] },
                        { "name": "福利", "template": "popup/Welfare.png", "roi": [ 797, 165, 121, 86 ], "target": [ 961, 203, 13, 12 ] },
                        { "name": "组织", "template": "popup/Organization.png", "roi": [ 617, 557, 101, 66 ] }
                    ]
                }
            }
        },
        "pre_delay": 0,
        "post_delay": 1000, // 弹窗点中后约 0.1 秒消失，等待后再识别，避免补点到地图。
        "action": { "type": "Click" },
        "next": [ "LoginPopupAppears", "LoginScreenClear" ]
    },
    "LoginScreenClear": {
        "pre_delay": 0,
        "post_delay": 2000, // 相邻弹窗实测间隔约 0.5 秒，需留出 2 秒安静期。
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": { "match": "LoginMapVisible", "without": "WalkLoading" }
            }
        },
        // 实图：体力标签出现时 LOADING 仍未消失，须同帧排除加载。
        "next": [ "LoginPopupAppears", "LoginScreenStillClear" ]
    },
    "LoginMapVisible": {
        "pre_delay": 0,
        "post_delay": 0,
        // 10001 对亮度敏感，体力标签在遮罩下实测约 0.05，可用于确认地图无遮挡。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/StaminaLabel.png",
                "roi": [ 32, 42, 66, 61 ],
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    "LoginScreenStillClear": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": { "all_of": [ "LoginScreenClear" ] }
        },
        "next": [ "LoginHidePlayers", "LoginPlayersHidden" ]
    },
    "LoginHidePlayers": {
        "recognition": {
            "type": "And",
            "param": { "all_of": [ "HidePlayersIcon" ] }
        },
        "action": { "type": "Click" },
        "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
        "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "LoginPlayersHidden" ]
    },
    "LoginPlayersHidden": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/PlayersHidden.png",
                "roi": [ 1262, 36, 61, 60 ],
                "threshold": 0.85
            }
        },
        "next": "[Anchor]LoginComplete"
    },
    "ClaimingTasks": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "ClaimReturnGiftEntry", "ClaimInfiniteIllusionEntry", "ClaimMailEntry", "ClaimLevelEntry", "BatchServerDone" ]
    },
    "AllServerCompleted": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "AllCompleted"
            }
        }
    },
    "FindDownArrow": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [ 867, 436, 98, 107 ],
                "template": "common/login/DownArrow.png",
                "threshold": 0.8
            }
        }
    },
    "ChooseServerButton": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 0, 0, 0, 0 ],
                "expected": [ "set in code" ]
            }
        }
    },
    "LoginMsg": {
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Action.Succeeded": "Action msg set in code",
            "Node.Recognition.Succeeded": "Recognition msg set in code"
        }
    }
}
