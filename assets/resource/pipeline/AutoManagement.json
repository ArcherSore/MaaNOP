// 当天首次托管消耗 1 张托管卡；沿用用户设置，不支持「空闲时自动停靠在温泉」。
// 托管会循环执行而不自行停止；实测三个号一轮内最长 6 秒无新日志，两轮间约 70 秒。
// 扫荡、切图、弹窗和好友浇水期间可能无新日志，必须排除这些忙碌状态。
// 首轮完成以排除忙碌状态后日志连续 10 秒不变判定；后续轮次补做及长期等待项目留给下次运行。
{
    "AutoManagement": {
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：主界面左上角找不到托管入口"
        },
        // 「激活上忍勋章返还点券」会遮住入口模板，实测不到 10 秒自行消失。
        "timeout": 15000,
        "next": [ "AutoManageRunning", "AutoManageConfirm", "AutoManageStartReady", "AutoManageWindowRunning", "AutoManageOpenWindow" ]
    },
    // 入口仅截按钮内部以避开玩家名字；悬停时图标变亮，需兼容两种外观。
    "AutoManageEntryIcon": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "autoManagement/EntryIcon.png", "autoManagement/EntryIconHover.png" ],
                "roi": [ 294, 131, 52, 53 ],
                "threshold": 0.8
            }
        }
    },
    "AutoManageOpenWindow": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AutoManageEntryIcon" ]
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：托管系统窗口没有打开"
        },
        "post_delay": 1500, // 窗口先出空框，约 1 秒后才绘制内容，无中间状态。
        "timeout": 10000,
        "next": [ "AutoManageStartReady", "AutoManageWindowRunning", "AutoManageOpenAgain" ]
    },
    "AutoManageIconOnMap": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AutoManageMapClear", "AutoManageEntryIcon" ],
                "box_index": 1
            }
        }
    },
    // 窗口不在前台时首次点击可能只激活窗口，游戏不接收点击。
    // 托管中点击入口会直接结束托管，重试前必须在同一帧排除托管面板。
    "AutoManageOpenAgain": {
        "max_hit": 2,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "AutoManageIconOnMap",
                    "without": "AutoManagePanelShown"
                }
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：托管系统窗口没有打开"
        },
        "post_delay": 1500, // 同上
        "timeout": 10000,
        "next": [ "AutoManageStartReady", "AutoManageWindowRunning", "AutoManageOpenAgain" ]
    },
    // 「当前拥有托管卡」在三个页签均可见。
    "AutoManageWindowLabel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "autoManagement/WindowLabel.png",
                "roi": [ 823, 199, 104, 51 ],
                "threshold": 0.9
            }
        }
    },
    // 开始按钮橙色像素实测（S≥120）：普通 220、悬停 247、灰色/遮罩下为 0。
    // 悬停会提亮并降低饱和度，需兼容两种外观。
    "AutoManageStartReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoManageWindowLabel",
                    {
                        "sub_name": "start",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": [ "autoManagement/StartButton.png", "autoManagement/StartButtonHover.png" ],
                                "roi": [ 548, 566, 90, 52 ],
                                "threshold": 0.7
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "start",
                                "method": 40,
                                "lower": [ 3, 120, 150 ],
                                "upper": [ 30, 255, 255 ],
                                "count": 100
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：点了开始托管，但没有进入托管"
        },
        "timeout": 10000,
        "next": [ "AutoManageConfirm", "AutoManageRunning" ]
    },
    // 当天首次托管会弹消耗 1 张托管卡的确认框。
    "AutoManageConfirm": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "autoManagement/ConfirmText.png",
                "roi": [ 602, 353, 130, 55 ],
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 592, 431, 38, 10 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：确认后没有进入托管"
        },
        "timeout": 10000,
        "next": [ "AutoManageRunning" ]
    },
    // 托管中可由「查看日志」打开窗口；关闭后才露出左下托管面板。
    // 退出按钮蓝色像素实测：普通 483、悬停 362、灰色/遮罩下为 0；悬停模板得分仅 0.75。
    "AutoManageWindowRunning": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AutoManageWindowLabel",
                    {
                        "sub_name": "exit",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": [ "autoManagement/WindowExitButton.png", "autoManagement/WindowExitButtonHover.png" ],
                                "roi": [ 706, 566, 84, 52 ],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": "exit",
                                "roi_offset": [ -6, -2, 12, 4 ],
                                "method": 40,
                                "lower": [ 85, 100, 120 ],
                                "upper": [ 115, 255, 255 ],
                                "count": 150
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 974, 209, 10, 10 ]
            }
        },
        "timeout": 10000,
        "next": [ "AutoManageRunning" ]
    },
    // 「托管中」面板在切地图加载时不可见。
    "AutoManagePanelTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "autoManagement/PanelTitle.png",
                "roi": [ 40, 413, 76, 54 ],
                "threshold": 0.85
            }
        }
    },
    // 忍者考试扫荡期间面板改为「正在扫荡」，结束后恢复；最长 540 秒。
    "AutoManageSweepPanel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "autoManagement/SweepPanelTitle.png",
                "roi": [ 37, 401, 82, 54 ],
                "threshold": 0.85
            }
        }
    },
    "AutoManagePanelShown": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [ "AutoManagePanelTitle", "AutoManageSweepPanel" ]
            }
        }
    },
    "AutoManageRunning": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AutoManagePanelShown" ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "托管中，等这一轮做完后退出托管",
            "Node.PipelineNode.Failed": "托管失败：20 分钟内未能确认本轮完成，托管尚未退出，请手动检查"
        },
        "timeout": 1200000, // 安全超时依据：扫荡 540 秒的实测全程约 12.6 分钟。
        "next": [ "AutoManageIdle" ]
    },
    // 好友浇水不写日志，满成长提示曾持续 20 多秒，需视为忙碌。
    // 模板仅截左半句以避开人物遮挡；实测有提示 0.79~1.0，无提示 ≤0.4。
    "AutoManageWaterFullToast": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "autoManagement/WaterFullToast.png",
                "roi": [ 526, 330, 144, 60 ],
                "threshold": 0.7
            }
        }
    },
    // 退出无确认框，面板实测约 0.5 秒内消失。
    "AutoManageIdle": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "AutoManageLogQuiet",
                "custom_recognition_param": {
                    "require_nodes": [ "AutoManagePanelTitle", "AutoManageMapClear" ],
                    "busy_nodes": [ "AutoManageWaterFullToast" ],
                    "line_roi": [ 10, 446, 140, 34 ],
                    "quiet_seconds": 10
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 93, 489, 30, 8 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：点了退出托管，但托管面板还在"
        },
        "post_delay": 1500, // 面板约 0.5 秒内消失，无中间状态；等待 1.5 秒后再判断是否需要重试。
        "timeout": 10000,
        "next": [ "AutoManageExited", "AutoManageExitAgain" ]
    },
    // 窗口不在前台时退出点击可能只激活窗口；实测按钮高亮但仍未退出。
    "AutoManageExitAgain": {
        "max_hit": 2,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "AutoManageMapClear", "AutoManagePanelTitle" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 93, 489, 30, 8 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "托管失败：点了退出托管，但托管面板还在"
        },
        "post_delay": 1500, // 同上
        "timeout": 10000,
        "next": [ "AutoManageExited", "AutoManageExitAgain" ]
    },
    "AutoManageMapClear": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/StaminaLabel.png",
                "roi": [ 32, 84, 66, 61 ],
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    // 退出必须在同一帧确认地图存在且面板消失；切图加载也会隐藏面板，分帧判断会误报退出。
    "AutoManageExited": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "AutoManageMapClear",
                    "without": "AutoManagePanelShown"
                }
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "托管已完成，已退出托管"
        }
    }
}
