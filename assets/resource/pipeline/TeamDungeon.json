// 单人组队副本；副本与难度由 interface.json 覆盖 TeamDungeonCard / TeamDungeonDiffTarget 模板。
// 实测（2026-10-14，1007 区 78 级）：
// 战败只短暂显示「败北」，随后重开副本窗口且不扣次数；未经过结算就回窗口视为战败。
// 重开窗口默认推荐页，全部副本列表回到顶端，卡片难度回到各副本已解锁的最高档。
// 精英忍者界面未经实测；后续战斗继续托管，非战斗中的「精英」界面则停止并报告。
// 卡片标题框（44x66）是难度栏、箭头和卡片点击区域的共同偏移基准。
// 选队复用 Abundance*；interface.json 将 AbundanceTeamClose 接到 TeamDungeonOpenDaily。
{
    "TeamDungeon": {
        "next": [ "TeamDungeonSetTeam" ]
    },
    // TeamDungeonTeam 选项传入队伍编号（1~8）。
    "TeamDungeonSetTeam": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SetBossTeam",
                "custom_action_param": 1
            }
        },
        "next": [ "AbundanceTeamScreen", "AbundanceGotoTeam" ]
    },

    "TeamDungeonDailyEntry": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": [ "ninjaQuiz/DailyEntry.png" ]
                }
            }
        }
    },
    "TeamDungeonOpenDaily": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonDailyEntry" ]
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：点了顶部「日常锻炼」图标，窗口没有打开（请确认停在主界面、入口没被挡住）"
        },
        "post_delay": 1500, // 窗口打开动画无中间状态，等待 1.5 秒后再判断是否需要重试。
        "timeout": 10000,
        "next": [ "TeamDungeonLimitedOpened", "TeamDungeonClickLimitedTab", "TeamDungeonOpenDailyAgain" ]
    },
    // 体力标签未变暗表示地图无遮挡；战斗、加载时该标签也不可见。
    "TeamDungeonMapClear": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/login/StaminaLabel.png",
                "roi": [ 32, 84, 66, 61 ],
                "method": 10001,
                "threshold": 0.8
            }
        }
    },
    // 窗口不在前台时首次点击可能只激活窗口，游戏不接收点击。
    "TeamDungeonOpenDailyAgain": {
        "max_hit": 4,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonMapClear", "TeamDungeonDailyEntry" ],
                "box_index": 1
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：点了顶部「日常锻炼」图标，窗口没有打开（请确认停在主界面、入口没被挡住）"
        },
        "post_delay": 1500, // 同上
        "timeout": 10000,
        "next": [ "TeamDungeonLimitedOpened", "TeamDungeonClickLimitedTab", "TeamDungeonOpenDailyAgain" ]
    },
    "TeamDungeonDailyTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ninjaQuiz/DailyTab.png",
                "roi": [ 355, 195, 110, 40 ],
                "threshold": 0.85
            }
        }
    },
    // 页签模板实测：选中 1.0，日常活动页为 0.52。
    "TeamDungeonLimitedTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/HubLimitedTab.png",
                "roi": [ 455, 195, 100, 40 ],
                "threshold": 0.85
            }
        }
    },
    "TeamDungeonClickLimitedTab": {
        "max_hit": 4,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonDailyTab" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 478, 207, 50, 14 ]
            }
        },
        "post_delay": 1000, // 页签切换无过渡状态，等待 1 秒后再判断是否需要重试。
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：日常锻炼里点了「限时活动」页签，没有切过去"
        },
        "timeout": 5000,
        "next": [ "TeamDungeonLimitedOpened", "TeamDungeonClickLimitedTab" ]
    },
    // 列表行模板实测：选中 1.0、未选中 0.93，其他画面最高 0.31。
    // 限时活动顺序随今日活动/预告变化，不能使用固定行号。
    "TeamDungeonRow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/HubRow.png",
                "roi": [ 355, 240, 390, 275 ],
                "threshold": 0.8
            }
        }
    },
    // 详情标题模板实测：选中 1.0，其他行 0.60。
    "TeamDungeonPanelTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/HubPanelTitle.png",
                "roi": [ 760, 232, 90, 32 ],
                "threshold": 0.85
            }
        }
    },
    "TeamDungeonLimitedOpened": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonLimitedTab" ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [ 350, 235, 600, 285 ]
        },
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：日常锻炼窗口打开后没认出限时活动页"
        },
        "timeout": 5000,
        "next": [ "TeamDungeonJoin", "TeamDungeonJoinGrey", "TeamDungeonSelectRow", "TeamDungeonScrollList" ]
    },
    "TeamDungeonSelectRow": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonRow" ]
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：限时活动列表里点了「组队副本」这一行，右侧详情没有切过去"
        },
        "post_delay": 1000, // 详情原位替换，无中间状态；等待 1 秒后再判断是否需要重试。
        "timeout": 5000,
        "next": [ "TeamDungeonJoin", "TeamDungeonJoinGrey", "TeamDungeonSelectRowAgain" ]
    },
    // 首次点击可能只触发悬停；需在同一帧确认行存在且详情未切换。
    "TeamDungeonSelectRowAgain": {
        "max_hit": 4,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "TeamDungeonRow",
                    "without": "TeamDungeonPanelTitle"
                }
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：限时活动列表里点了「组队副本」这一行，右侧详情没有切过去"
        },
        "post_delay": 1000, // 同上
        "timeout": 5000,
        "next": [ "TeamDungeonJoin", "TeamDungeonJoinGrey", "TeamDungeonSelectRowAgain" ]
    },
    // 活动列表不响应滚轮。
    "TeamDungeonScrollList": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonLimitedTab" ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 752, 275, 1, 1 ],
                "end": [ 752, 520, 1, 1 ],
                "duration": 500
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [ 350, 235, 400, 285 ]
        },
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：限时活动列表里找不到「组队副本」（等级不到 30 或活动没开）"
        },
        "timeout": 3000,
        "next": [ "TeamDungeonSelectRow" ]
    },
    "TeamDungeonJoinOrange": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 822, 492, 62, 16 ],
                "method": 40,
                "lower": [ 3, 190, 150 ],
                "upper": [ 30, 255, 255 ],
                "count": 300
            }
        }
    },
    // 参与后直接打开副本窗口，无寻路过程，实测约 2 秒。
    "TeamDungeonJoin": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonPanelTitle", "TeamDungeonJoinOrange" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 834, 494, 40, 13 ]
            }
        },
        "post_delay": 1500, // 点击后日常窗口立即关闭；等待 1.5 秒后再判断是否需要重试。
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：点了「参与」，组队副本窗口没有打开"
        },
        "timeout": 15000,
        "next": [ "TeamDungeonWindow", "TeamDungeonJoinAgain" ]
    },
    "TeamDungeonJoinAgain": {
        "max_hit": 2,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonLimitedTab", "TeamDungeonPanelTitle", "TeamDungeonJoinOrange" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 834, 494, 40, 13 ]
            }
        },
        "post_delay": 1500, // 同上
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：点了「参与」，组队副本窗口没有打开"
        },
        "timeout": 15000,
        "next": [ "TeamDungeonWindow", "TeamDungeonJoinAgain" ]
    },
    // 灰色「参与」的成因未经实测，仅报告按钮不可用。
    "TeamDungeonJoinGrey": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TeamDungeonPanelTitle",
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [ 822, 492, 62, 16 ],
                                "method": 40,
                                "lower": [ 0, 0, 50 ],
                                "upper": [ 180, 45, 150 ],
                                "count": 400
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 184, 8, 8 ]
            }
        },
        "timeout": 5000,
        "next": [ "TeamDungeonJoinGreyClosed" ]
    },
    "TeamDungeonJoinGreyClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonLimitedTab" ]
            }
        },
        "inverse": true,
        "next": [ "TeamDungeonJoinGreyFailed" ]
    },
    "TeamDungeonJoinGreyFailed": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "组队副本失败：日常锻炼里组队副本的「参与」是灰的，进不去（开放时间 08:00~24:00）"
        }
    },

    // 10001 模板实测：前台窗口 ≥0.95，公告遮挡时 0.947，弹窗遮罩下为 0。
    "TeamDungeonWindowFront": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/WindowTitle.png",
                "roi": [ 600, 180, 140, 40 ],
                "method": 10001,
                "threshold": 0.75
            }
        }
    },
    // 普通匹配在遮罩下仍能命中，用于判断窗口是否关闭。
    "TeamDungeonWindowAny": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/WindowTitle.png",
                "roi": [ 600, 180, 140, 40 ],
                "threshold": 0.8
            }
        }
    },
    // 10001 页签模板实测：选中 1.0，未选中 0.62，遮罩下 ≤0.17。
    "TeamDungeonAllTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/AllTabSelected.png",
                "roi": [ 430, 235, 70, 25 ],
                "method": 10001,
                "threshold": 0.85
            }
        }
    },
    // 本日次数用单字模板：每天 5 次，OCR 实测漏读「3」。
    // 9x11 数字模板实测：自身 1.0、遮罩下 0.96；「0」与 1~5 互相最高 0.71。
    "TeamDungeonDailyLeft": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "teamDungeon/daily/1.png",
                    "teamDungeon/daily/2.png",
                    "teamDungeon/daily/3.png",
                    "teamDungeon/daily/4.png",
                    "teamDungeon/daily/5.png"
                ],
                "roi": [ 522, 564, 20, 17 ],
                "threshold": 0.9
            }
        }
    },
    "TeamDungeonDailyNone": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/daily/0.png",
                "roi": [ 522, 564, 20, 17 ],
                "threshold": 0.9
            }
        }
    },
    // 本周最多 20 次；单字模板会误认 10/20 中的 0，因此用 OCR 精确读「0」。
    // 本周次数耗尽状态未经实测。
    "TeamDungeonWeeklyNone": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 442, 564, 24, 17 ],
                "expected": [ "^0$" ]
            }
        }
    },
    "TeamDungeonWindow": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront" ]
            }
        },
        // 卡片有淡入动画，需等画面稳定。
        "post_wait_freezes": {
            "time": 500,
            "target": [ 390, 260, 580, 300 ]
        },
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：组队副本窗口里认不出当前状态（可能被别的弹窗挡住）"
        },
        "timeout": 10000,
        "next": [
            "TeamDungeonAllDone",
            "TeamDungeonCardFound",
            "TeamDungeonListEnd",
            "TeamDungeonJumpBottom",
            "TeamDungeonScrollDown",
            "TeamDungeonShowAll"
        ]
    },
    "TeamDungeonAllDone": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TeamDungeonWindowFront",
                    {
                        "recognition": {
                            "type": "Or",
                            "param": {
                                "any_of": [ "TeamDungeonDailyNone", "TeamDungeonWeeklyNone" ]
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 214, 10, 10 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：次数已用完，但组队副本窗口点了关闭没关上"
        },
        "timeout": 5000,
        "next": [ "TeamDungeonClosed" ]
    },
    "TeamDungeonClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowAny" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "组队副本完成：今日奖励次数已用完"
        }
    },
    // 重开窗口默认回推荐页，需重新选择全部副本。
    "TeamDungeonShowAll": {
        "pre_delay": 0,
        "post_delay": 0,
        "max_hit": 20, // 安全上限：每场打完都要切一次
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 446, 243, 30, 10 ]
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [ 390, 260, 580, 300 ]
        },
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：点了「全部副本」页签，没有切过去"
        },
        "timeout": 5000,
        "next": [
            "TeamDungeonCardFound",
            "TeamDungeonListEnd",
            "TeamDungeonJumpBottom",
            "TeamDungeonScrollDown",
            "TeamDungeonShowAll"
        ]
    },
    // 卡片模板实测：自身 1.0，其他卡片/画面最高 0.36，边缘裁掉半张仍约 0.95。
    // ROI 底边限制为 y 490，确保标题顶部 ≤420，下方难度栏仍在可点击范围。
    "TeamDungeonCard": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/dungeon/BridgeBattle.png",
                "roi": [ 395, 262, 570, 228 ],
                "threshold": 0.8
            }
        }
    },
    "TeamDungeonCardFound": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront", "TeamDungeonAllTab", "TeamDungeonCard" ],
                "box_index": 2
            }
        },
        "timeout": 5000,
        "next": [ "TeamDungeonRaise", "TeamDungeonAtMax" ]
    },
    // 滑块到底时下端为 y 530、得分 1.0；差 2 像素未到底时仍有 0.86。
    // 最后一排仅到底后可点，ROI 必须与模板等大，避免提前命中。
    "TeamDungeonListEnd": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TeamDungeonWindowFront",
                    "TeamDungeonAllTab",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "teamDungeon/ListBottom.png",
                                "roi": [ 955, 530, 12, 14 ],
                                "threshold": 0.95
                            }
                        }
                    }
                ]
            }
        },
        "next": [ "TeamDungeonCardMissing" ]
    },
    "TeamDungeonCardMissing": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "组队副本失败：全部副本列表翻到底也没找到所选副本（可能还没解锁，显示「封」）"
        }
    },
    // 第 4、5 排副本选项启用直接拖底；最后两排可在同一屏显示。
    // 两个号实测顶端滑块均占 y 280~473，从 y 290 拖到滑槽下方可到底。
    "TeamDungeonJumpBottom": {
        "pre_delay": 0,
        "post_delay": 0,
        "enabled": false,
        "max_hit": 20, // 安全上限：每场一次
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront", "TeamDungeonAllTab" ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 958, 288, 4, 6 ],
                "end": [ 958, 600, 4, 4 ],
                "duration": 500
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [ 390, 260, 580, 300 ]
        },
        "next": [ "TeamDungeonCardFound", "TeamDungeonListEnd", "TeamDungeonScrollDown" ]
    },
    // 下箭头每次滚动 19~37 像素；滚轮无效，点击滑槽的距离不固定。
    // 翻页后直接找卡片，避免重复等待窗口稳定和读取次数。
    "TeamDungeonScrollDown": {
        "pre_delay": 0,
        "post_delay": 0,
        "max_hit": 300, // 安全上限：每场都要从顶往下翻
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront", "TeamDungeonAllTab" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 955, 545, 10, 8 ]
            }
        },
        "post_wait_freezes": {
            "time": 200,
            "target": [ 390, 260, 580, 300 ]
        },
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：翻找副本列表时窗口被挡住或关掉了"
        },
        "timeout": 5000,
        "next": [ "TeamDungeonCardFound", "TeamDungeonListEnd", "TeamDungeonScrollDown" ]
    },

    // 相对标题框 (x0,y0,44,66)：难度栏 y0+116，左箭头 x0+100~116，文字 x0+124~153，右箭头 x0+163~179。
    // 箭头蓝色像素实测：可用/悬停 39~54，到头变灰为 0。
    "TeamDungeonRaise": {
        "pre_delay": 0,
        "post_delay": 0,
        "max_hit": 40, // 安全上限：每场最多调 4 下
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "TeamDungeonCardFound",
                "roi_offset": [ 165, 119, -32, -56 ],
                "method": 40,
                "lower": [ 90, 120, 120 ],
                "upper": [ 110, 255, 255 ],
                "count": 20
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": "TeamDungeonCardFound",
                "target_offset": [ 166, 118, -32, -54 ]
            }
        },
        "post_wait_freezes": {
            "time": 400,
            "target": "TeamDungeonCardFound",
            "target_offset": [ 100, 112, 36, -46 ]
        },
        "timeout": 3000,
        "next": [ "TeamDungeonRaise", "TeamDungeonAtMax" ]
