            "TeamDungeonReSpeed"
        ]
    },
    // 战斗中又出现「开战」（例如接着打精英忍者）：点掉
    "TeamDungeonReStart": {
        "max_hit": 10,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "powerfulBoss/BattleStart.png",
                "roi": [ 560, 430, 220, 50 ],
                "threshold": 0.85
            }
        },
        "action": "Click",
        "post_delay": 1000, // 点上后按钮直接消失；1 秒后还在才再点
        "next": [ "TeamDungeonBattleWait" ]
    },
    "TeamDungeonReAuto": {
        "max_hit": 20,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOff.png", "common/battle/AutoOffHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": "Click",
        "post_delay": 1000, // 按钮点上后直接换图，没有过渡；1 秒后还是「自动」才再点
        "next": [ "TeamDungeonBattleWait" ]
    },
    "TeamDungeonReSpeed": {
        "max_hit": 20,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOff.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "action": "Click",
