// 单人组队副本；副本与难度由 interface.json 覆盖 TeamDungeonCard / TeamDungeonDiffTarget 模板。
// 卡片标题框（44x66）是难度栏、箭头和卡片点击区域的共同偏移基准。
{
    "TeamDungeon": {
        "next": [ "TeamDungeonSetTeam" ]
    },
    "TeamDungeonSetTeam": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SelectTeam",
                "custom_action_param": 1
            }
        },
        "next": [ "TeamDungeonOpenDaily" ]
    },

    "TeamDungeonOpenDaily": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EnterDailyTask",
                "custom_action_param": {
                    "row": "TeamDungeonRow",
                    "title": "TeamDungeonPanelTitle",
                    "page": "limited"
                }
            }
        },
        "next": [ "TeamDungeonJoin", "TeamDungeonJoinGrey" ]
    },
    // 限时活动顺序随今日活动/预告变化，不能使用固定行号。
    "TeamDungeonRow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/HubRow.png",
                "roi": [ 355, 240, 390, 275 ],
                "threshold": 0.8
            }
        }
    },
    "TeamDungeonPanelTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/HubPanelTitle.png",
                "roi": [ 760, 232, 90, 32 ],
                "threshold": 0.85
            }
        }
    },

    "TeamDungeonJoin": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyJoinAvailable" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 834, 494, 40, 13 ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "开始「组队副本」ing"
        },
        "timeout": 5000,
        "next": [ "TeamDungeonWindow" ]
    },
    // 灰色表示活动未开放；关闭日常窗口后正常结束。
    "TeamDungeonJoinGrey": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyJoinUnavailable" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 184, 8, 8 ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "「组队副本」未开放..."
        },
        "timeout": 5000,
        "next": [ "TeamDungeonJoinGreyClosed" ]
    },
    "TeamDungeonJoinGreyClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyLimitedTab" ]
            }
        },
        "inverse": true
    },
    // 用 10001 排除遮罩下的窗口，避免对弹窗下方操作。
    "TeamDungeonWindowFront": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/WindowTitle.png",
                "roi": [ 600, 180, 140, 40 ],
                "method": 10001,
                "threshold": 0.75
            }
        }
    },
    // 关闭检查使用普通匹配：被遮罩覆盖不等于窗口已关闭。
    "TeamDungeonWindowAny": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/WindowTitle.png",
                "roi": [ 600, 180, 140, 40 ],
                "threshold": 0.8
            }
        }
    },
    // 必须识别选中状态；未选中时也显示「全部副本」，不能只用 OCR。
    "TeamDungeonAllTab": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/AllTabSelected.png",
                "roi": [ 430, 235, 70, 25 ],
                "method": 10001,
                "threshold": 0.85
            }
        }
    },
    // 每次打开或返回副本窗口时检查本日次数；为 0 就结束。
    "TeamDungeonDailyNone": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 522, 564, 20, 17 ],
                "expected": [ "^0$" ],
                "only_rec": true
            }
        }
    },
    "TeamDungeonWindow": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront" ]
            }
        },
        // 卡片有淡入动画，需等画面稳定。
        "post_wait_freezes": {
            "time": 500,
            "target": [ 390, 260, 580, 300 ]
        },
        "timeout": 10000,
        "next": [
            "TeamDungeonAllDone",
            "TeamDungeonCardFound",
            "TeamDungeonListEnd",
            "TeamDungeonJumpBottom",
            "TeamDungeonScrollDown",
            "TeamDungeonShowAll"
        ]
    },
    "TeamDungeonAllDone": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront", "TeamDungeonDailyNone" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 214, 10, 10 ]
            }
        },
        "timeout": 5000,
        "next": [ "TeamDungeonClosed" ]
    },
    "TeamDungeonClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowAny" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "「组队副本」今日奖励次数已用完"
        }
    },
    // 重开默认推荐页；仅在窗口在前台且全部页未选中时补点。
    "TeamDungeonShowAll": {
        "pre_delay": 0,
        "post_delay": 0,
        "max_hit": 20,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "TeamDungeonWindowFront",
                    "without": "TeamDungeonAllTab"
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 446, 243, 30, 10 ]
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [ 390, 260, 580, 300 ]
        },
        "timeout": 5000,
        "next": [
            "TeamDungeonCardFound",
            "TeamDungeonListEnd",
            "TeamDungeonJumpBottom",
            "TeamDungeonScrollDown",
            "TeamDungeonShowAll"
        ]
    },
    // 限制标题识别范围，确保下方难度栏和卡片点击区域完整可见。
    "TeamDungeonCard": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/dungeon/BridgeBattle.png",
                "roi": [ 395, 262, 570, 228 ],
                "threshold": 0.8
            }
        }
    },
    "TeamDungeonCardFound": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront", "TeamDungeonAllTab", "TeamDungeonCard" ],
                "box_index": 2
            }
        },
        "timeout": 5000,
        "next": [ "TeamDungeonDiffTarget", "TeamDungeonLower", "TeamDungeonDiffMissing" ]
    },
    // 最后一排需滚到底才能点击；ROI 与模板等大，避免把接近底部误判为到底。
    "TeamDungeonListEnd": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TeamDungeonWindowFront",
                    "TeamDungeonAllTab",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "teamDungeon/ListBottom.png",
                                "roi": [ 955, 530, 12, 14 ],
                                "threshold": 0.95
                            }
                        }
                    }
                ]
            }
        },
        "next": [ "TeamDungeonCardMissing" ]
    },
    "TeamDungeonCardMissing": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "列表翻到底也没找到所选副本..."
        }
    },
    // interface 为最后两排副本启用拖底，减少逐次翻找；两排可在底部同屏显示。
    "TeamDungeonJumpBottom": {
        "pre_delay": 0,
        "post_delay": 0,
        "enabled": false,
        "max_hit": 20,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront", "TeamDungeonAllTab" ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 958, 288, 4, 6 ],
                "end": [ 958, 600, 4, 4 ],
                "duration": 500
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [ 390, 260, 580, 300 ]
        },
        "next": [ "TeamDungeonCardFound", "TeamDungeonListEnd", "TeamDungeonScrollDown" ]
    },
    // 滚轮无效，点击滑槽距离不固定，因此用下箭头翻找；翻页不重复读取次数。
    "TeamDungeonScrollDown": {
        "pre_delay": 0,
        "post_delay": 0,
        "max_hit": 300,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront", "TeamDungeonAllTab" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 955, 545, 10, 8 ]
            }
        },
        "post_wait_freezes": {
            "time": 200,
            "target": [ 390, 260, 580, 300 ]
        },
        "timeout": 5000,
        "next": [ "TeamDungeonCardFound", "TeamDungeonListEnd", "TeamDungeonScrollDown" ]
    },

    // 打开窗口或切换页签后默认最高已解锁难度，只需向左调整。
    "TeamDungeonDiffTarget": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/difficulty/Easy.png",
                "roi": "TeamDungeonCardFound",
                "roi_offset": [ 110, 109, 16, -40 ],
                "threshold": 0.8
            }
        },
        // 点击卡片中部，避开左上标题与右下推荐战力。
        "action": {
            "type": "Click",
            "param": {
                "target": "TeamDungeonCardFound",
                "target_offset": [ 80, 30, 76, -16 ]
            }
        },
        "timeout": 10000,
        "next": [ "TeamDungeonSoloConfirm" ]
    },
    "TeamDungeonLower": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "TeamDungeonCardFound",
                "roi_offset": [ 102, 119, -32, -56 ],
                "method": 40,
                "lower": [ 90, 120, 120 ],
                "upper": [ 110, 255, 255 ],
                "count": 20
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": "TeamDungeonCardFound",
                "target_offset": [ 103, 118, -32, -54 ]
            }
        },
        "post_wait_freezes": {
            "time": 400,
            "target": "TeamDungeonCardFound",
            "target_offset": [ 100, 112, 36, -46 ]
        },
        "timeout": 3000,
        "next": [ "TeamDungeonDiffTarget", "TeamDungeonLower", "TeamDungeonDiffMissing" ]
    },
    // 难度不匹配且左箭头已不可用，说明所选难度不可用，正常跳过。
    "TeamDungeonDiffMissing": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": "TeamDungeonCardFound",
                "roi_offset": [ 102, 119, -32, -56 ],
                "method": 40,
                "lower": [ 90, 120, 120 ],
                "upper": [ 110, 255, 255 ],
                "count": 20
            }
        },
        "inverse": true,
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 214, 10, 10 ]
            }
        },
        "timeout": 5000,
        "next": [ "TeamDungeonDiffMissingClosed" ]
    },
    "TeamDungeonDiffMissingClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowAny" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "所选难度未解锁或该副本不支持！已跳过..."
        }
    },

    // 确认按钮两端尖角不可点。
    "TeamDungeonSoloConfirm": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [ "^确认进入$" ],
                "roi": [ 580, 397, 80, 30 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 598, 406, 44, 12 ]
            }
        },
        "timeout": 30000,
        "next": [ "TeamDungeonBattleStart" ]
    },

    "TeamDungeonBattleStart": {
        "pre_delay": 0,
        "post_delay": 0,
        "max_hit": 20,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "CommonBattleStartButton" ]
            }
        },
        "anchor": {
            "CommonBattleStartTarget": "TeamDungeonBattleStart",
            "CommonBattleOutcome": "TeamDungeonBattleOutcome",
            "CommonBattleContinue": "TeamDungeonBattleWait"
        },
        "next": [ "CommonBattleClickStart" ]
    },
    // 精英触发时会短暂回副本窗口再出现「开战」；此处不操作窗口，继续等开战或结算。
    "TeamDungeonBattleWait": {
        "timeout": 600000,
        "next": [ "TeamDungeonSettleReturn", "TeamDungeonBattleStart" ]
    },
    // 仅借用结算识别；新开战由公共 StartTarget 接管，避免同轮重复 OCR。
    "TeamDungeonBattleOutcome": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonSettleReturn" ]
            }
        },
        "next": [ "TeamDungeonBattleWait" ]
    },

    // 只匹配「返回」，避免后续文字和倒计时干扰；点击后会自动领奖并重开副本窗口。
    "TeamDungeonSettleReturn": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [ "返回" ],
                "roi": [ 810, 575, 120, 40 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 838, 589, 56, 10 ]
            }
        },
        "timeout": 30000,
        "next": [ "TeamDungeonWindow" ]
    }
}
