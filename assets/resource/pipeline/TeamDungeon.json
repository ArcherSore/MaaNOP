        "next": [ "TeamDungeonAutoOn", "TeamDungeonAutoOff" ]
    },
    // 托管 / 加速的开关会记住上一场的状态（第一场实测都是关的）
    "TeamDungeonAutoOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOn.png", "common/battle/AutoOnHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "next": [ "TeamDungeonSpeedOn", "TeamDungeonSpeedOff" ]
    },
    "TeamDungeonAutoOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOff.png", "common/battle/AutoOffHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": "Click",
        "next": [ "TeamDungeonSpeedOn", "TeamDungeonSpeedOff" ]
    },
    "TeamDungeonSpeedOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOn.png",
                "roi": [ 870, 635, 69, 69 ]
            }
