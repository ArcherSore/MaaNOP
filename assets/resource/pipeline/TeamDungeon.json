    // ===== 结算：点「返回游戏」=====
    // 打赢后「战斗结算!」界面：先把 10 张牌正面亮一下（约 2 秒，这时没有按钮），洗牌，然后牌背朝上、出现「返回游戏(N)」倒计时。
    // 实测一出现就点「返回游戏」：游戏马上自己翻开每排第一张牌（和倒计时完一样领到），约 3 秒后回地图并重新打开组队副本窗口，
    // 本日奖励次数减 1。比等倒计时快约 25 秒。
    // 「战斗结算!」标题：稳定后 1.0（入场动画 0.77 以上），其他画面最高 0.21
    "TeamDungeonSettleTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/SettleTitle.png",
                "roi": [ 540, 160, 260, 90 ],
                "threshold": 0.7
            }
        }
