    // 窗口还在最前面（没有提示框）：上一下没点上，再点
    "TeamDungeonEnterAgain": {
        "max_hit": 4,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront", "TeamDungeonAllTab", "TeamDungeonDailyLeft" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": "TeamDungeonCardFound",
                "target_offset": [ 80, 30, 76, -16 ]
            }
        },
        "post_delay": 1500, // 同上
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：点了副本卡片，没有弹出确认框，也没有进入战斗"
        },
        "timeout": 30000,
        "next": [ "TeamDungeonSoloConfirm", "TeamDungeonBattleStart", "TeamDungeonAutoOn", "TeamDungeonAutoOff", "TeamDungeonEnterAgain" ]
    },
    // 已达安全上限（还有次数，但不再点）：关窗口，再让任务失败
    "TeamDungeonRunsCapped": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront", "TeamDungeonDailyLeft" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 214, 10, 10 ]
            }
        },
        "timeout": 5000,
        "next": [ "TeamDungeonCappedClosed" ]
    },
    "TeamDungeonCappedClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowAny" ]
            }
        },
        "inverse": true,
        "next": [ "TeamDungeonCappedFailed" ]
    },
    "TeamDungeonCappedFailed": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "组队副本失败：已经进了 8 次副本，本日奖励次数仍未用完（安全上限），请检查次数是否识别正确"
        }
    },
    // 单人提示框「当前没有队伍或队伍未满，是否确定进入组队副本?」（1.0，其他画面最高 0.26）。
    // 勾过「本次登录不再提示」就不弹，直接进战斗，所以它只是可能出现的一步
    "TeamDungeonSoloText": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/SoloPopupText.png",
                "roi": [ 540, 365, 260, 35 ],
                "threshold": 0.8
            }
        }
    },
    // 点「确认进入」（只点按钮中间的字，避开两端尖角）
    "TeamDungeonSoloConfirm": {
        "max_hit": 24, // 每场一次，没点上时每场最多补 2 下
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonSoloText" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 598, 406, 44, 12 ]
            }
        },
        "post_delay": 1000, // 点上后提示框立刻消失、进入战斗载入；1 秒后还在才算没点上
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：点了「确认进入」，30 秒内没有进入战斗"
        },
        "timeout": 30000,
        "next": [ "TeamDungeonBattleStart", "TeamDungeonAutoOn", "TeamDungeonAutoOff", "TeamDungeonSoloConfirm" ]
    },

    // ===== 战斗：确认托管 / 加速已开，然后等结束 =====
    // 进战斗约 3 秒后出现「开战(5)」「战前布阵」两个按钮，倒计时完游戏也会自己开战；这里一出现就点「开战」。
    // 模板和强者降临共用（只截「开战」二字，倒计时数字每秒在变）：这里 0.91。没点上也不补点：倒计时完自己会开打，照样等到托管按钮
    "TeamDungeonBattleStart": {
        "max_hit": 20,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "powerfulBoss/BattleStart.png",
                "roi": [ 560, 430, 220, 50 ],
                "threshold": 0.85
            }
