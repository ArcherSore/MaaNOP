            "param": {
                "template": "teamDungeon/ReturnGame.png",
                "roi": [ 810, 575, 120, 40 ],
                "threshold": 0.8
            }
        }
    },
    // 第一排第一张牌的牌背「封」：没翻时 1.0，翻开后 0.22 以下（洗牌动画中途 0.71~0.83，那时还没有按钮）
    "TeamDungeonCardBack": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "teamDungeon/CardBack.png",
                "roi": [ 445, 250, 90, 120 ],
                "threshold": 0.85
            }
        }
    },
    // 牌背朝上、按钮在：点「返回游戏」（只点按钮中间，避开两端尖角）
    "TeamDungeonSettleReturn": {
        "max_hit": 30,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonSettleTitle", "TeamDungeonCardBack", "TeamDungeonReturnButton" ],
                "box_index": 2
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 838, 589, 56, 10 ]
            }
        },
        "post_delay": 1000, // 点上后翻牌动画要一点时间才开始；1 秒后牌背还在、按钮还在才算没点上
        "focus": {
            "Node.Recognition.Succeeded": "组队副本胜利",
            "Node.PipelineNode.Failed": "组队副本失败：胜利结算后没有回到组队副本窗口，可能出现了没见过的界面（如精英忍者，见截图）"
        },
        "timeout": 60000,
        "next": [
            "TeamDungeonWindow",
            "TeamDungeonSettleReturn",
            "TeamDungeonEliteNotice",
            "TeamDungeonEliteStart",
            "TeamDungeonEliteAutoOn",
            "TeamDungeonEliteAutoOff",
            "TeamDungeonMapIdle1"
        ]
    },
    // 只认出结算标题（牌正面亮着 / 洗牌中 / 按钮还没出来）：等按钮出来再点；按钮一直不出来就等游戏自己回窗口
    "TeamDungeonSettleSeen": {
        "max_hit": 20,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonSettleTitle" ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：胜利结算后没有回到组队副本窗口，可能出现了没见过的界面（如精英忍者，见截图）"
        },
        "timeout": 120000,
        "next": [
            "TeamDungeonSettleReturn",
            "TeamDungeonWindow",
            "TeamDungeonEliteNotice",
            "TeamDungeonEliteStart",
            "TeamDungeonEliteAutoOn",
            "TeamDungeonEliteAutoOff",
            "TeamDungeonMapIdle1"
        ]
    },
    // 没经过结算界面就回到了组队副本窗口：战斗输了（不扣奖励次数）。不再打：同样的队伍和难度还是会输
    "TeamDungeonBattleLost": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonWindowFront" ]
            }
        },
        "next": [ "TeamDungeonBattleLostFailed" ]
    },
    "TeamDungeonBattleLostFailed": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "组队副本失败：战斗失败（不扣奖励次数），请换更强的队伍或降低难度"
        }
    },

    // ===== 精英忍者（没实测过，按猜测处理） =====
    // 不在战斗里（看不到托管按钮）时，屏幕中间出现「精英」两个字：没见过的精英忍者界面，不乱点，停下来让用户看
    "TeamDungeonBattleHud": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "common/battle/AutoOn.png",
                    "common/battle/AutoOnHover.png",
                    "common/battle/AutoOff.png",
                    "common/battle/AutoOffHover.png"
                ],
                "roi": [ 828, 620, 80, 80 ]
            }
        }
    },
    "TeamDungeonEliteText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 330, 220, 680, 400 ],
                "expected": [ "精英" ]
            }
        }
    },
    "TeamDungeonEliteNotice": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "TeamDungeonEliteText",
                    "without": "TeamDungeonBattleHud"
                }
            }
        },
        "next": [ "TeamDungeonEliteUnknown" ]
    },
    "TeamDungeonEliteUnknown": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "组队副本停止：出现了精英忍者界面（还没适配），请手动处理并把截图发给开发者"
        }
    },
    // 结算之后又进了战斗：当作精英忍者战，照常托管 + 加速打完；打完回到结算或直接回窗口都接着做下一场（输了也不算任务失败，副本本身已经赢了）
    "TeamDungeonEliteStart": {
        "max_hit": 10,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "powerfulBoss/BattleStart.png",
                "roi": [ 560, 430, 220, 50 ],
                "threshold": 0.85
            }
        },
        "action": "Click",
        "focus": {
            "Node.Recognition.Succeeded": "结算后又进入一场战斗（可能是精英忍者），继续托管"
        },
        "timeout": 20000,
        "next": [ "TeamDungeonEliteAutoOn", "TeamDungeonEliteAutoOff" ]
    },
    "TeamDungeonEliteAutoOn": {
        "max_hit": 10,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOn.png", "common/battle/AutoOnHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "结算后又进入一场战斗（可能是精英忍者），继续托管"
        },
        "next": [ "TeamDungeonEliteSpeedOn", "TeamDungeonEliteSpeedOff" ]
    },
    "TeamDungeonEliteAutoOff": {
        "max_hit": 10,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOff.png", "common/battle/AutoOffHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": "Click",
        "focus": {
            "Node.Recognition.Succeeded": "结算后又进入一场战斗（可能是精英忍者），继续托管"
        },
        "next": [ "TeamDungeonEliteSpeedOn", "TeamDungeonEliteSpeedOff" ]
    },
    "TeamDungeonEliteSpeedOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOn.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "next": [ "TeamDungeonEliteWait" ]
    },
    "TeamDungeonEliteSpeedOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOff.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "action": "Click",
        "next": [ "TeamDungeonEliteWait" ]
    },
    "TeamDungeonEliteWait": {
        "focus": {
            "Node.PipelineNode.Failed": "组队副本失败：结算后的那场战斗（可能是精英忍者）10 分钟没有结束，或出现了没见过的界面（见截图）"
        },
        "timeout": 600000,
        "next": [ "TeamDungeonSettleReturn", "TeamDungeonSettleSeen", "TeamDungeonWindow", "TeamDungeonEliteNotice" ]
    },

    // ===== 结算后没有自己重新打开组队副本窗口：地图连续约 9 秒没有窗口，就从日常锻炼重新进 =====
    // 点「返回游戏」后会先露出约 1~2 秒地图，窗口再淡入，这里会先命中。所以每 1.5 秒看一次窗口回来没有，
    // 连续 6 次都只有地图才走日常锻炼（以前一下等 5 秒，窗口早就回来了也要干等）。只能靠时间区分，所以用 post_delay 隔开
    "TeamDungeonMapIdle1": {
        "max_hit": 10, // 安全上限：每场最多一次
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonMapClear" ]
            }
        },
        "post_delay": 1500,
        "next": [ "TeamDungeonWindow", "TeamDungeonMapIdle2" ]
    },
    "TeamDungeonMapIdle2": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonMapClear" ]
            }
        },
        "post_delay": 1500,
        "next": [ "TeamDungeonWindow", "TeamDungeonMapIdle3" ]
    },
    "TeamDungeonMapIdle3": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonMapClear" ]
            }
        },
        "post_delay": 1500,
        "next": [ "TeamDungeonWindow", "TeamDungeonMapIdle4" ]
    },
    "TeamDungeonMapIdle4": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonMapClear" ]
            }
        },
        "post_delay": 1500,
        "next": [ "TeamDungeonWindow", "TeamDungeonMapIdle5" ]
    },
    "TeamDungeonMapIdle5": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonMapClear" ]
            }
        },
        "post_delay": 1500,
        "next": [ "TeamDungeonWindow", "TeamDungeonMapIdle6" ]
    },
    "TeamDungeonMapIdle6": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TeamDungeonMapClear" ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "结算后组队副本窗口没有自动打开，从日常锻炼重新进入"
        },
        "timeout": 10000,
        "next": [ "TeamDungeonWindow", "TeamDungeonOpenDaily" ]
    }
}
