        "next": [ "TeamDungeonBattleWait" ]
    },
    "TeamDungeonSpeedOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOff.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "action": "Click",
        "next": [ "TeamDungeonBattleWait" ]
    },
    // 等战斗结束（托管 + 二倍速约 1 分钟；不托管一倍速打了 3 分半）。
    // 打赢：「战斗结算!」翻牌界面；打输：只闪一下败北，直接回到组队副本窗口。
    // 精英忍者如果是接着再打一场：战斗画面一直在，这里就接着等；中途托管 / 加速被重置成关就再打开
    "TeamDungeonBattleWait": {
        "focus": {
