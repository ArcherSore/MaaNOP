// 固定选择第一项，不识别答案；每题超时 30 秒由游戏判错并切换。
// 已完成项目沉到列表底部；列表不响应滚轮。
{
    "NinjaQuiz": {
        "timeout": 15000,
        "next": [ "QuizClaim", "QuizClaimed", "QuizSubmit", "QuizPickA", "QuizStartDialog", "QuizOpenDaily" ]
    },
    "QuizOpenDaily": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EnterDailyTask",
                "custom_action_param": {
                    "row": "QuizRow",
                    "title": "QuizPanelTitle"
                }
            }
        },
        "next": [ "QuizJoin", "QuizAlreadyDone" ]
    },
    // 列表行模板实测：普通/悬停/选中/已完成均 ≥0.9，其他行最高 0.55。
    "QuizRow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ninjaQuiz/QuizRow.png",
                "roi": [ 355, 240, 390, 275 ],
                "threshold": 0.8
            }
        }
    },
    "QuizPanelTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ninjaQuiz/PanelTitle.png",
                "roi": [ 760, 232, 90, 32 ],
                "threshold": 0.85
            }
        }
    },
    "QuizJoin": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyJoinAvailable" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 834, 494, 40, 13 ]
            }
        },
        "next": [ "QuizStartDialog" ]
    },
    "QuizAlreadyDone": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyJoinUnavailable" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 184, 8, 8 ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "今天的忍者测验已经做完了，跳过"
        },
        "timeout": 5000,
        "next": [ "QuizDailyClosed" ]
    },
    "QuizDailyClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyTab" ]
            }
        },
        "inverse": true
    },
    "QuizStartDialog": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "ninjaQuiz/ExaminerName.png",
                                "roi": [ 450, 475, 100, 40 ],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "ninjaQuiz/StartQuiz.png",
                                "roi": [ 575, 400, 90, 40 ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        // 测验窗口有约 2 秒开场动画，之后才出现第一题。
        "timeout": 15000,
        "next": [ "QuizPickA", "QuizSubmit", "QuizClaim", "QuizClaimed" ]
    },
    // 窗口底部说明在答题和结算时均可见，且不被奖励飘字遮挡。
    "QuizWindowHint": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ninjaQuiz/QuizHint.png",
                "roi": [ 760, 545, 170, 50 ],
                "threshold": 0.85
            }
        }
    },
    // 选项左半段避开文字；未选为浅色、已选为暗色，均为 420 像素。
    // 切题过场与结算时两种颜色均接近 0。
    "QuizOptionAFresh": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 560, 390, 35, 12 ],
                "method": 40,
                "lower": [ 10, 40, 215 ],
                "upper": [ 35, 140, 255 ],
                "count": 300
            }
        }
    },
    "QuizOptionAPicked": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 560, 390, 35, 12 ],
                "method": 40,
                "lower": [ 10, 60, 90 ],
                "upper": [ 35, 200, 190 ],
                "count": 300
            }
        }
    },
    // 对错标记像素实测：红叉约 160、绿勾约 720，未提交为 0。
    "QuizAnswerMark": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 600, 376, 90, 42 ],
                "method": 40,
                "lower": [ [ 0, 150, 120 ], [ 170, 150, 120 ], [ 35, 120, 80 ] ],
                "upper": [ [ 8, 255, 255 ], [ 180, 255, 255 ], [ 85, 255, 255 ] ],
                "count": 60
            }
        }
    },
    // 窗口不在前台时选项点击可能丢失。
    // 共 10 题，max_hit 为丢失点击预留重试余量。
    "QuizPickA": {
        "max_hit": 30,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "QuizWindowHint", "QuizOptionAFresh" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 560, 389, 170, 14 ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [ 530, 370, 230, 200 ],
            "rate_limit": 100
        },
        "focus": {
            "Node.PipelineNode.Failed": "忍者测验失败：点了第一个选项，但它没有被选中"
        },
        "timeout": 10000,
        "next": [ "QuizSubmit", "QuizPickA" ]
    },
    // 提交后约 1 秒内出对错标记；切题后选项恢复浅色，最后一题后进入结算。
    "QuizSubmit": {
        "max_hit": 30,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "QuizPickedUnanswered",
                    "without": "QuizAnswerMark"
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 618, 530, 56, 22 ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [ 530, 370, 230, 200 ],
            "rate_limit": 100
        },
        "focus": {
            "Node.PipelineNode.Failed": "忍者测验失败：提交后没有出现下一题或结算面板"
        },
        "timeout": 10000,
        "next": [ "QuizPickA", "QuizClaim", "QuizSubmit" ]
    },
    "QuizPickedUnanswered": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "QuizWindowHint", "QuizOptionAPicked" ]
            }
        }
    },

    // 六边形领取按钮仅中部 x 635~676 可点，两端尖角和卷纹不可点。
    // 橙色像素实测：可领取约 390，已领为 0；同位置开场图标约 260，需先用模板排除。
    // 按钮模板实测：橙色 1.0、灰色 0.81，开场动画等画面 ≤0.43。
    "QuizClaim": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "QuizWindowHint",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "ninjaQuiz/ClaimButton.png",
                                "roi": [ 600, 475, 110, 50 ],
                                "threshold": 0.9
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [ 636, 493, 40, 15 ],
                                "method": 40,
                                "lower": [ 3, 190, 150 ],
                                "upper": [ 30, 255, 255 ],
                                "count": 200
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 639, 495, 34, 11 ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [ 600, 470, 120, 60 ],
            "rate_limit": 100
        },
        "max_hit": 3,
        "focus": {
            "Node.PipelineNode.Failed": "忍者测验失败：点了领取，但按钮没有变灰"
        },
        "timeout": 5000,
        "next": [ "QuizClaimed", "QuizClaim" ]
    },
    // 已领模板仅取按钮面：灰色 1.0，橙色 0.81。
    "QuizClaimed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "QuizWindowHint",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "ninjaQuiz/ClaimedButton.png",
                                "roi": [ 600, 475, 110, 50 ],
                                "threshold": 0.9
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 915, 273, 8, 8 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "忍者测验：奖励已领取，但测验窗口关不上"
        },
        "timeout": 5000,
        "next": [ "QuizWindowClosed" ]
    },
    "QuizWindowClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "QuizWindowHint" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "忍者测验已完成"
        }
    }
}
