// 固定选择第一项，不识别答案；每题超时 30 秒由游戏判错并切换。
{
    "NinjaQuiz": {
        "next": [ "QuizOpenDaily" ]
    },
    "QuizOpenDaily": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EnterDailyTask",
                "custom_action_param": {
                    "row": "QuizRow",
                    "title": "QuizPanelTitle"
                }
            }
        },
        "next": [ "QuizJoin", "QuizAlreadyDone" ]
    },
    // 行模板兼容普通、悬停、选中和已完成状态。
    "QuizRow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ninjaQuiz/QuizRow.png",
                "roi": [ 355, 219, 390, 275 ],
                "threshold": 0.8
            }
        }
    },
    "QuizPanelTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ninjaQuiz/PanelTitle.png",
                "roi": [ 760, 211, 90, 32 ],
                "threshold": 0.85
            }
        }
    },
    "QuizJoin": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyJoinAvailable" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 834, 473, 40, 13 ]
            }
        },
        "next": [ "QuizStartDialog" ]
    },
    "QuizAlreadyDone": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyJoinUnavailable" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 985, 163, 8, 8 ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "今天的忍者测验已经做完了，跳过"
        },
        "timeout": 5000,
        "next": [ "QuizDailyClosed" ]
    },
    "QuizDailyClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "DailyTab" ]
            }
        },
        "inverse": true
    },
    "QuizStartDialog": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "ninjaQuiz/ExaminerName.png",
                                "roi": [ 450, 454, 100, 40 ],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "ninjaQuiz/StartQuiz.png",
                                "roi": [ 575, 379, 90, 40 ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        // 测验窗口有约 2 秒开场动画，之后才出现第一题。
        "timeout": 15000,
        "next": [ "QuizPickA" ]
    },
    // 窗口底部说明在答题和结算时均可见，且不被奖励飘字遮挡。
    "QuizWindowHint": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "ninjaQuiz/QuizHint.png",
                "roi": [ 760, 524, 170, 50 ],
                "threshold": 0.85
            }
        }
    },
    // 选项左侧避开文字；浅色表示未选，暗色表示已选，过场与结算均不匹配。
    "QuizOptionAFresh": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 560, 369, 35, 12 ],
                "method": 40,
                "lower": [ 10, 40, 215 ],
                "upper": [ 35, 140, 255 ],
                "count": 300
            }
        }
    },
    "QuizOptionAPicked": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 560, 369, 35, 12 ],
                "method": 40,
                "lower": [ 10, 60, 90 ],
                "upper": [ 35, 200, 190 ],
                "count": 300
            }
        }
    },
    // 对错标记用于排除已提交、尚未切题的状态，避免重复提交。
    "QuizAnswerMark": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 600, 355, 90, 42 ],
                "method": 40,
                "lower": [ [ 0, 150, 120 ], [ 170, 150, 120 ], [ 35, 120, 80 ] ],
                "upper": [ [ 8, 255, 255 ], [ 180, 255, 255 ], [ 85, 255, 255 ] ],
                "count": 60
            }
        }
    },
    // 共 10 题，max_hit 为丢失点击预留重试余量。
    "QuizPickA": {
        "max_hit": 30,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "QuizWindowHint", "QuizOptionAFresh" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 560, 368, 170, 14 ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [ 530, 349, 230, 200 ],
            "rate_limit": 100
        },
        "focus": {
            "Node.PipelineNode.Failed": "未能选择答案，请检查游戏画面后重试"
        },
        "timeout": 10000,
        "next": [ "QuizSubmit", "QuizPickA" ]
    },
    // 提交后约 1 秒内出对错标记；切题后选项恢复浅色，最后一题后进入结算。
    "QuizSubmit": {
        "max_hit": 30,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "MatchWithout",
                "custom_recognition_param": {
                    "match": "QuizPickedUnanswered",
                    "without": "QuizAnswerMark"
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 618, 509, 56, 22 ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [ 530, 349, 230, 200 ],
            "rate_limit": 100
        },
        "focus": {
            "Node.PipelineNode.Failed": "未能继续答题或进入领奖，请检查游戏画面后重试"
        },
        "timeout": 10000,
        "next": [ "QuizPickA", "QuizClaim", "QuizSubmit" ]
    },
    "QuizPickedUnanswered": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "QuizWindowHint", "QuizOptionAPicked" ]
            }
        }
    },

    // 六边形领取按钮仅中部 x 635~676 可点，两端尖角和卷纹不可点。
    // 颜色区分可领取状态；模板排除同位置的橙色开场动画。
    "QuizClaim": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "QuizWindowHint",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "ninjaQuiz/ClaimButton.png",
                                "roi": [ 600, 454, 110, 50 ],
                                "threshold": 0.9
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [ 636, 472, 40, 15 ],
                                "method": 40,
                                "lower": [ 3, 190, 150 ],
                                "upper": [ 30, 255, 255 ],
                                "count": 200
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 639, 474, 34, 11 ]
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [ 600, 449, 120, 60 ],
            "rate_limit": 100
        },
        "max_hit": 3,
        "focus": {
            "Node.PipelineNode.Failed": "未能领取奖励，请检查游戏画面后重试"
        },
        "timeout": 5000,
        "next": [ "QuizClaimed", "QuizClaim" ]
    },
    // 已领模板仅取灰色按钮面，确认领取成功后再关闭。
    "QuizClaimed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "QuizWindowHint",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "ninjaQuiz/ClaimedButton.png",
                                "roi": [ 600, 454, 110, 50 ],
                                "threshold": 0.9
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 915, 252, 8, 8 ]
            }
        },
        "focus": {
            "Node.PipelineNode.Failed": "奖励已领取，但未能关闭窗口，请手动关闭后继续其他任务"
        },
        "timeout": 5000,
        "next": [ "QuizWindowClosed" ]
    },
    "QuizWindowClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "QuizWindowHint" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "忍者测验已完成"
        }
    }
}
