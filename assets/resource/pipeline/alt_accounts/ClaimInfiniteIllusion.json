{
    "ClaimInfiniteIllusionEntry": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "next": [ "ClickOnInfiniteIllusion" ],
        "on_error": [ "SkipInfiniteIllusion" ]
    },
    "SkipInfiniteIllusion": {
        "pre_delay": 0,
        "post_delay": 0,
        "focus": {
            "Node.Recognition.Succeeded": "无限幻象未解锁！52级解锁！"
        },
        "next": [ "ClaimMailEntry", "ClaimLevelEntry", "ClaimAnniversarySigninEntry", "BatchServerDone" ]
    },
    "ClickOnInfiniteIllusion": {
        "rate_limit": 200,
        "timeout": 5000,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": "alt_accounts/infinite_illusion/InfiniteIllusion.png"
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "InfiniteIllusionTrial1" ],
        "on_error": [ "ClickOnInfiniteIllusion" ]
    },
    "InfiniteIllusionSweep1": {
        "rate_limit": 200,
        "timeout": 5000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionTrial1Flag", "InfiniteIllusionSweepOrange" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 969, 607, 51, 19 ]
            }
        },
        "next": [ "InfiniteIllusionConfirm1", "[JumpBack]HandleConfirmPopup" ],
        "on_error": [ "InfiniteIllusionSweep1" ]
    },
    "InfiniteIllusionConfirm1": {
        "timeout": 5000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/CloseButton.png",
                "roi": [ 833, 250, 68, 67 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "InfiniteIllusionSwitchTo2" ],
        "on_error": [ "InfiniteIllusionConfirm1" ]
    },
    "InfiniteIllusionSwitchTo2": {
        "timeout": 5000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/Tab2.png",
                "roi": [ 440, 73, 135, 118 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": [ "InfiniteIllusionTrial2" ],
        "on_error": [ "InfiniteIllusionSwitchTo2" ]
    },
    "InfiniteIllusionSweep2": {
        "rate_limit": 200,
        "timeout": 5000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionTrial2Flag", "InfiniteIllusionSweepOrange" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 969, 607, 51, 19 ]
            }
        },
        "next": [ "InfiniteIllusionConfirm2", "[JumpBack]HandleConfirmPopup" ],
        "on_error": [ "InfiniteIllusionSweep2" ]
    },
    "InfiniteIllusionConfirm2": {
        "timeout": 5000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/CloseButton.png",
                "roi": [ 833, 250, 68, 67 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "InfiniteIllusionSwitchTo3" ],
        "on_error": [ "InfiniteIllusionConfirm2" ]
    },
    "InfiniteIllusionSwitchTo3": {
        "timeout": 5000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/Tab3.png",
                "roi": [ 504, 72, 133, 136 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": [ "InfiniteIllusionTrial3" ],
        "on_error": [ "InfiniteIllusionSwitchTo3" ]
    },
    "InfiniteIllusionSweep3": {
        "timeout": 5000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionTrial3Flag", "InfiniteIllusionSweepOrange" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 969, 607, 51, 19 ]
            }
        },
        "next": [ "InfiniteIllusionConfirm3", "[JumpBack]HandleConfirmPopup" ],
        "on_error": [ "InfiniteIllusionSweep3" ]
    },
    "InfiniteIllusionConfirm3": {
        "timeout": 5000,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/CloseButton.png",
                "roi": [ 833, 250, 68, 67 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "ExitInfiniteIllusion" ],
        "on_error": [ "InfiniteIllusionConfirm3" ]
    },
    "InfiniteIllusionTrial1Flag": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/Flag.png",
                "roi": [ 441, 66, 62, 64 ]
            }
        }
    },
    "InfiniteIllusionTrial2Flag": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/Flag.png",
                "roi": [ 502, 67, 64, 63 ]
            }
        }
    },
    "InfiniteIllusionTrial3Flag": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/Flag.png",
                "roi": [ 566, 65, 63, 63 ]
            }
        }
    },
    "InfiniteIllusionTrial1": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionTrial1Flag" ]
            }
        },
        "anchor": {
            "InfiniteIllusionSweepTarget": "InfiniteIllusionSweep1",
            "InfiniteIllusionTrialDone": "InfiniteIllusionSwitchTo2",
            "InfiniteIllusionBattleReturn": "InfiniteIllusionBattleReturn1"
        },
        "timeout": 10000,
        "next": [ "InfiniteIllusionSweepReady" ]
    },
    "InfiniteIllusionTrial2": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionTrial2Flag" ]
            }
        },
        "anchor": {
            "InfiniteIllusionSweepTarget": "InfiniteIllusionSweep2",
            "InfiniteIllusionTrialDone": "InfiniteIllusionSwitchTo3",
            "InfiniteIllusionBattleReturn": "InfiniteIllusionBattleReturn2"
        },
        "timeout": 10000,
        "next": [ "InfiniteIllusionSweepReady" ]
    },
    "InfiniteIllusionTrial3": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionTrial3Flag" ]
            }
        },
        "anchor": {
            "InfiniteIllusionSweepTarget": "InfiniteIllusionSweep3",
            "InfiniteIllusionTrialDone": "ExitInfiniteIllusion",
            "InfiniteIllusionBattleReturn": "InfiniteIllusionBattleReturn3"
        },
        "timeout": 10000,
        "next": [ "InfiniteIllusionSweepReady" ]
    },
    "InfiniteIllusionSweepReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 963, 604, 65, 24 ],
                "only_rec": true,
                "expected": "扫荡"
            }
        },
        // 先确认按钮已出现，再分别识别橙色和灰色；识别不到橙色不能直接视作灰色。
        "timeout": 5000,
        "next": [ "[Anchor]InfiniteIllusionSweepTarget", "InfiniteIllusionChallenge" ]
    },
    "InfiniteIllusionSweepOrange": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 968, 608, 53, 17 ],
                "method": 40,
                "lower": [ 0, 90, 100 ],
                "upper": [ 30, 255, 255 ],
                "count": 300
            }
        }
    },
    "InfiniteIllusionSweepGray": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 968, 608, 53, 17 ],
                "method": 40,
                "lower": [ 0, 0, 60 ],
                "upper": [ 180, 65, 235 ],
                "count": 500
            }
        }
    },
    "InfiniteIllusionChallengeButton": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/Challenge.png",
                "roi": [ 1040, 540, 150, 150 ],
                "threshold": 0.8
            }
        }
    },
    "InfiniteIllusionChallenge": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionSweepGray", "InfiniteIllusionChallengeButton" ],
                "box_index": 1
            }
        },
        "action": "Click",
        "anchor": {
            "CommonBattleStartTarget": "InfiniteIllusionBattleStart",
            "CommonBattleOutcome": "InfiniteIllusionBattleOutcome",
            "CommonBattleContinue": "InfiniteIllusionBattleWait",
            "CommonBattleInterrupt": "CommonBattleNoInterrupt"
        },
        "timeout": 20000,
        // 开战倒计时可能自行结束，须同时接住已经进入战斗的状态。
        "next": [ "[Anchor]CommonBattleOutcome", "InfiniteIllusionBattleStart", "CommonBattleAutoOn", "CommonBattleAutoOff" ]
    },
    "InfiniteIllusionBattleStart": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "CommonBattleStartButton" ]
            }
        },
        "next": [ "CommonBattleClickStart" ]
    },
    "InfiniteIllusionBattleWait": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 600000,
        "next": [ "[Anchor]CommonBattleOutcome" ]
    },
    "InfiniteIllusionBattleOutcome": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [ "InfiniteIllusionBattleResultConfirm", "InfiniteIllusionBattleSettlement" ]
            }
        },
        "next": [ "InfiniteIllusionBattleResultConfirm", "InfiniteIllusionBattleSettlement" ]
    },
    "InfiniteIllusionBattleResultConfirm": {
        "recognition": {
            "type": "OCR",
            "param": {
                // 与公共开战 OCR 的 ROI 分开，避免候选列表中区域重叠。
                "roi": [ 625, 444, 90, 18 ],
                "expected": "^确认$"
            }
        },
        "action": "Click",
        "timeout": 10000,
        "next": [ "InfiniteIllusionBattleSettlement", "[Anchor]InfiniteIllusionBattleReturn" ]
    },
    "InfiniteIllusionBattleSettlement": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/SettlementTitle.png",
                "roi": [ 590, 235, 150, 65 ],
                "threshold": 0.8
            }
        },
        "timeout": 10000,
        "next": [ "InfiniteIllusionBattleSettlementReturn", "[Anchor]InfiniteIllusionBattleReturn" ]
    },
    "InfiniteIllusionBattleSettlementReturn": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 620, 438, 110, 28 ],
                "expected": "返[回网]游戏"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 643, 445, 44, 10 ]
            }
        },
        "timeout": 10000,
        "next": [ "[Anchor]InfiniteIllusionBattleReturn" ]
    },
    "InfiniteIllusionBattleReturn1": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionTrial1Flag" ]
            }
        },
        "next": [ "InfiniteIllusionBattleRecheck" ]
    },
    "InfiniteIllusionBattleReturn2": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionTrial2Flag" ]
            }
        },
        "next": [ "InfiniteIllusionBattleRecheck" ]
    },
    "InfiniteIllusionBattleReturn3": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionTrial3Flag" ]
            }
        },
        "next": [ "InfiniteIllusionBattleRecheck" ]
    },
    "InfiniteIllusionBattleRecheck": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionSweepReady" ]
            }
        },
        // 战后橙色只代表本试炼完成，不能回到首次进入时的扫荡分流。
        "timeout": 10000,
        "next": [ "InfiniteIllusionBattleDone", "InfiniteIllusionChallenge" ]
    },
    "InfiniteIllusionBattleDone": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionSweepOrange" ]
            }
        },
        "next": [ "[Anchor]InfiniteIllusionTrialDone" ]
    },
    "ExitInfiniteIllusion": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/infinite_illusion/CloseButton.png",
                "roi": [ 1107, 56, 69, 67 ]
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "ClaimMailEntry", "ClaimLevelEntry", "ClaimAnniversarySigninEntry", "BatchServerDone" ]
    },
    "HandleConfirmPopup": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "IllusionLowRewardWarning", "IllusionWarningConfirmText" ]
            }
        },
        "next": [ "InfiniteIllusionSweepResultVisible", "CloseConfirmPopup", "CheckIllusionWarning" ]
    },
    "InfiniteIllusionSweepResultVisible": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "InfiniteIllusionConfirm1" ]
            }
        }
    },
    "IllusionWarningChecked": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 570, 426, 15, 15 ],
                "method": 40,
                "lower": [ 35, 120, 100 ],
                "upper": [ 85, 255, 255 ],
                "count": 20
            }
        }
    },
    "IllusionWarningUnchecked": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 572, 430, 7, 8 ],
                "method": 4,
                "lower": [ 10, 10, 10 ],
                "upper": [ 60, 60, 60 ],
                "count": 40
            }
        }
    },
    "CheckIllusionWarning": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "IllusionLowRewardWarning", "IllusionWarningConfirmText", "IllusionWarningUnchecked" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 574, 431, 5, 5 ]
            }
        },
        "timeout": 5000,
        "next": [ "InfiniteIllusionSweepResultVisible", "CloseConfirmPopup" ]
    },
    "CloseConfirmPopup": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "IllusionLowRewardWarning",
                    "IllusionWarningConfirmText",
                    "IllusionWarningChecked"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "IllusionLowRewardWarning": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "您的战力已有大幅度提升",
                "roi": [ 557, 352, 225, 37 ]
            }
        }
    },
    "IllusionWarningConfirmText": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "^确定$",
                "roi": [ 574, 393, 74, 23 ]
            }
        }
    }
}
