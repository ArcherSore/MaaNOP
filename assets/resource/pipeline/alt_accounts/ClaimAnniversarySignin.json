{
    "ClaimAnniversarySigninEntry": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EnterHotspotActivity",
                "custom_action_param": {
                    "expected": "薪火签[到至]"
                }
            }
        },
        "timeout": 10000,
        "next": [ "AnniversarySigninDone", "AnniversarySigninClaimedColor", "AnniversarySigninClaimColor" ]
    },
    // 先分颜色再读字，避免两个候选的 OCR ROI 重叠；灰色按钮也有“领取”大字。
    "AnniversarySigninClaimColor": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 575, 400, 8, 22 ],
                "method": 40,
                "lower": [ 18, 150, 120 ],
                "upper": [ 40, 255, 255 ],
                "count": 120
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [ 617, 412, 1, 1 ],
                "end": [ 617, 412, 1, 1 ],
                "duration": 100,
                "only_hover": true
            }
        },
        "next": [ "AnniversarySigninClaim" ]
    },
    "AnniversarySigninClaimedColor": {
        "rate_limit": 200,
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [ 575, 400, 8, 22 ],
                "method": 40,
                "lower": [ 0, 0, 120 ],
                "upper": [ 179, 50, 255 ],
                "count": 120
            }
        },
        "next": [ "AnniversarySigninClaimed" ]
    },
    "AnniversarySigninClaim": {
        "rate_limit": 200,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [ 680, 405, 8, 18 ],
                                "method": 40,
                                "lower": [ 16, 150, 175 ],
                                "upper": [ 42, 255, 255 ],
                                "count": 90
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 550, 385, 145, 55 ],
                                "expected": "^领取$"
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 585, 402, 65, 20 ]
            }
        },
        "timeout": 10000,
        "next": [ "AnniversarySigninClaimedColor" ]
    },
    "AnniversarySigninClaimed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AnniversarySigninClaimedColor",
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 640, 399, 47, 35 ],
                                "expected": "^已领取$"
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 935, 208, 8, 8 ]
            }
        },
        "timeout": 10000,
        "next": [ "AnniversarySigninDone" ]
    },
    "AnniversarySigninDone": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "LoginMapVisible" ]
            }
        },
        "next": [ "BatchServerDone" ]
    }
}
