{
    "ClaimLevelEntry": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "ClaimLevel" ]
    },
    "ClaimLevel": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "ClickOnWelfare" ]
    },
    "ClickOnWelfare": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": [ "common/entry/SystemGift.png" ]
                }
            }
        },
        "action": {
            "type": "Click"
        },
        "next": [ "AtClaimLevel", "NoAtClaimLevel" ]
    },
    "NoAtClaimLevel": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/claim_level/OffClaimLevel.png",
                "roi": [ 357, 402, 157, 116 ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "PreciseClick"
            }
        },
        "next": [ "AtClaimLevel" ]
    },
    "AtClaimLevel": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "alt_accounts/claim_level/FlagClaimLevel.png",
                "roi": [ 456, 268, 180, 115 ]
            }
        },
        "next": [ "EnsureClaimLevel", "NoNeedClaimLevel", "NeedClaimLevel" ]
    },
    "NoNeedClaimLevel": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "无可追[回同问]资源",
                "roi": [ 642, 315, 67, 18 ],
                "only_rec": true
            }
        },
        "next": [ "ExitClaimLevel" ]
    },
    "NeedClaimLevel": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "AtClaimLevel",
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                // 第一行铜币按钮内部；需兼容悬停外观，已找回底纹及确认框遮罩下不应命中。
                                "roi": [ 752, 316, 60, 18 ],
                                "method": 40,
                                "lower": [ 85, 130, 140 ],
                                "upper": [ 115, 255, 255 ],
                                "count": 80
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 765, 322, 30, 5 ]
            }
        },
        "next": [ "EnsureClaimLevel" ]
    },
    "EnsureClaimLevel": {
        "recognition": {
            "type": "OCR",
            "param": {
                // 识别铜币经验确认正文，避免单字「是」漂移或误认其它确认框。
                "expected": "是否花费[0-9]+铜币.*经验奖励",
                "roi": [ 550, 354, 240, 35 ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 595, 405, 30, 5 ]
            }
        },
        "next": [ "ClaimLevelConfirmed", "ClaimLevelUpgradePopup" ]
    },
    "ClaimLevelUpgradePopup": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/hotspot/CloseX.png",
                "roi": [ 800, 265, 45, 45 ],
                "threshold": 0.8
            }
        },
        "next": [ "ExitClaimLevel" ]
    },
    "ClaimLevelConfirmed": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "无可追[回同问]资源",
                "roi": [ 630, 309, 100, 35 ]
            }
        },
        "next": [ "ExitClaimLevel" ]
    },
    "ExitClaimLevel": {
        "pre_delay": 0,
        "post_delay": 0,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CloseAllPopupsWithEsc",
                "custom_action_param": {
                    "check_node": "AtClaimLevel"
                }
            }
        },
        "timeout": 5000,
        "next": [ "ClaimLevelClosed" ]
    },
    "ClaimLevelClosed": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "LoginScreenClear" ]
            }
        },
        "next": [ "ClaimAnniversarySigninEntry", "BatchServerDone" ]
    }
}
