        "post_delay": 0,
        "rate_limit": 100,
        "timeout": 8000,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EnterHotspotActivity",
                "custom_action_param": {
                    "expected": [ "任务总动员" ]
                }
            }
        },
        "next": [ "TaskMerchantProcessCard", "TaskMerchantEmptyList" ]
    },
    "TaskMerchantFirstRow": {
