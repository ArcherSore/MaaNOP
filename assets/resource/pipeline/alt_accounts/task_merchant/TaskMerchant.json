// 坐标均为 1340×720 截图坐标；[947,220] 为任务卡面板右上角关闭按钮。
{
    "TaskMerchantStart": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "TaskMerchantConfigure" ]
    },
    // attach 存各类任务的赠送阈值（要求 ≤ 阈值则赠送，0 为不赠送），由 interface.json 选项逐键覆盖。
    "TaskMerchantConfigure": {
        "pre_delay": 0,
        "post_delay": 0,
        "next": [ "TaskMerchantPrepareToolbar" ],
        "attach": {
            "survival_score": 0,
            "ranked_participation": 0,
            "wanted": 0,
            "escort": 0,
            "arena_participation": 0,
            "quiz_participation": 0
        }
    },
    // 顶部栏在整个任务开始时收起，正常结束时展开；已处于目标状态则不点击。
    // 面板开着时先关闭，否则挡住地图判断。
    "TaskMerchantPrepareToolbar": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "next": [ "TaskMerchantToolbarPanelOpen", "TaskMerchantToolbarMapReady" ]
    },
    "TaskMerchantToolbarPanelOpen": {
        "rate_limit": 100,
        "timeout": 5000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TaskMerchantFirstRow" ]
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 947, 220, 1, 1 ],
                "duration": 100
            }
        },
        "next": [ "TaskMerchantToolbarMapReady" ]
    },
    "TaskMerchantToolbarMapReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "LoginMapVisible" ]
            }
        },
        "next": [ "TaskMerchantEnsureTopToolbarCollapsed" ]
    },
    "TaskMerchantEnsureTopToolbarCollapsed": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "next": [ "TaskMerchantTopToolbarCollapsed", "TaskMerchantCollapseTopToolbar" ]
    },
    "TaskMerchantCollapseTopToolbar": {
        "timeout": 5000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TaskMerchantTopToolbarExpanded" ]
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 1179, 70, 1, 1 ],
                "duration": 100
            }
        },
        "next": [ "TaskMerchantTopToolbarCollapsed" ]
    },
    // 收起/展开箭头模板互匹配最高 0.70，含悬停正例最低 0.91。
    "TaskMerchantTopToolbarCollapsed": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [ 1169, 56, 20, 28 ],
                "template": "alt_accounts/task_merchant/top_toolbar_collapsed.png",
                "threshold": 0.85,
                "method": 5
            }
        },
        "next": [ "TaskMerchantOpenPanel" ]
    },
    "TaskMerchantTopToolbarExpanded": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [ 1169, 56, 20, 28 ],
                "template": "alt_accounts/task_merchant/top_toolbar_expanded.png",
                "threshold": 0.85,
                "method": 5
            }
        }
    },
    // 正常结束：回到地图后恢复顶部栏展开。
    "TaskMerchantComplete": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "LoginMapVisible" ]
            }
        },
        "next": [ "TaskMerchantEnsureTopToolbarExpanded" ]
    },
    "TaskMerchantEnsureTopToolbarExpanded": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 5000,
        "next": [ "TaskMerchantTopToolbarExpanded", "TaskMerchantExpandTopToolbar" ]
    },
    "TaskMerchantExpandTopToolbar": {
        "timeout": 5000,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "TaskMerchantTopToolbarCollapsed" ]
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 1179, 70, 1, 1 ],
                "duration": 100
            }
        },
        "next": [ "TaskMerchantTopToolbarExpanded" ]
    },
    // 卡片循环入口：有卡 → 分类处理；列表空 → 关闭面板去补卡；面板未打开 → 从活动入口打开。
    "TaskMerchantOpenPanel": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 8000,
        "next": [ "TaskMerchantProcessCard", "TaskMerchantEmptyList", "TaskMerchantSceneReady" ]
    },
    "TaskMerchantSceneReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "LoginMapVisible" ]
            }
        },
        "action": "DoNothing",
        "next": [ "TaskMerchantSelectTab" ]
    },
    // 从热点活动列表进入「任务总动员」面板。
    "TaskMerchantSelectTab": {
        "rate_limit": 100,
        "timeout": 8000,
        "recognition": "DirectHit",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "EnterHotspotActivity",
                "custom_action_param": {
                    "expected": [ "任务总动员" ]
                }
            }
        },
        "next": [ "TaskMerchantProcessCard", "TaskMerchantEmptyList" ]
    },
    // 面板已打开且有卡：首张卡好友输入框的占位文字。
    "TaskMerchantFirstRow": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 708, 265, 121, 18 ],
                "expected": [ "输入好友.*筛选" ]
            }
        }
    },
    "TaskMerchantEmptyList": {
        "rate_limit": 100,
        "timeout": 8000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 560, 310, 350, 100 ],
                "expected": [ "你还没有任务卡" ]
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 947, 220, 1, 1 ],
                "duration": 100
            }
        },
        "next": [ "TaskMerchantPanelClosed" ]
    },
    // 面板关闭后去找商人补卡，见 Navigation.json。
    "TaskMerchantPanelClosed": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "LoginMapVisible" ]
            }
        },
        "next": [ "TaskMerchantBeginRefill" ]
    },
    // 首张卡正文，由 TaskMerchantClassify 调用；原生 720p 识别，不额外放大。
    "TaskMerchantBodyOCR": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 574, 283, 256, 14 ],
                "expected": [ ".+" ],
                "only_rec": true
            }
        }
    },
    // next 由 RouteCard 按分类结果写入（赠送 → GiftFocus；删除 → OldDeleteToastGone）。
    "TaskMerchantProcessCard": {
        "rate_limit": 100,
        "timeout": 8000,
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskMerchantClassify"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TaskMerchantRouteCard"
            }
        },
        "next": [ ]
    },
    "TaskMerchantGiftFocus": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 708, 265, 121, 18 ],
                "expected": [ "输入好友.*筛选" ]
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 768, 273, 1, 1 ],
                "duration": 100
            }
        },
        "next": [ "TaskMerchantGiftPaste" ]
    },
    // GiftFocus 已识别到占位文字，输入框为空，无需先全选清除。
    // input_text 由 interface.json 的 TaskMerchantRecipient 覆盖，非空由其 verify 保证。
    "TaskMerchantGiftPaste": {
        "rate_limit": 100,
        "timeout": 8000,
        "action": {
            "type": "InputText",
            "param": {
                "input_text": ""
            }
        },
        "next": [ "TaskMerchantFirstFriend" ]
    },
    // 输入后弹出的好友下拉列表，点第一项；等输入框稳定再判断下拉是否收起。
    "TaskMerchantFirstFriend": {
        "rate_limit": 100,
        "timeout": 8000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 708, 282, 121, 23 ],
                "expected": [ "[0-9]+区" ]
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 756, 293, 1, 1 ],
                "duration": 100
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [ 708, 265, 121, 18 ],
            "rate_limit": 100,
            "timeout": 3000
        },
        "next": [ "TaskMerchantFriendListGone" ]
    },
    "TaskMerchantFriendListGone": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 100,
        "timeout": 8000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 708, 282, 121, 23 ],
                "expected": [ "[0-9]+区" ]
            }
        },
        "inverse": true,
        "next": [ "TaskMerchantGiftSend" ]
    },
    // 占位文字消失 = 已选中好友，才点赠送。
    "TaskMerchantGiftSend": {
        "rate_limit": 100,
        "timeout": 8000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 708, 265, 121, 18 ],
                "expected": [ "输入好友.*筛选" ]
            }
        },
        "inverse": true,
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 870, 277, 1, 1 ],
                "duration": 100
            }
        },
        "max_hit": 1000,
        "next": [ "TaskMerchantRecipientFull", "TaskMerchantGiftCompleted" ]
    },
    // 对方任务已满时无法再送，关闭面板结束整个任务。
    "TaskMerchantRecipientFull": {
        "rate_limit": 100,
        "timeout": 8000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 585, 295, 190, 68 ],
                "expected": [ "对方任务已经满了" ]
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 947, 220, 1, 1 ],
                "duration": 100
            }
        },
        "next": [ "TaskMerchantComplete" ]
    },
    // 以下两个节点仅供 GiftCompleted 的 Or 引用。
    "TaskMerchantGiftInputReset": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 708, 265, 121, 18 ],
                "expected": [ "输入好友.*筛选" ]
            }
        }
    },
    "TaskMerchantGiftEmpty": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 560, 363, 350, 47 ],
                "expected": [ "你还没有任务卡" ]
            }
        }
    },
    // 赠送成功：输入框恢复占位文字（下一张卡），或卡片已全部送完。
    "TaskMerchantGiftCompleted": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [ "TaskMerchantGiftInputReset", "TaskMerchantGiftEmpty" ]
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [ 534, 265, 397, 193 ],
            "rate_limit": 100,
            "timeout": 5000
        },
        "next": [ "TaskMerchantOpenPanel" ]
    },
    // 等上一张卡的"删除成功"消失，避免误判本次删除结果。
    "TaskMerchantOldDeleteToastGone": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 8000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 590, 318, 165, 90 ],
                "expected": [ "删除成功" ]
            }
        },
        "inverse": true,
        "next": [ "TaskMerchantDeleteX" ]
    },
    // 首张卡右侧的删除按钮。
    "TaskMerchantDeleteX": {
        "rate_limit": 100,
        "timeout": 8000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 708, 265, 121, 18 ],
                "expected": [ "输入好友.*筛选" ]
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 916, 273, 1, 1 ],
                "duration": 100
            }
        },
        "max_hit": 1000,
        "next": [ "TaskMerchantDeleteSucceeded", "TaskMerchantDeletePrompt" ]
    },
    // 本次登录首次删除会弹确认框（消耗 5000 铜币）；勾选"本次登录不再提示"后，后续删除直接成功。
    "TaskMerchantDeletePrompt": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 1500,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 585, 410, 90, 20 ],
                "expected": [ "本次登录不再提示" ],
                "only_rec": true
            }
        },
        "next": [ "TaskMerchantDeleteRemember", "TaskMerchantDeleteConfirm" ]
    },
    // 复选框未勾选才点；已勾选则直接确认。
    "TaskMerchantDeleteRemember": {
        "timeout": 1500,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [ 570, 410, 25, 24 ],
                "template": "alt_accounts/task_merchant/delete_no_prompt_unchecked.png",
                "threshold": 0.6,
                "method": 5
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 580, 420, 1, 1 ],
                "duration": 100
            }
        },
        "max_hit": 1000,
        "next": [ "TaskMerchantDeleteConfirm" ]
    },
    // 对话框 1.5s 内未消失：仍识别到对话框才补点确认。
    "TaskMerchantDeleteConfirm": {
        "rate_limit": 100,
        "timeout": 1500,
        "max_hit": 1000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 570, 348, 215, 24 ],
                "expected": [ "5000铜币" ]
            }
        },
        "action": {
            "type": "LongPress",
            "param": {
                "target": [ 610, 390, 1, 1 ],
                "duration": 100
            }
        },
        "next": [ "TaskMerchantDeleteDialogGone" ],
        "on_error": [ "TaskMerchantDeleteDialogGone", "TaskMerchantDeleteConfirm" ]
    },
    "TaskMerchantDeleteDialogGone": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 100,
        "timeout": 8000,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 570, 348, 215, 24 ],
                "expected": [ "5000铜币" ]
            }
        },
        "inverse": true,
        "next": [ "TaskMerchantDeleteSucceeded" ]
    },
    "TaskMerchantDeleteSucceeded": {
        "pre_delay": 0,
        "post_delay": 0,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 590, 318, 165, 90 ],
                "expected": [ "删除成功" ]
            }
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [ 534, 265, 397, 193 ],
            "rate_limit": 100,
            "timeout": 5000
        },
        "next": [ "TaskMerchantOpenPanel" ]
    }
}
