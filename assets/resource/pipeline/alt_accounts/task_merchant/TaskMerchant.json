// 原生720p正文OCR，不额外放大。
{
    "TaskMerchantStart": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 100,
        "timeout": 8000,
        "next": [ "TaskMerchantConfigure" ]
    },
    // 使用 attach 的扁平键合并收件人和各选项，避免嵌套对象相互覆盖。
    "TaskMerchantConfigure": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 100,
        "timeout": 8000,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TaskMerchantConfigure"
            }
        },
        "next": [
            "TaskMerchantOpenPanel"
        ],
        "attach": {
            "recipient": "",
            "survival_score_70": false,
            "survival_score_120": false,
            "survival_score_170": false,
            "ranked_participation_1": false,
            "ranked_participation_2": false,
            "ranked_participation_3": false,
            "wanted_1": false,
            "wanted_3": false,
            "wanted_5": false,
            "escort_1": false,
            "escort_3": false,
            "arena_participation_1": false,
            "arena_participation_2": false,
            "arena_participation_3": false,
            "arena_participation_6": false
        }
    },
    "TaskMerchantOpenPanel": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 100,
        "timeout": 8000,
        "next": [ "TaskMerchantProcessCard", "TaskMerchantEmptyList", "TaskMerchantSceneReady" ]
    },
    "TaskMerchantSceneReady": {
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 100,
