// 沿用游戏记住的上次难度，不自动选择难度。
{
    "PowerfulBoss": {
        "next": [ "BossSetTeam" ]
    },
    // BossTeam 选项传入队伍编号（1~8）。
    "BossSetTeam": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "SelectTeam",
                "custom_action_param": 1
            }
        },
        "next": [ "BossGotoWindow" ]
    },

    "BossGotoWindow": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "FindTopEntry",
                "custom_recognition_param": {
                    "template": "powerfulBoss/BossEntry.png"
                }
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "「强者降临」无法打开"
        },
        "timeout": 10000,
        "next": [ "BossAttemptsNone", "BossEnterBattle", "BossAttemptsCapped" ]
    },
    // 「本周可用普通奖励次数」是强者降临窗口独有标识。
    "BossWindowFooter": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "powerfulBoss/WindowFooter.png",
                "roi": [ 500, 578, 150, 40 ],
                "threshold": 0.9
            }
        }
    },
    "BossAttemptsLeft": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [ 632, 588, 28, 22 ],
                "expected": [ "[1-9]" ]
            }
        }
    },
    "BossAttemptsNone": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BossWindowFooter",
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [ 632, 588, 28, 22 ],
                                "expected": [ "0" ]
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 942, 249, 18, 18 ]
            }
        },
        "timeout": 5000,
        "next": [ "BossWindowClosed" ]
    },
    // 每周 6 次普通奖励；max_hit 为次数误识别设置安全上限。
    "BossEnterBattle": {
        "max_hit": 12,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BossAttemptsLeft",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "powerfulBoss/EnterBattle.png",
                                "roi": [ 490, 455, 150, 55 ],
                                "threshold": 0.9
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "focus": {
            "Node.PipelineNode.Failed": "「强者降临」失败：点了进入战斗但没有进入战斗画面"
        },
        "next": [ "BossBattleStart", "BossAutoOn", "BossAutoOff" ]
    },
    // 开战按钮倒计时每秒变化，模板仅截文字。
    "BossBattleStart": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "powerfulBoss/BattleStart.png",
                "roi": [ 560, 430, 220, 50 ],
                "threshold": 0.85
            }
        },
        "action": "Click",
        "next": [ "BossAutoOn", "BossAutoOff" ]
    },
    "BossAttemptsCapped": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BossWindowFooter", "BossAttemptsLeft" ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 942, 249, 18, 18 ]
            }
        },
        "timeout": 5000,
        "next": [ "BossCappedClosed" ]
    },
    "BossCappedClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BossWindowFooter" ]
            }
        },
        "inverse": true,
        "next": [ "BossCappedFailed" ]
    },
    "BossCappedFailed": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "「强者降临」失败：已连续打了 12 场，窗口里的次数仍没用完（安全上限），请检查次数读数"
        }
    },
    "BossWindowClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BossWindowFooter" ]
            }
        },
        "inverse": true,
        "focus": {
            "Node.Recognition.Succeeded": "「强者降临」已完成：本周普通奖励次数已用完"
        }
    },

    "BossAutoOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOn.png", "common/battle/AutoOnHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "next": [ "BossSpeedOn", "BossSpeedOff" ]
    },
    "BossAutoOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [ "common/battle/AutoOff.png", "common/battle/AutoOffHover.png" ],
                "roi": [ 828, 620, 80, 80 ]
            }
        },
        "action": "Click",
        "next": [ "BossSpeedOn", "BossSpeedOff" ]
    },
    // 超时依据：三波敌人，普通难度实测约半分钟。
    "BossSpeedOn": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOn.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "timeout": 600000,
        "next": [ "BossBattleWon", "BossBattleLost" ]
    },
    "BossSpeedOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "common/battle/SpeedOff.png",
                "roi": [ 870, 635, 69, 69 ]
            }
        },
        "action": "Click",
        "timeout": 600000,
        "next": [ "BossBattleWon", "BossBattleLost" ]
    },

    // 胜败面板共用确认按钮，需以「胜」「败」字区分并等待动画稳定。
    "BossBattleWonFlag": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "powerfulBoss/BattleWon.png",
                "roi": [ 540, 260, 260, 230 ],
                "threshold": 0.8
            }
        }
    },
    "BossBattleLostFlag": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "powerfulBoss/BattleLost.png",
                "roi": [ 540, 260, 260, 230 ],
                "threshold": 0.8
            }
        }
    },
    "BossResultButton": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "abundance/ResultConfirm.png",
                "roi": [ 620, 455, 105, 35 ]
            }
        }
    },
    "BossBattleWon": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BossBattleWonFlag", "BossResultButton" ],
                "box_index": 1
            }
        },
        "action": "Click",
        "timeout": 15000,
        "next": [ "BossRewardConfirm" ]
    },
    // 单人最高难度实测在奖励确认后多出「通关评分」弹窗，低难度没有。
    "BossScoreTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "powerfulBoss/ScoreTitle.png",
                "roi": [ 540, 190, 260, 100 ],
                "threshold": 0.8
            }
        }
    },
    "BossScoreConfirm": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BossScoreTitle",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "powerfulBoss/RewardConfirm.png",
                                "roi": [ 600, 480, 125, 40 ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 640, 496, 50, 10 ]
            }
        },
        "next": [ "BossScoreClosed" ]
    },
    "BossScoreClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BossScoreTitle" ]
            }
        },
        "inverse": true,
        "timeout": 8000,
        "next": [ "BossGotoWindow" ]
    },
    "BossRewardTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "powerfulBoss/RewardTitle.png",
                "roi": [ 540, 270, 250, 90 ],
                "threshold": 0.8
            }
        }
    },
    "BossRewardConfirm": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "BossRewardTitle",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": "powerfulBoss/RewardConfirm.png",
                                "roi": [ 600, 455, 125, 45 ],
                                "threshold": 0.8
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [ 640, 471, 50, 12 ]
            }
        },
        "next": [ "BossRewardClosed" ]
    },
    // 顶部入口在弹窗遮罩下仍可识别，但点击被吞；需等弹窗关闭。
    "BossRewardClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BossRewardTitle" ]
            }
        },
        "inverse": true,
        "timeout": 8000,
        "next": [ "BossScoreConfirm", "BossGotoWindow" ]
    },

    // 战败不扣奖励次数；停止重试，避免反复挑战同一难度。
    "BossBattleLost": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BossBattleLostFlag", "BossResultButton" ],
                "box_index": 1
            }
        },
        "action": "Click",
        "timeout": 8000,
        "next": [ "BossBattleLostClosed" ]
    },
    "BossBattleLostClosed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [ "BossBattleLostFlag" ]
            }
        },
        "inverse": true,
        "next": [ "BossBattleFailed" ]
    },
    "BossBattleFailed": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "FalseAction"
            }
        },
        "focus": {
            "Node.Action.Failed": "「强者降临」战斗失败，请换个能打过的难度或队伍"
        }
    }
}
