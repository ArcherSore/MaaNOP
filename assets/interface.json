{
    "interface_version": 2,
    "name": "MaaNOP",
    "label": "MaaNOP",
    "version": "v2.3.0",
    "github": "https://github.com/ArcherSore/MaaNOP",
    "controller": [
        {
            "name": "Win32Desktop",
            "label": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "火影忍者Online",
                "screencap": "PrintWindow",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        }
    ],
    "resource": [
        {
            "name": "NarutoMiniClient",
            "label": "火影微端",
            "path": [ "./resource/" ]
        }
    ],
    "agent": {
        "child_exec": "./python/python.exe",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "global_option": [ "ServerRegionType", "ServerRange" ],
    "task": [
        {
            "name": "AccountLeveling",
            "label": "注册并练级",
            "entry": "AccountLeveling",
            "description": "<span>1. 开始需要处于选服务器界面</span><br><span>2. 按服务器范围注册新账号并练到16级</span>",
            "option": [ "AccountNamePrefix" ]
        },
        {
            "name": "AccountClaims",
            "label": "批量领取",
            "entry": "AccountClaims",
            "description": "<span>1. 开始需要处于选服务器界面</span><br><span>2. 面向已经注册并完成练级的账号，按服务器范围批量领取</span><br><span>3. 领回归、领幻象和领经验仍需满足各自的游戏内条件</span>",
            "option": [ "ClaimLevelExp", "ClaimMail", "ClaimInfiniteIllusion", "ClaimReturnGift" ]
        },
        {
            "name": "ArenaRankGrind",
            "label": "竞技场一键六道",
            "entry": "ArenaRankGrind",
            "description": "<span>1. 开始需要处于竞技场主界面, 或者能看到竞技场入口的地方</span><br><span>2. 任务会自动进入竞技场并连续挑战, 直到达到六道段位"
        },
        {
            "name": "ShoppingFestivalTask",
            "label": "购物节送字",
            "entry": "ShoppingFestivalTask",
            "description": "<span>开始需要处于选服务器界面</span><br><span>任务会按服务器范围依次登录、处理登录弹窗，并执行木叶购物节送字流程</span>",
            "option": [ "ShoppingFriendName" ]
        }
    ],
    "option": {
        "ServerRegionType": {
            "type": "select",
            "label": "大区类型",
            "description": "选择服务器大区类型（公测 / 不删档）",
            "default_case": "Public",
            "cases": [
                {
                    "name": "Public",
                    "label": "公测",
                    "pipeline_override": {
                        "SetServerRegion": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "SetServerRegion",
                                    "custom_recognition_param": "public"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "NonWipe",
                    "label": "不删档",
                    "pipeline_override": {
                        "SetServerRegion": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "SetServerRegion",
                                    "custom_recognition_param": "non_wipe"
                                }
                            }
                        }
                    }
                }
            ]
        },
        "ServerRange": {
            "type": "input",
            "label": "服务器选择",
            "inputs": [
                {
                    "name": "server_range",
                    "label": "服务器范围",
                    "description": "输入服务器范围, 格式如: 10-16,18-20",
                    "default": "978-1012",
                    "pipeline_type": "string",
                    "verify": "^(?:\\d+(?:-\\d+)?)(?:,\\d+(?:-\\d+)?)*$",
                    "pattern_msg": "请输入正确格式, 如: 10-16,18-20"
                }
            ],
            "pipeline_override": {
                "ParseServer": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "ParseServerRange",
                            "custom_recognition_param": "{server_range}"
                        }
                    }
                }
            }
        },
        "AccountNamePrefix": {
            "type": "input",
            "label": "",
            "inputs": [
                {
                    "name": "name_prefix",
                    "label": "账号前缀",
                    "description": "格式如X1006",
                    "default": "X",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "GetAccountPrefix": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "GenerateAccountName",
                            "custom_recognition_param": "{name_prefix}"
                        }
                    }
                }
            }
        },
        "ClaimLevelExp": {
            "type": "switch",
            "label": "领经验",
            "description": "是否需要领取日常任务经验",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领取"
                },
                {
                    "name": "No",
                    "label": "不领取",
                    "pipeline_override": {
                        "ClaimLevelEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "ClaimReturnGift": {
            "type": "switch",
            "label": "领回归",
            "description": "是否需要领取回归奖励",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领取"
                },
                {
                    "name": "No",
                    "label": "不领取",
                    "pipeline_override": {
                        "ClaimReturnGiftEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "ClaimMail": {
            "type": "switch",
            "label": "领邮件",
            "description": "是否需要领取邮件附件",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领取"
                },
                {
                    "name": "No",
                    "label": "不领取",
                    "pipeline_override": {
                        "ClaimMailEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "ClaimInfiniteIllusion": {
            "type": "switch",
            "label": "领幻象",
            "description": "是否需要领取幻象奖励",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领取"
                },
                {
                    "name": "No",
                    "label": "不领取",
                    "pipeline_override": {
                        "ClaimInfiniteIllusionEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "ShoppingFriendName": {
            "type": "input",
            "label": "购物节好友名称",
            "inputs": [
                {
                    "name": "shopping_friend_name",
                    "label": "好友名称",
                    "description": "购物节赠送对象名称",
                    "default": "",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "GetShoppingFriendName": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "GenerateShoppingFriendName",
                            "custom_recognition_param": "{shopping_friend_name}"
                        }
                    }
                }
            }
        }
    }
}
