{
    "interface_version": 2,
    "name": "MaaNOP",
    "label": "MaaNOP",
    "version": "v2.3.0",
    "github": "https://github.com/ArcherSore/MaaNOP",
    "controller": [
        {
            "name": "Win32Desktop",
            "label": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "火影忍者online",
                "screencap": "PrintWindow",
                "mouse": "Seize",
                "keyboard": "Seize"
            }
        }
    ],
    "resource": [
        {
            "name": "NarutoMiniClient",
            "label": "QQ游戏大厅",
            "path": [ "./resource/" ]
        }
    ],
    "pretask": {
        "name": "LaunchNaruto",
        "label": "启动QQ大厅",
        "description": "通过 QQ 游戏大厅启动游戏；已有游戏窗口时直接使用。须填写大厅路径和 QQ 号，且该账号已在大厅保存登录状态。",
        "exec": "./python/python.exe",
        "args": [ "./agent/pretask_launch.py" ],
        "option": [ "LoginAccount", "GameHallPath" ]
    },
    "agent": {
        "child_exec": "./python/python.exe",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "group": [
        {
            "name": "AltAccount",
            "label": "练小号"
        },
        {
            "name": "Routine",
            "label": "日常任务"
        },
        {
            "name": "LimitedEvent",
            "label": "限时活动"
        }
    ],
    "task": [
        {
            "name": "GameEntry",
            "label": "进入游戏",
            "group": [ "Routine" ],
            "entry": "GameEntry",
            "description": "刷新页面并登录所选服务器，处理进入游戏时的弹窗。\n\n请放在其他任务之前；使用快捷登录时，QQ 须已在电脑上登录。",
            "option": [ "LoginAccount", "ServerRegionType", "SingleServer" ]
        },
        {
            "name": "AccountLeveling",
            "label": "注册并练级",
            "group": [ "AltAccount" ],
            "entry": "AccountLeveling",
            "description": "依次在所选服务器注册角色并练到 **16 级**，请勿提前注册。\n\n某服登录失败时停止整个任务。",
            "option": [ "LoginAccount", "ServerRegionType", "ServerRange", "AccountNamePrefix" ]
        },
        {
            "name": "AccountClaims",
            "label": "批量领取",
            "group": [ "AltAccount" ],
            "entry": "AccountClaims",
            "description": "依次登录所选服务器，领取勾选的奖励。请先完成各服角色的注册和练级。\n\n某服登录失败时停止整个任务。\n\n- **等级经验**：用铜币找回 50% 经验，适合 16～30 级小号，请备足铜币。\n- **邮件附件**：领取邮件中的附件。\n- **幻象奖励**：52 级解锁后使用，请先手动完成首次伤害。每周运行一次即可，重复运行会再次扫荡。\n- **回归奖励**：领取 30 级及以上角色连续 7 天未登录后触发的回归点券。",
            "option": [ "LoginAccount", "ServerRegionType", "ServerRange", "ClaimLevelExp", "ClaimMail", "ClaimInfiniteIllusion", "ClaimReturnGift" ]
        },
        {
            "name": "ArenaRankGrind",
            "label": "竞技场一键六道",
            "entry": "ArenaRankGrind",
            "description": "连续挑战竞技场，达到**六道段位**后停止。\n\n请从竞技场主界面或地图界面开始。"
        },
        {
            "name": "ThemeArena",
            "label": "主题竞技场（微端）",
            "group": [ "LimitedEvent" ],
            "entry": "ThemeArena",
            "description": "自动挑战并托管，达到所选目标后停止；选择「九胜」时，以九胜奖励可领取为准。\n\n请从**主题竞技场主界面**开始。",
            "option": [ "ThemeArenaEndCondition" ],
            "pipeline_override": {
                "WaitBattleEnd": {
                    "next": [ "[JumpBack]ThemeBattleResultPopup", "WaitThemeMain" ]
                }
            }
        },
        {
            "name": "ShoppingFestivalTask",
            "label": "购物节送字（微端）",
            "group": [ "AltAccount" ],
            "entry": "ShoppingFestivalTask",
            "description": "依次登录所选服务器，在**木叶购物节**消费 **1500 点券**，再将获得的字赠送给指定大号。\n\n- 大号须保持在线，并已被各小号加为好友。\n- 首页四个商品中，须至少有一个单价能整除 1500；不会向下翻找商品。\n- 每个小号每天只运行一次，重复运行会再次购买。\n- 某服登录失败时停止整个任务。",
            "option": [ "LoginAccount", "ServerRegionType", "ServerRange", "ShoppingFriendName" ]
        },
        {
            "name": "AutoManagement",
            "label": "游戏托管",
            "group": [ "Routine" ],
            "entry": "AutoManagement",
            "description": "按游戏内的**托管设置**执行一轮后退出。\n\n- 请先在游戏里勾选要做的项目；每天首次托管消耗 **1 张托管卡**。\n- 请勿勾选「空闲时自动停靠在温泉」；设置了二级密码时，也请勿勾选「兑换商人」。"
        },
        {
            "name": "WantedTask",
            "label": "通缉任务",
            "group": [ "Routine" ],
            "entry": "WantedTask",
            "description": "**单人**自动完成今天剩余的通缉任务，约需十分钟。中断后会检查完成情况，仍有剩余时再次启动。\n\n请使用能打过的队伍，运行期间**勿操作角色**，以免打断自动完成。",
            "option": [ "WantedTeam", "WantedSoloTeam" ]
        },
        {
            "name": "AbundanceRoom",
            "label": "丰饶之间",
            "group": [ "Routine" ],
            "entry": "AbundanceRoom",
            "description": "刷铜币专用，不打经验试炼。\n\n每场消耗 **10 点体力**，请备足体力，不会自动补充。",
            "option": [ "AbundanceTeam" ]
        },
        {
            "name": "SurvivalDrill",
            "label": "生存演习",
            "group": [ "Routine" ],
            "entry": "SurvivalDrill",
            "description": "打完当前一轮并领奖；当天还有重置次数时，再重置并按所选难度打一轮。每轮打到积分满或挑战次数用完。\n\n选择**极限**但尚未解锁时，会消耗**极限之卷**解锁；卷不足则改打精英。",
            "option": [ "SurvivalLevel" ]
        },
        {
            "name": "DailyArena",
            "label": "竞技场",
            "group": [ "Routine" ],
            "entry": "DailyArena",
            "description": "自动战斗并领取竞技场日常任务奖励\n\n战令用完、任务为空，或无损次数用完且没有已满足的任务时停止。\n\n请从游戏主界面或竞技场主界面开始。",
            "option": [ "DailyArenaBattleMode" ],
            "pipeline_override": {
                "ArenaSceneLoaded": { "pre_delay": 0, "post_delay": 0 },
                "ArenaAutoOn": { "pre_delay": 0, "post_delay": 0 },
                "ArenaBattleKeepWaiting": { "pre_delay": 0, "post_delay": 0 },
                "WaitBattleEnd": {
                    "recognition": {
                        "type": "OCR",
                        "param": {
                            "roi": [ 620, 430, 100, 35 ],
                            "expected": "确认"
                        }
                    },
                    "action": {
                        "type": "Click",
                        "param": {
                            "target": [ 658, 445, 24, 8 ]
                        }
                    },
                    "anchor": { "MouseMoveResetAnchor": "MouseMoveReset" },
                    "next": [ "[JumpBack][Anchor]MouseMoveResetAnchor", "DailyArenaResultPopup", "DailyArenaMain" ]
                }
            }
        },
        {
            "name": "TeamDungeon",
            "label": "组队副本",
            "group": [ "Routine" ],
            "entry": "TeamDungeon",
            "description": "**单人**挑战所选副本，自动领奖，直到本日奖励次数用完；支持途中触发的精英怪。\n\n- 请选能打过的难度，暂不处理战败。\n- 请勿勾选单人确认弹窗中的「本次登录不再提示」。\n- 活动未开放或所选难度不可用时跳过；找不到所选副本时失败。",
            "option": [ "TeamDungeonTeam", "TeamDungeonName", "TeamDungeonDifficulty" ]
        },
        {
            "name": "PowerfulBoss",
            "label": "强者降临",
            "group": [ "Routine" ],
            "entry": "PowerfulBoss",
            "description": "**单人**反复挑战并领奖，直到本周普通奖励次数用完。\n\n- 沿用游戏记住的难度，请提前选好能打过的难度；暂不处理战败。\n- 每场消耗 **10 点体力**和 1 次奖励次数，不会自动补充体力。",
            "option": [ "BossTeam" ]
        },
        {
            "name": "NinjaQuiz",
            "label": "忍者测验",
            "group": [ "Routine" ],
            "entry": "NinjaQuiz",
            "description": "完成 10 道题并领奖，**每题固定选第一项，不保证答对**。今天已完成时跳过。\n\n角色走向考官时请勿操作角色，以免打断寻路。"
        },
        {
            "name": "TrainingJournal",
            "label": "修行录领取",
            "group": [ "Routine" ],
            "entry": "TrainingJournal",
            "description": "领取**忍者修行录「任务」页签**中所有可领奖励，包括领取后解锁的可领奖励；不领取「奖励」页签。"
        },
        {
            "name": "OnlineReward",
            "label": "在线领奖",
            "group": [ "Routine" ],
            "entry": "OnlineReward",
            "description": "领取**福利大厅**中当前可领的在线礼包，不等待倒计时。\n\n要领完当天全部礼包，请在达到相应在线时长后再次运行。"
        },
        {
            "name": "NinjutsuTraining",
            "label": "忍术特训（微端）",
            "group": [ "LimitedEvent" ],
            "entry": "NinjutsuTrainingEntry",
            "description": "自动完成忍术特训并领奖。\n\n请先打开**忍术特训界面**，确保能看到「开启特训」按钮。"
        },
        {
            "name": "MidAutumnLantern",
            "label": "中秋盛典（微端）",
            "group": [ "LimitedEvent" ],
            "entry": "MidAutumnLanternEntry",
            "description": "自动完成点灯并领奖，重复进行，直到**参与券**用完。\n\n请先打开**中秋盛典点灯笼界面**，确保能看到「开始」按钮。"
        },
        {
            "name": "AbilityExam",
            "label": "忍者能力考试（微端）",
            "group": [ "LimitedEvent" ],
            "entry": "AbilityExam",
            "description": "自动挑战**高级考试**，通关后领取各档奖励；已通过的关卡会跳过。\n\n请使用能打过高级考试的队伍，暂不处理战败。",
            "option": [ "ExamTeam" ]
        },
        {
            "name": "WeekendActivities",
            "label": "周末活动",
            "group": [ "LimitedEvent" ],
            "entry": "WeekendActivities",
            "description": "目前支持**忍者拼图**：自动完成简单、普通、困难三个难度并领奖，已领取的跳过。\n\n请从**游戏主界面**开始。"
        }
    ],
    "option": {
        "GameHallPath": {
            "type": "input",
            "label": "QQ 游戏大厅路径",
            "inputs": [
                {
                    "name": "path",
                    "label": "QQGame.exe 路径",
                    "default": "C:\\Program Files (x86)\\Tencent\\QQGameTempest\\QQGame.exe",
                    "description": "QQ 游戏大厅 QQGame.exe 的完整路径，每台电脑的安装位置不同，请按实际位置填写。",
                    "pipeline_type": "string",
                    "verify": "(?i)^.+\\.exe$",
                    "pattern_msg": "请输入 QQGame.exe 的完整路径"
                }
            ]
        },
        "LoginAccount": {
            "type": "input",
            "label": "自动登录 QQ 号",
            "pipeline_override": {
                "WebManualLogin": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "uin": "{uin}",
                                "threshold": 0.85
                            }
                        }
                    }
                },
                "WebAccountMatch": {
                    "recognition": {
                        "param": {
                            "custom_recognition_param": {
                                "uin": "{uin}",
                                "source": "WebReadNumber",
                                "threshold": 0.85
                            }
                        }
                    }
                }
            },
            "inputs": [
                {
                    "name": "uin",
                    "label": "QQ 号",
                    "default": "",
                    "description": "启动游戏大厅时用作启动参数；普通登录和批量切服时用于网页快捷登录。",
                    "pipeline_type": "string",
                    "verify": "^$|^[1-9][0-9]{4,11}$",
                    "pattern_msg": "请输入 5～12 位 QQ 号，或留空手动登录"
                }
            ]
        },
        "ServerRegionType": {
            "type": "select",
            "label": "大区类型",
            "description": "选择服务器大区类型（公测 / 不删档 / 联盟）",
            "default_case": "Public",
            "cases": [
                {
                    "name": "Public",
                    "label": "公测",
                    "pipeline_override": {
                        "SetServerRegion": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "SetServerRegion",
                                    "custom_recognition_param": "public"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "NonWipe",
                    "label": "不删档",
                    "pipeline_override": {
                        "SetServerRegion": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "SetServerRegion",
                                    "custom_recognition_param": "non_wipe"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Alliance",
                    "label": "联盟",
                    "pipeline_override": {
                        "SetServerRegion": {
                            "recognition": {
                                "type": "Custom",
                                "param": {
                                    "custom_recognition": "SetServerRegion",
                                    "custom_recognition_param": "alliance"
                                }
                            }
                        }
                    }
                }
            ]
        },
        "SingleServer": {
            "type": "input",
            "label": "服务器选择",
            "inputs": [
                {
                    "name": "server_id",
                    "label": "服务器编号",
                    "description": "只输入一个服务器编号，如 1006。",
                    "default": "1",
                    "pipeline_type": "string",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请输入一个正整数服务器编号"
                }
            ],
            "pipeline_override": {
                "ParseServer": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "ParseServerRange",
                            "custom_recognition_param": "{server_id}"
                        }
                    }
                }
            }
        },
        "ServerRange": {
            "type": "input",
            "label": "服务器选择",
            "inputs": [
                {
                    "name": "server_range",
                    "label": "服务器范围",
                    "description": "输入服务器范围, 格式如: 10-16,18-20",
                    "default": "978-1012",
                    "pipeline_type": "string",
                    "verify": "^(?:\\d+(?:-\\d+)?)(?:,\\d+(?:-\\d+)?)*$",
                    "pattern_msg": "请输入正确格式, 如: 10-16,18-20"
                }
            ],
            "pipeline_override": {
                "ParseServer": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "ParseServerRange",
                            "custom_recognition_param": "{server_range}"
                        }
                    }
                }
            }
        },
        "AccountNamePrefix": {
            "type": "input",
            "label": "",
            "inputs": [
                {
                    "name": "name_prefix",
                    "label": "账号前缀",
                    "description": "账号名 = 前缀 + 服务器编号，如 X → X1006",
                    "default": "X",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "GetAccountPrefix": {
                    "recognition": {
                        "type": "Custom",
                        "param": {
                            "custom_recognition": "GenerateAccountName",
                            "custom_recognition_param": "{name_prefix}"
                        }
                    }
                }
            }
        },
        "ClaimLevelExp": {
            "type": "switch",
            "label": "等级经验",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领取"
                },
                {
                    "name": "No",
                    "label": "不领取",
                    "pipeline_override": {
                        "ClaimLevelEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "ClaimReturnGift": {
            "type": "switch",
            "label": "回归奖励",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领取"
                },
                {
                    "name": "No",
                    "label": "不领取",
                    "pipeline_override": {
                        "ClaimReturnGiftEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "ClaimMail": {
            "type": "switch",
            "label": "邮件附件",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领取"
                },
                {
                    "name": "No",
                    "label": "不领取",
                    "pipeline_override": {
                        "ClaimMailEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "ClaimInfiniteIllusion": {
            "type": "switch",
            "label": "幻象奖励",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "label": "领取"
                },
                {
                    "name": "No",
                    "label": "不领取",
                    "pipeline_override": {
                        "ClaimInfiniteIllusionEntry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "DailyArenaBattleMode": {
            "type": "select",
            "label": "战斗模式",
            "default_case": "Casual",
            "cases": [
                {
                    "name": "Ranked",
                    "label": "段位战斗"
                },
                {
                    "name": "Casual",
                    "label": "休闲战斗",
                    "pipeline_override": {
                        "DailyArenaStartBattle": {
                            "recognition": {
                                "type": "And",
                                "param": {
                                    "all_of": [
                                        "DailyArenaMainBright",
                                        {
                                            "recognition": {
                                                "type": "OCR",
                                                "param": {
                                                    "roi": [ 550, 548, 130, 50 ],
                                                    "expected": "休闲战斗"
                                                }
                                            }
                                        }
                                    ]
                                }
                            },
                            "action": {
                                "type": "Click",
                                "param": {
                                    "target": [ 580, 567, 65, 15 ]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "ThemeArenaEndCondition": {
            "type": "select",
            "label": "目标",
            "default_case": "Rikudou",
            "cases": [
                {
                    "name": "Rikudou",
                    "label": "六道",
                    "pipeline_override": {
                        "ThemeNineWinsReached": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "NineWins",
                    "label": "九胜",
                    "pipeline_override": {
                        "ThemeRikudouReached": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "SurvivalLevel": {
            "type": "select",
            "label": "演习难度",
            "default_case": "Elite",
            "cases": [
                {
                    "name": "Normal",
                    "label": "普通",
                    "pipeline_override": {
                        "SurvivalTabSelected": {
                            "recognition": {
                                "param": {
                                    "template": "survival/TabNormalSelected.png"
                                }
                            }
                        },
                        "SurvivalClickTab": {
                            "action": {
                                "param": {
                                    "target": [ 355, 129, 35, 50 ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Elite",
                    "label": "精英"
                },
                {
                    "name": "Extreme",
                    "label": "极限",
                    "pipeline_override": {
                        "SurvivalTabSelected": {
                            "recognition": {
                                "param": {
                                    "template": "survival/TabExtremeSelected.png"
                                }
                            }
                        },
                        "SurvivalClickTab": {
                            "action": {
                                "param": {
                                    "target": [ 470, 124, 35, 50 ]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "AbundanceTeam": {
            "type": "input",
            "label": "",
            "inputs": [
                {
                    "name": "abundance_team",
                    "label": "出战队伍",
                    "description": "从上到下编号（1～8）",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-8]$",
                    "pattern_msg": "请输入 1～8 的数字"
                }
            ],
            "pipeline_override": {
                "AbundanceSetTeam": {
                    "action": {
                        "param": {
                            "custom_action_param": "{abundance_team}"
                        }
                    }
                }
            }
        },
